generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CharacterStatus {
  ALIVE
  DEAD
  CURSED
}

// How a character presents. Chosen once at creation and never editable by the
// player afterwards (a GM can correct one from the dev panel).
//
// It does two jobs, and both used to be inferred from the honorific: it picks
// WHICH word of a gendered title a character wears — a Man holding Nobility is
// Lord, a Woman is Lady, Neutral is Noble (db/lib/titles.js) — and it is the
// Man/Woman/Person half of a concealed alias
// (db/lib/concealedIdentity.js). NEUTRAL is a real answer, not an absent one:
// every gendered title carries a neutral third, and a neutral character draws
// their rolled name from both pools.
enum Gender {
  MAN
  WOMAN
  NEUTRAL
}

enum ActionType {
  EFFORT
  MOVE
}

enum ActionStatus {
  PENDING_TYPE
  // Legacy: Opposed no longer exists as a submission-flow state. Nothing
  // writes this. Kept in the enum (rather than removed) for the same reason
  // as ADJUDICATED below — a Postgres enum-value removal is riskier than an
  // unused value.
  PENDING_OPPOSED
  PENDING
  CONFIRMED
  // Legacy terminal state from the pre-rework adjudication flow. No longer
  // written by new code — a CONFIRMED Move's GM-facing progress now lives on
  // moveReviewStatus instead. Kept in the enum (rather than removed) so old
  // rows don't need a risky Postgres enum-value migration.
  ADJUDICATED
}

// Routine/Gambit replaces the old Effort/Move split (ActionType, below) —
// Gambit is the only kind that rolls a d6. ActionType/Action.type stay in
// the schema for historical rows but are no longer meaningfully set beyond
// a constant "MOVE" going forward.
enum MoveKind {
  ROUTINE
  GAMBIT
  // Working the day. Files itself when a player submits nothing (the auto-labor
  // pass, db/lib/autoLaborPass.js) and can be picked by hand on the Move modal.
  // Never arbitrated and never rolls a die - it resolves entirely from the
  // character's Laboring tags and where they stand (db/lib/laborAccess.js).
  LABOR
}

// GM-facing spreadsheet status, tracked independently of ActionStatus (which
// only covers the player-side submission pipeline up through CONFIRMED).
enum MoveReviewStatus {
  OPEN
  // Legacy: nothing ever set this — a GM parked an Opposed Move by simply not
  // solving it yet, and Opposed itself has since been removed. Kept in the
  // enum rather than removed; see ActionStatus.PENDING_OPPOSED above.
  WAITING_FOR_OPPONENTS
  IN_PROGRESS
  SOLVED
  // Where every Routine lands the moment it's confirmed: its effects have
  // already been pushed, so it needs a GM only if one disagrees. Rendered as
  // plain body text, same as OPEN — neither is a state worth shouting about.
  PASSED
}

enum TurnPhase {
  DAWN
  DUSK
}

// What kind of place a Zone row is. SURFACE zones own the full category +
// #summary/#public/#private layout. The Caves are special: one CAVE_GROUP row
// owns the category and the GM seat but is not a place a character can stand,
// and each CAVE_LEVEL under it owns a single forum channel and IS a presence
// unit — you only see the level you're in. See docs/systemdocs/CHANNELS.md.
enum ZoneKind {
  SURFACE
  CAVE_GROUP
  CAVE_LEVEL
}

// A Room is a thread under its Location's channel. PUBLIC is a public thread
// anyone standing in the Location can read; PRIVATE is a private thread whose
// members are exactly the characters holding one of its accessTagSlugs,
// reconciled by db/lib/roomAccess.js.
enum RoomKind {
  PUBLIC
  PRIVATE
}

// Which operational pass a SystemReport row records the outcome of.
enum SystemReportKind {
  WIPE
  DOCTOR
  DAWN_WIPE
  BULK_MOVE
  MIRROR
}

enum TurnStatus {
  OPEN
  RESOLVED
}

// How much of a tag a 🔍 inspect shows to somebody else. HIDDEN is the
// default and the common case; ALWAYS is worn-or-not; WORN is the concealable
// middle — a dagger in a pocket, a badge left at home. WORN is only meaningful
// on an `equippable` tag, and db/lib/syncTags.js throws if it is set on one
// that isn't. See docs/systemdocs/TAGS.md §5.
enum TagVisibility {
  HIDDEN
  ALWAYS
  WORN
  // Seen only while the subject's name is their own. A reputation attaches to
  // a face, so it goes under a hood and under a Disguise Kit's false name —
  // db/lib/examine.js passes the identity in, db/lib/medicalVision.js decides.
  NAMED
}

// Where on the body an equippable tag sits. Every equippable tag names one
// (db/lib/syncTags.js throws otherwise), and the slot is the whole limit —
// GameConfig.equipSlots, the old flat count, is retired and read by nothing.
//
// HEAD, BODY and MOUNT carry Tag.equipLayer 1-3, so a coif goes under a helm
// and a cart is towed behind a horse. WEAPON is everything you hold, capped by
// hands — four, a two-hander (Tag.twoHanded) taking two — and ACCESSORY is
// capped at four. See TAGS.md and db/lib/equipSlots.js.
//
// SHIELD is RETIRED, not deleted. It was a second rule for the same place on
// the body — one cell called "Off hand" beside a row that counted hands — and
// folding it into WEAPON is what took the hands from three to four. Postgres
// has no ALTER TYPE ... DROP VALUE, and this codebase keeps dead enum values
// rather than rebuilding a type (see MoveReviewStatus.WAITING_FOR_OPPONENTS).
// Nothing writes or reads it: db/lib/equipSlots.js leaves it out of
// EQUIP_SLOTS, so syncTags.js throws on a YAML entry that still names it.
enum EquipSlot {
  HEAD
  BODY
  SHIELD
  WEAPON
  ACCESSORY
  MOUNT
}

// Who may see a tag in the /documents Tag Catalog (`catalog:` in
// docs/tags.yaml, required on every entry — db/lib/syncTags.js throws
// without it). SECRET is cave/antagonist content hidden from everyone, GMs
// included (/gm/dev/tags stays the unfiltered view). GM is visible to GMs
// always and to a player once their character relates to it — they hold it,
// their role's starting kit includes it, they hold its group's key tag, or
// (for Depot wares) they hold the Merchant's License. ALL is fully public,
// character or not. Read by web/lib/tagCatalog.js only.
enum CatalogVisibility {
  SECRET
  GM
  ALL
}

enum TagSource {
  POINT_BUY
  GM_GRANT
  EVENT
  // A skill learnt through a lesson (db/lib/lessonPass.js).
  LESSON
  // Made through the Craft flow (docs/systemdocs/CRAFTING.md).
  CRAFT
}

// ACTIVE is legacy — the 2026-09-02 retroactive rework removed set/cancel, so
// a Desire row is created FULFILLED and nothing ever writes ACTIVE again. Kept
// in the enum rather than dropped, same posture as
// MoveReviewStatus.WAITING_FOR_OPPONENTS. CANCELLED still means something: a
// claim a GM revoked, or one undone through the Request system.
enum DesireStatus {
  ACTIVE
  FULFILLED
  CANCELLED
}

// What an ArchiveEntry row records. MESSAGE is a proxied character message;
// everything else is a system event written by game logic, so the two
// interleave chronologically in /archive and the transcript reads as a diary
// rather than a chat log with no context.
enum ArchiveKind {
  MESSAGE
  TURN_START
  CHARACTER_CREATED
  DEATH
  DESIRE_FULFILLED
  LIFEWEB
  TRAVEL
}

// Which face wrote an ArchiveEntry. DISCORD is a message proxied out of a
// Discord channel, WEB one typed into /play, SYSTEM a line the game itself
// said. The outbox in bot/src/lib/feedOutbox.js only ever posts WEB rows on
// to Discord, so this is what keeps a proxied message from being echoed back
// into the channel it came from.
enum ArchiveSource {
  DISCORD
  WEB
  SYSTEM
}

/// DURABLE host configuration: the knobs and feature switches a GM tunes, plus
/// the Discord pointers and the REST breaker that have to outlive a process.
/// Nothing here is game state. Restart Game never touches this row — what a
/// game does to the world lives on GameState below, which the wipe recreates.
///
/// Every editable column here is declared once more in
/// db/lib/gameConfigFields.js, the registry that drives the /gm/dev form and
/// its parser. `npm run db:check-config` fails when the two drift.
model GameConfig {
  id                  Int @id @default(1)
  lifewebDecayPerTurn Int @default(10)

  // The one mood knob (docs/systemdocs/MOOD.md): every harm is multiplied by
  // it, every relief and the nightly drift divided by it. 1 is the tuning as
  // written; 0 switches the system off and the next turn close empties every
  // dial. Live on /gm/dev.
  moodIntensity Float @default(1)

  // The message wipe (db/lib/messageWipe.js). NOT a GM knob any more — the
  // wipe is how the game works, so it is on and it stays on. The column
  // survives as a hand-flippable escape hatch: set it false straight in the
  // database if Discord ever starts rate-limiting the sweep.
  messageWipeEnabled Boolean @default(true)

  // The web half of the same wipe (docs/systemdocs/HALL.md §7). Discord loses
  // its messages; the Hall keeps its rows and reads past them instead — every
  // feed query filters `seq > <floor>` while messageWipeEnabled is on.
  //
  // TWO watermarks, because the wipe has two cadences. `feedWipeSeq` moves on
  // every turn and floors loc:/room:/conv: places; `feedWipeSummarySeq` moves
  // only on a Dawn and floors zone: places, matching what the Discord sweep
  // actually clears. Both set by db/lib/feedWipe.js#markFeedWiped as the pass
  // begins.
  feedWipeSeq        BigInt @default(0)
  feedWipeSummarySeq BigInt @default(0)

  // How long a character waits between two walks from one Location to
  // another inside the same zone (db/lib/locationTravel.js). Edited on
  // /gm/dev. Crossing into another zone is gated by the Move, not by this.
  locationMoveCooldownSeconds Int @default(3)

  // Capitalizes the first letter of each sentence in Tupper-proxied messages
  // before they're reposted (bot/src/lib/textCorrection.js) — on by default,
  // purely cosmetic, never touches anything but sentence-start casing.
  tupperAutocorrectEnabled Boolean @default(true)

  // Gates the "{base} | Character Name" Discord nickname sync
  // (bot/src/lib/nickname.js, web/lib/discordGuild.js#syncCharacterNickname)
  // — off by default so nobody's nickname is touched until a GM opts in.
  nicknameSyncEnabled Boolean @default(false)

  // Whether arrivals/departures are recorded as TRAVEL rows in the archive.
  // Off by default: it's what makes a location read like a story, and also
  // what drowns the transcript at 100+ players (two rows per character per
  // turn before anyone says a word).
  archiveTravelEvents Boolean @default(false)

  // The Hall (docs/systemdocs/HALL.md §5). Off, /play bounces to /character,
  // the rail drops Play, ⌘K stops offering places and people, and the "Play
  // from the web" switch is neither drawn nor honoured. The feed API stays up
  // either way: the GM desk's Scene tab streams from it.
  playPanelEnabled Boolean @default(true)

  // THE ORACLE (docs/systemdocs/ORACLE.md). Every one of these is edited from
  // /gm/dev?s=oracle rather than the generic Configuration form, so all of
  // them sit in gameConfigFields.js's INTERNAL_KEYS: an API key rendered as a
  // generic text box would be readable, and a prompt is a textarea the
  // registry has no field type for.
  //
  // Off by default. A turn with the Oracle disabled skips the whole thing and
  // writes no rows.
  oracleEnabled Boolean @default(false)

  // Narrows the desk to superadmins while the Oracle is being tried out. The
  // toggle above decides whether it RUNS; this one decides who may READ it, so
  // a turn can be drafted and reviewed before the other gamemasters ever see a
  // page. Enforced in web/app/(desk)/gm/oracle/page.js, not just in the rail.
  oraclePlaytest Boolean @default(false)

  // Provider is a label; baseUrl is what actually gets called, so a
  // self-hosted or proxied endpoint needs no code change. Model is passed
  // through verbatim.
  oracleProvider String @default("nanogpt")
  oracleBaseUrl  String @default("https://nano-gpt.com/api/v1")
  oracleModel    String @default("deepseek/deepseek-v4-flash")

  // WRITE-ONLY. Set from the panel, masked afterwards, never returned to a
  // client — see web/app/(app)/gm/dev/oracleActions.js, which is the only
  // reader outside the run itself.
  //
  // A real credential in a database column is a deliberate departure from
  // DISCORD_TOKEN's env-var handling, taken so the provider can be swapped
  // without a deploy. The cost is that it lands in every pg_dump in the backup
  // bucket, and it must never enter an archive packet (ARCHIVE.md).
  oracleApiKey      String?
  oracleApiKeySetAt DateTime?
  oracleApiKeySetBy String?

  // How many previous turns' synopses ride along as context. This is the whole
  // of the Oracle's memory: at 0 each turn is written blind.
  oracleMemoryTurns Int @default(3)

  // Whether the chat transcript joins the moves/tags/audit input. Off is about
  // 34K tokens a turn; on is closer to 650K and costs roughly ten times as
  // much, which is still cents.
  oracleIncludeChat Boolean @default(false)

  // NULL means "use the built-in default in db/lib/oraclePrompts.js". Stored
  // rather than hardcoded so voice can be tuned without a deploy, the way
  // docs/handbook.md is read at runtime.
  oracleCorrespondentPrompt String?
  oracleEditorPrompt        String?

  // The anchor message in #turns carrying the Travel / Move / Speak buttons
  // (see bot/src/lib/turnsConsole.js) — same tracked-message pattern as
  // turnsAnnouncement* above, but reused across restarts rather than
  // reposted, since it is a console rather than an announcement.
  //
  // These are the old locationPrompt* columns, renamed. The #location channel
  // and its ⚜ picker were retired; the columns were kept because they hold
  // exactly the same thing for exactly the same reason.
  turnsConsoleChannelId String?
  turnsConsoleMessageId String?

  // --- Discord REST circuit breaker, persisted -------------------------
  //
  // Cloudflare counts 401/403/429 responses per egress IP and bans the token
  // for about an hour at 10,000 in a rolling 10 minutes. db/lib/discordRest.js
  // trips a breaker at a tenth of that, and its own header names the threat it
  // exists for: an unattended crash-restart loop replaying the ready burst.
  //
  // Which is the one thing an in-memory counter can never catch. The counters
  // lived in module-level JS, so every restart zeroed them while Cloudflare's
  // count — keyed on the IP, not the process — carried straight on. The loop
  // the breaker was written to stop was the loop it was structurally
  // guaranteed to miss, and the health line printed at bot startup could only
  // ever read 0/1000.
  //
  // Kept here for the same reason turnsConsoleMessageId is: it is Discord
  // state that has to survive a restart and be shared by the bot and web
  // containers, which sit behind one egress IP and were each counting their
  // own fraction of the traffic against a whole-IP ceiling.
  //
  // The in-memory array stays the hot path — this is read once per process and
  // written only on the error path, never per request.
  restInvalidCount       Int       @default(0)
  restInvalidWindowStart DateTime?
  restBreakerOpenUntil   DateTime?

  // Multiplier applied to every rate in db/lib/production.js's
  // PRODUCTION_RATES table — read live by the Labor checkbox
  // (db/lib/laborAccess.js). docs/documents.yaml renders its numbers through
  // live {resource:...} bubbles, so nothing needs regenerating when this
  // changes. See docs/systemdocs/LABORING.md.
  //
  // Default is 0.93, not 1: laboring was brought down about 7% before launch.
  // Note what that does NOT reach — Basic is in UNSCALED_TIERS on purpose, and
  // Skilled's 1-4 rounds back to 1-4, so the cut lands on the three
  // specialisations, which is where the volume is.
  productionCoefficient Float @default(0.93)

  // Base point-buy budget every new character starts with, before the
  // role's own `extra_starting_points` and the Cursed penalty are applied
  // (see web/lib/characterCreation.js#computeBudget). Editable live from
  // the Dev Panel so it can be tuned right up to launch.
  startingTagPoints Int @default(12)

  // Whether a role that grants a faction Leader seat still requires the
  // @Leader Whitelist Discord role (db/lib/roleIds.js). Off means every player
  // may pick a Leader role - read by character/page.js to decide which cards
  // render selectable, and re-checked by createCharacter, the same
  // presentation/lock split the game phase uses. Deliberately ON by default:
  // this gate fails closed, and the reservation is the normal state of the game.
  // The same role gates the whitelisted antagonist opt-ins in the lobby
  // (docs/systemdocs/LOBBY.md).
  leaderWhitelistEnabled Boolean @default(true)

  // Closed-rehearsal switch (docs/systemdocs/LOBBY.md §2). The game runs its
  // whole normal shape - phases, lobby, the roll, creation, turns - but the
  // roster narrows from "holds the Player role" to the people building it: a
  // GM, a playtester, or a Contributor. Needed because the bot hands the
  // Player role to everyone who joins the guild, so that role cannot say who a
  // playtest is for. Gates JOINING only: an existing character keeps playing.
  // Read through web/lib/discordGuild.js#onRoster and nowhere else.
  playtestModeEnabled Boolean @default(false)

  // How long an assigned seat stays locked to its player after Start Game
  // before the lobby sweep releases it (docs/systemdocs/LOBBY.md §4). The
  // assignment DM carries the deadline as a Discord timestamp; the reminder
  // goes out six hours before it.
  creationWindowHours Int @default(12)

  // When true, the nightly turn-advance cron (bot/src/events/ready.js)
  // skips its automatic advance — bot/src/lib/turnEngine.js#advanceTurn
  // checks this before calling into the shared engine. A GM's "Advance turn
  // now" in the Dev Panel calls the shared engine directly and is not gated
  // by this flag, so a paused game can still be force-advanced by hand. Off
  // by default: the cron runs normally unless a GM deliberately pauses it,
  // and a wipe resets this back to false along with every other operational
  // toggle here.
  autoTurnAdvanceDisabled Boolean @default(false)

  // Master switch for letting a player upload their own profile picture.
  // Off means AvatarField's file input doesn't render and
  // updateCharacterProfile ignores a posted `avatar` field even if one
  // arrives anyway — everyone falls through to their letter plaque (see
  // "Character proxying" in CLAUDE.md). Existing Character.avatarData is
  // untouched either way; this only gates new uploads. On by default since
  // 2026-09-08 — a game that starts with faces turned off means somebody has
  // to remember to turn them on, and nobody did.
  avatarUploadsEnabled Boolean @default(true)

  // Master switch for the in-app portrait maker (docs/systemdocs/PORTRAITS.md).
  // Off means the "Customize Appearance" button doesn't render and
  // setPortraitAvatar refuses whatever the client posts — the same
  // presentation/lock split as avatarUploadsEnabled above. On by default for
  // the same reason.
  portraitMakerEnabled Boolean @default(true)

  // Reveals the portrait parts the catalog marks `fantasy`: pointed ears,
  // horns, antlers, and unnatural hair and eye colours. Ravenheart is low
  // fantasy and human-only, so these are hidden rather than deleted — a GM
  // running something stranger flips this and they appear. Off by default, and
  // re-checked server-side: a portrait already wearing horns when it is turned
  // back off keeps them until its owner next saves.
  portraitFantasyPartsEnabled Boolean @default(false)

  // RETIRED 2026-09-13: the per-slot rules (Tag.equipSlot, db/lib/equipSlots.js)
  // are the whole limit now, and nothing reads this column. It stays so no
  // migration drops a value; it is INTERNAL_KEYS in db/lib/gameConfigFields.js.
  equipSlots Int @default(10)

  // Carry caps: how many POUNDS of tradeable tags and how many ⬢ a character
  // can hold before they are Overburdened (docs/systemdocs/CARRY.md). Base
  // values, raised or lowered by the sum of every ACTIVE Tag.carryBonus. Going over is
  // allowed up to 1.5× (carry.js HARD_CAP_RATIO); past that the goods cannot
  // enter the sheet at all. Assets — a horse, a cart, a house — are exempt
  // from the weight load entirely. Live on /gm/dev.
  carryWeightLbs   Int @default(71)
  carryResourceCap Int @default(25)

  // Free zone crossings per character per turn, before a crossing starts
  // spending the Move (docs/systemdocs/CARRY.md §2). An equipped mount adds
  // one on top; Overburdened zeroes the allowance. Live on /gm/dev.
  freeZoneMovesPerTurn Int @default(1)

  // TWO ceilings on drawbacks at creation, and a build stops at whichever it
  // reaches first (TAGS.md §4a). Neither works alone: with a count cap only,
  // five −1s and five −11s cost the same five slots, so the cap reads as an
  // instruction to stack the heaviest tags in the catalog; with a point cap
  // only, one Appendicitis finishes you while ten −1s are never stopped.
  //
  // Both count POINT_BUY drawbacks only — a role's free drawback (the
  // Meister's Frail, the Headman's Old) arrives as GM_GRANT, and so does
  // anything a GM or a turn effect inflicts, so neither eats into a player's
  // allowance. Enforced in createCharacter, shown live as the two bars in
  // PointBuy's build pane; /store passes neither, because the caps belong to
  // the wizard and stop existing once play starts. Both are editable live
  // from the Dev Panel, same posture as equipSlots above, and 0 is a real
  // setting on either: no drawbacks at all.

  // How many drawback TAGS may be bought — a cap on the COUNT of
  // negative-cost tags picked, whatever they are worth.
  maxDrawbackTags Int @default(6)

  // How many points those drawbacks may claim back in total. Stored as a
  // POSITIVE magnitude — "at most 12 points may be claimed" — even though
  // every drawback carries a negative pointCost, so nothing has to do a sign
  // dance to compare against it. It matches startingTagPoints on purpose:
  // you can never claim back more than you started with.
  maxDrawbackPoints Int @default(13)

  // How many Desire slots a character has, each of which can be claimed into
  // once every desireSlotLockTurns turns. Same live-editable posture as
  // equipSlots above.
  desireSlots Int @default(2)

  // Whole turns a Desire slot stays shut after a Desire is claimed into it.
  // A claim on turn N leaves the slot shut on N and open again on
  // N + desireSlotLockTurns + 1 (db/lib/desireGates.js#slotStates).
  desireSlotLockTurns Int @default(1)

  // Expected total number of players, the denominator for every role's seat
  // cap: a role with `weight: 6` in docs/roles.yaml gets
  // round(6 * playerCount / 100) seats — so the weight is always "seats per
  // 100 players" no matter what this is set to. Raising it mid-signup widens
  // every capped role proportionally without touching the YAML.
  //
  // roleCapacity() floors a weighted role at 1 seat, so shrinking this never
  // makes a role in the YAML unpickable.
  playerCount Int @default(80)

  // The narrowcast channels (#cerberon, #27.065) live under a shared Discord
  // "radio" category — see db/lib/specialChannels.js. Provisioned once by
  // npm run db:sync-narrowcast-channels; never touched again after that.
  // #intercom used to be the second one; it is a button on the Council Room
  // table now, so its column is gone with it.
  radioCategoryId     String?
  cerberonChannelId   String?
  // The second net (2026-09-10): an open frequency anyone holding a
  // Radio (27.065) both hears and speaks on. Column name can't lead with a
  // digit; the channel itself is named after the frequency.
  freq27065ChannelId  String?
  // The third net: the Tribunal's own frequency, held by the Tribune and
  // Tribunal Ordinator seats (Radio (243.000), docs/tags.yaml). Same shape
  // as freq27065ChannelId above.
  freq243000ChannelId String?

  // DEADCHAT (db/lib/deadchat.js): the one room the dead talk in, and the only
  // place a ghost has a voice. Its own category rather than the radio one — a
  // net is something you carry, this is somewhere you end up.
  //
  // Opened by PER-MEMBER overwrites, never a role. The Ghost role that used to
  // do this job was an out-of-character leak: Discord prints a member's roles on
  // their profile card, so "Ghost" told anyone who clicked that a player was
  // dead. An overwrite is visible only inside the channel it opens, and everyone
  // who can open this one is already dead.
  deadchatCategoryId String?
  deadchatChannelId  String?

  // The Catatonic (AFK) pass (db/lib/catatonicPass.js): any ALIVE character
  // with no player-filed Action and no in-character speech for
  // catatonicTurns turns straight is flagged; the flag lifts the moment they
  // act or speak again. On by default — this doesn't delete anything, it
  // just marks the sheet for a GM to see, and it always runs — the turn
  // count below is the dial, not an on/off switch.
  catatonicTurns Int @default(4)

  // Consecutive turns holding `catatonic-afk` before
  // db/lib/catatonicDeathPass.js kills the character outright at turn close. This is the ONE thing in the
  // engine that ends a character without a GM (TURN-ENGINE.md §2 pass 7b), so
  // it gets its own off switch: 0 disables the death pass entirely, without a
  // deploy, while leaving the flagging pass above untouched.
  catatonicDeathTurns Int @default(4)

  // How many turns a paper pinned to a noticeboard stays up before it blows
  // away, counting the turn it was pinned in. The paper is destroyed with the
  // post — a notice nobody took down is a notice nobody wanted.
  // See docs/systemdocs/PAPERWORK.md.
  noticeExpiryTurns Int @default(10)
}

/// Where a game is in its life. The turn cron and the force-advance button
/// both refuse outside RUNNING; readying up is LOBBY only; late join is
/// RUNNING only (a GM may skip ahead during LOBBY). See
/// docs/systemdocs/LOBBY.md §1.
enum GamePhase {
  CLOSED
  LOBBY
  RUNNING
  ENDED
}

/// PER-GAME state: everything a game does to the world that is not on a
/// Character, a Room or a Turn. Restart Game deletes this row and creates a
/// fresh one, which is what guarantees nothing here can leak into the next
/// game — the old allowlist on GameConfig missed four columns and nobody
/// noticed. Read through db/lib/gameState.js#getGameState.
/// One row per game KEPT, and the part of a game that outlives its wipe: when
/// it ran, how it ended, and the reveal (docs/systemdocs/LOBBY.md §7).
/// ArchiveEntry rows carry a Game's id as a snapshot column, which is what
/// lets /archive show a past game after Restart Game has cleared everything
/// else.
///
/// "Kept", not "ever run": Restart Game asks whether the ending game is worth
/// keeping, and a discarded playtest takes this row with it
/// (docs/systemdocs/ARCHIVE.md). Thirteen throwaway test games in the picker
/// before launch is what changed that.
model Game {
  /// A game IS its id. There was a creation ordinal beside it — `number` —
  /// until 2026-09-09: it climbed to 13 before the game had launched once,
  /// every playtest wipe consuming one, and it was never anything a person
  /// should read. Ordering is `createdAt`, naming is the label or the dates
  /// (web/lib/gameLabel.js), and the id is what a URL and an audit row carry.
  id          String    @id @default(cuid())
  startedAt   DateTime?
  endedAt     DateTime?
  closingNote String?
  playerCount Int?
  // db/lib/epilogue.js#buildEpilogue: { closingNote, facts, roster }. Written
  // when the game ends, or by the wipe if it never did.
  epilogue    Json?

  // How this game ended, if it ended with a bang. Turn NUMBERS, and they live
  // here rather than on GameState because turn numbers restart at 1 every game
  // — which made the GameState copies meaningless the moment a new game began,
  // and every reader treated a stale one as current. On 2026-09-09 a new game
  // opened wearing the last one's fireball: the nuke plate above every turn
  // announcement and an epilogue on a game that had only just started.
  //
  // A Game row is created fresh by the wipe, so these cannot cross a game
  // boundary the way the GameState columns could. Set once, never cleared
  // within a game — turnBannerPath pins the sky on the strength of that.
  nukeDetonatedTurn  Int?
  ascensionFiredTurn Int?

  createdAt DateTime @default(now())

  /// What a reader sees instead of a number, when it is worth naming.
  label String?

  /// The archive packet (docs/systemdocs/ARCHIVE.md). `exportKey` is the S3
  /// object holding this game's transcript as gzipped JSONL, and `entryCount`
  /// is how many ArchiveEntry rows went into it — both stamped by the Archive
  /// button, before any delete.
  ///
  /// `archivedAt` is the one that changes how the game READS: it means the
  /// rows have left the database and /archive must render the epilogue stub
  /// rather than an empty transcript. A row with `exportKey` but no
  /// `archivedAt` is exported and still fully present, which is the state the
  /// Archive button leaves it in and the state Restart Game requires.
  exportKey  String?
  entryCount Int?
  archivedAt DateTime?

  /// The highest ArchiveEntry.seq the packet actually covers.
  ///
  /// This is what bounds the wipe's delete, and it is not optional: the bot
  /// keeps writing between the moment the packet is made and the moment
  /// Restart Game runs, and without the bound those rows would be destroyed
  /// having never been in the file. It also makes the delete resumable.
  exportMaxSeq BigInt?

  states GameState[]
}

model GameState {
  id Int @id @default(1)

  // The current Game. The wipe creates the next one and points here at it.
  gameId String
  game   Game   @relation(fields: [gameId], references: [id])

  phase         GamePhase @default(CLOSED)
  lobbyOpenedAt DateTime?
  startedAt     DateTime?
  endedAt       DateTime?

  // Stamped by Start Game as ceil(readied players * 1.09), the 9% being
  // headroom for late joins. The denominator for every weighted seat from
  // then on; before Start, GameConfig.playerCount stands in
  // (db/lib/gameState.js#effectivePlayerCount).
  playerCount Int?

  // The superadmin's epilogue, written when the game is ended and shown above
  // the reveal roster on /epilogue and in the Game Ended post.
  closingNote String?

  // The previewed assignment Start Game commits: { seed, playerCount, rows:
  // [{ discordUserId, roleSlug, source }], warnings }. Written by Preview,
  // edited row by row by hand-setting, re-validated and cleared by Start. Null
  // means Start is disabled — there is nothing to commit.
  assignmentDraft Json?

  // Whether players can reach /archive. GMs always can. Off until the game is
  // ended, when endGame flips it: the archive shows every location regardless
  // of where a character was, and renders a concealed message as
  // "Alias (Real Name)" — so opening it mid-game retroactively unmasks every
  // /conceal ever used and hands everyone the whole map's history.
  archiveVisible Boolean @default(false)

  // The Lifeweb's blood pool, 0-100 (db/lib/lifeweb.js).
  lifewebBlood Int @default(100)

  // GM override consumed by the next turn advance, then nulled.
  nextTurnNote String?

  // THE BOMB. Two nullable turn numbers, and nothing else in the schema knows
  // about it.
  //
  // `nukeArmedTurn` is the absolute turn the device goes off on — stamped by
  // the Arm button as `openTurn + 2`, nulled by Disarm or by a GM defusing it
  // from /gm/dev. Null means unarmed, and arming/disarming may repeat forever.
  //
  // This lives here rather than on a tag with `expiresTurn`, which was the
  // first design: a tag carries a holder, and a holder can DIE inside the
  // two-turn window, which would quietly cancel the explosion. The blast is
  // global — everyone above ground, wherever they stand — so it needs no
  // location, and the one thing it must survive is the death of whoever armed
  // it. Where the device physically SITS is still read off the tag rows, by
  // the datacard's pointer, which is a different question.
  nukeArmedTurn Int?

  // Set once, on detonation, and never cleared: the turn the world ended. It
  // is what makes the fireball banner permanent (db/lib/turnAnnouncement.js).
  nukeDetonatedTurn Int?

  // The triple-barrelled gun on the rotor in the fortress yard. Unlike the
  // Depot's, it carries no tunable table and no face to spare: armed, it fires
  // on everyone standing in the Gatehouse (db/lib/gatehouseTurret.js). It lives
  // here rather than on a model of its own because there is exactly one of it
  // and its whole state is this boolean. Flipped from the red button in the
  // Censor's Office thread, never from a web page — the only safeguard on it is
  // that somebody has to walk up to the wall.
  //
  // OFF by default, which is also what the Baron's charter has always claimed:
  // "It seems to be off."
  gatehouseTurretArmed Boolean @default(false)

  // When the Cathedral bell was last rung, so the rope has a cooldown on it
  // (db/lib/bell.js). Global rather than per-character: the bell is one
  // object, and two people taking turns on it would be the same noise either
  // way. Null means it has never been rung.
  bellRungAt DateTime?

  // THE THANATI (docs/systemdocs/THANATI.md). Both per-game, both wiped for
  // free because Restart Game recreates this row.
  //
  // `riteWords` is this game's Word of the Circle per rite — { [riteKey]:
  // "word word" } — rolled lazily by db/lib/riteWords.js the first time
  // anything asks (a chant, the Grimoire document, the GM panel). Null means
  // not rolled yet. Hidden game state: only a Grimoire holder and the GM
  // panel ever read it back.
  riteWords Json?

  // The cult's hideout: the Room the Thanati Leader chose with Set Hideout,
  // where Purchase Gear spends from and drops to. A snapshot id rather than
  // an FK — Rooms are recreated by db:sync-zones and a dangling pointer just
  // reads as "no hideout" (db/lib/thanati.js#hideoutRoom).
  thanatiHideoutRoomId String?

  // THE RITE OF ASCENSION, which is the second way a game can end and the
  // bomb's shape exactly (see nukeArmedTurn above for the reasoning — a
  // countdown on a tag dies with its holder, and this one must not).
  //
  // `ascensionArmedTurn` is the absolute turn Ravenheart burns on, stamped by
  // the rite as `openTurn + 2`. Null means nothing is coming.
  ascensionArmedTurn Int?

  // Set once, when it happens, and never cleared: what stops a resumed advance
  // burning the world twice, and what pins the hellfire banner on for good
  // (db/lib/turnBanner.js).
  ascensionFiredTurn Int?

  // The leader whose death is the only thing that calls it off. A snapshot id,
  // no FK, the log-table convention — the row it points at may be deleted by a
  // Restart, and a dangling pointer reads as "the leader is gone", which
  // cancels, which is the safe direction.
  ascensionLeaderCharacterId String?

  // The Rite of Fulfillment pays out once per game. Claimed with a guarded
  // write on this column, so two circles chanting at the same minute cannot
  // both collect (db/lib/riteEffects.js).
  fulfillmentFiredAt DateTime?
}

/// Where the shuttle is. AWAY is the resting state — it lives at the orbital
/// station and the landing pad is an empty scorch mark. INBOUND is the gap
/// between calling it down and it arriving, which is what the cooldown buys.
/// DOCKED means it is sitting on the pad with its hold open, and the clock in
/// Depot.shuttleTurn is counting toward the automatic departure.
enum ShuttleState {
  AWAY
  INBOUND
  DOCKED
}

/// The Merchant's Depot as a machine rather than a shop: one generator, one
/// shuttle, one turret, one bank account. A singleton on id = 1, reached the
/// same way GameConfig is (`upsert({ where: { id: 1 } })`).
///
/// It is its own model rather than eighteen more columns on GameConfig for two
/// reasons. GameConfig is game-wide switchboard; this is one location's
/// hardware, and mixing them makes both harder to read. And the Dev Panel's
/// Depot section wants to render exactly these fields — a model boundary is
/// also a form boundary.
///
/// Every number here moves through db/lib/depotState.js, never a bare update:
/// the account and the fuel both clamp inside a single locked statement, the
/// way lifeweb.js#bumpBlood does, so two people spending at once cannot stomp
/// each other. See docs/systemdocs/DEPOT.md.
model Depot {
  id Int @id @default(1)

  // ─── Live state ───

  // The account. One balance for the whole station, in obols — and an obol is
  // one ⬢, so this compares directly against any price in the catalog. It is
  // NOT on the Merchant's character on purpose: the licence is tradeable, so
  // handing it over hands over the money too, which is what makes the card
  // worth stealing.
  //
  // The default is the station's OPENING FLOAT, and it is the only place that
  // number lives: Restart Game deletes this row and recreates it bare
  // (web/app/(app)/gm/dev/actions.js), so every new game starts here. It is
  // deliberately separate from the Merchant's own purse, which is 20 ¢ of
  // physical obol tags granted by docs/roles.yaml — the station having a
  // float of its own does not mean he does, and spending one never touches
  // the other.
  accountObols Int @default(20)

  // Drawn against the Company's line, in obols. Repaying frees the room back
  // up immediately. Kept separate from accountObols so a Merchant deep in debt
  // still reads as having cash on hand — because he does, it just isn't his.
  debtObols Int @default(0)

  // The generator. With it off, nothing at the Depot works: no ordering, no
  // shuttle, no ATM, no turret. Fuel burns down every turn it is running, and
  // hitting zero switches it off rather than going negative.
  generatorOn   Boolean @default(false)
  generatorFuel Int     @default(0)

  // The indoor turret. It shoots everyone whose PRESENTED name is not
  // merchantFace — so a concealed Merchant is shot by his own gun, and anyone
  // wearing his name is spared. Deliberately not keyed on the keycard or the
  // role: it reads faces, and that is the whole trap.
  //
  // merchantFace is written when a character is created on the Merchant role,
  // and a GM can override it from /gm/dev. It is set once and never resynced,
  // because a face does not change when the papers do.
  turretArmed  Boolean @default(false)
  merchantFace String  @default("")

  // The shuttle, and the turn its current state began. shuttleTurn is what
  // both clocks read: the cooldown before it can be sent back, and the
  // automatic departure at shuttleMaxTurns.
  shuttleState ShuttleState @default(AWAY)
  shuttleTurn  Int?

  // What has been ordered but not yet flown down. A JSON array of
  // `{ tagId, quantity, unitPrice }`, paid for at order time and turned into
  // crates when the shuttle lands. Not a table because it is short-lived, is
  // only ever read whole, and belongs to exactly one row.
  manifest Json @default("[]")

  // ─── Tunables, all editable from the Dev Panel's Depot section ───

  fuelMax         Int @default(100)
  fuelBurnPerTurn Int @default(20)
  coalFuel        Int @default(50)
  saltpeterFuel   Int @default(15)

  shuttleMaxTurns Int @default(6)
  shuttleCooldown Int @default(1)

  creditCapObols Int @default(75)

  updatedAt DateTime @updatedAt
}

// Master-sourced from docs/roles.yaml's zones[].factions[]
// (db/lib/syncRoles.js#syncRolesFromYaml, npm run db:sync-roles), then LIVE:
// players found factions, rename them, secede from a parent and move between
// them, so nothing here is safe to re-derive from the YAML.
//
// `slug` is the stable match key and the ONLY thing code may branch on --
// `name` is player-editable (db/lib/factionConstants.js#isUnaffiliated).
model Faction {
  id   String @id @default(cuid())
  slug String @unique
  name String

  // Where this faction banks: a Room, whose own `resources` and RoomTag
  // stacks ARE the silo (CARRY.md, FACTIONS.md). There is no faction-level
  // balance -- a Silo model existed until 9/2026 and is not coming back.
  // Seeded create-only from roles.yaml's `silo:`, then owned by the faction's
  // officers. SetNull, so pruning a room in db:sync-zones unpoints the silo
  // rather than cascading the faction away.
  siloRoomId String?
  siloRoom   Room?   @relation("FactionSilo", fields: [siloRoomId], references: [id], onDelete: SetNull)

  // The character who founded this faction in play; null for every faction
  // the YAML authored. Kept as a plain id rather than a relation: the founder
  // can die, leave or be deleted, and none of that should touch the faction.
  foundedById String?

  applications FactionApplication[]

  // The Zone this faction belongs to, from its nesting in roles.yaml. Groups
  // the character-creation role picker (Zone -> Faction -> Role) and labels
  // the faction on every ZoneChip surface. Members are not confined to it.
  zoneId String?
  zone   Zone?   @relation("FactionHomeZone", fields: [zoneId], references: [id])

  // Authoring order within the zone, so the picker lists factions the way
  // roles.yaml does rather than alphabetically.
  sortOrder Int @default(0)

  roles Role[]

  // Nesting, for the role picker and the roster. Membership/leadership
  // administration stays same-faction only.
  parentFactionId String?
  parentFaction   Faction?  @relation("FactionHierarchy", fields: [parentFactionId], references: [id])
  subjectFactions Faction[] @relation("FactionHierarchy")

  characters Character[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One live handshake between a character and a faction, in whichever
// direction it was opened. Deliberately NOT a Request (REQUESTS.md): a
// Request lands immediately and is reviewed afterwards, carrying an applied
// `effect` snapshot, and an application's whole nature is that it sits
// pending until somebody answers it.
enum FactionApplicationKind {
  // The character knocked. Any officer of the faction answers.
  APPLICATION
  // An officer knocked. The named character answers.
  INVITE
}

enum FactionApplicationStatus {
  PENDING
  ACCEPTED
  DECLINED
  // Pulled back by whoever opened it -- including automatically, when the
  // applicant joins somewhere else or dies.
  WITHDRAWN
}

model FactionApplication {
  id String @id @default(cuid())

  factionId String
  faction   Faction @relation(fields: [factionId], references: [id], onDelete: Cascade)

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  kind   FactionApplicationKind
  status FactionApplicationStatus @default(PENDING)

  // What the applicant or the inviting officer wrote. Free text, shown to the
  // other side verbatim.
  note String @default("")

  // Who answered and when are deliberately NOT columns here. Every decision
  // already writes an AuditLog row naming the actor, and `updatedAt` below is
  // the timestamp -- two more fields nothing read would have been state
  // stored twice.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([factionId, status])
  @@index([characterId, status])
}

// A region of the map: a Discord category, its #summary channel and the
// "Zone: {Name}" role. Since Bascinet 2 a character STANDS in a Location
// (below), not in a zone; Character.zoneId is kept equal to
// location.zoneId because dozens of readers group by it. Mastered by
// docs/zones.yaml (db/lib/syncZones.js, npm run db:sync-zones), which is
// destructive both ways, matched on `slug`.
//
// Access is ONE Discord guild role per presence zone ("Zone: Town",
// discordRoleId below) opening #summary, #turns and #intercom, plus one
// "Location: {Name}" role per Location opening that Location's channel.
// Moving a character is a role swap, and every channel carries a handful of
// role overwrites instead of one per member. That is what makes drift cheap
// to detect and repair — see db/lib/channelDoctor.js.
//
// kind decides the Discord footprint (see ZoneKind above). seatZoneId is the
// denormalized GM-seat key: parentZoneId ?? id, written by the sync. Every
// query that groups by "which GM's table does this belong on" — factions,
// Action/Note/StagedMessage stamping — filters on
// seatZoneId, so the four GM seats stay four while presence is six. Writers
// stamp it via db/lib/seatZone.js#seatZoneIdFor, never by hand.
//
// There is no zone-level travel graph any more: the graph is between
// Locations (Location.connectsTo), and a hop whose edge crosses a zone
// boundary is what costs the character's Move.
model Zone {
  id   String @id @default(cuid())
  slug String @unique
  name String

  kind ZoneKind @default(SURFACE)

  // Authoring order from the YAML, so category sorting and pickers match the
  // file rather than the alphabet.
  sortOrder Int @default(0)

  // The short blurb heading the zone's "Create a Topic" post. One or two
  // sentences ("A fertile valley.").
  description String @default("")

  // Self-parent: only CAVE_LEVEL rows set it, pointing at the CAVE_GROUP.
  parentZoneId String?
  parentZone   Zone?   @relation("ZoneNesting", fields: [parentZoneId], references: [id])
  childZones   Zone[]  @relation("ZoneNesting")

  // parentZoneId ?? id — see the model comment. A single equality, no
  // recursion, for every seat-scoped query.
  seatZoneId  String?
  seatZone    Zone?   @relation("ZoneSeat", fields: [seatZoneId], references: [id])
  seatedZones Zone[]  @relation("ZoneSeat")

  // Discord footprint. Null until provisioned by the sync (create-only,
  // keyed on discordCategoryId being null — names are one-time; renaming a
  // zone in the YAML does not rename live channels). SURFACE gets a category
  // and #summary; CAVE_GROUP only the category; CAVE_LEVEL neither — its
  // Location channels parent to the group's category.
  discordCategoryId       String?
  discordSummaryChannelId String?

  // The zone's access role ("Zone: Town"). Held by every character standing
  // in any of its Locations; grants ViewChannel on #summary (and, via
  // db/lib/turnsChannelAccess.js and the #intercom registry, on the standing
  // channels). Permissions 0, color 0, never hoisted or mentionable.
  discordRoleId String? @unique

  // The zone's GM role ("GM: Town"). This is what actually opens the zone's
  // category, #summary and every one of its Location channels to a GM --
  // the global Gamemaster role no longer does, which is the whole point:
  // a GM sees the zones they picked, not all 56 Locations at once. Granted
  // and revoked per member by db/lib/gmZoneRoles.js from the GmZoneView
  // table. Permissions 0, never hoisted or mentionable, same as the access
  // role above.
  gmRoleId String? @unique

  // Clickable region on the /map plate: a polygon of [x, y] percentage pairs
  // (0-100 of the 4:3 plate, origin top-left), plus where the label sits.
  // Json because a region is a variable-length point list. Null/empty means
  // the zone draws nothing (the CAVE_GROUP row).
  mapPolygon Json?
  mapLabelX  Float?
  mapLabelY  Float?

  // Soft-retire, set from /gm/dev/zones. A retired zone drops out of every
  // picker, travel graph, the map and the mirror's desired state — the
  // mirror never deletes, so its Discord footprint (if any was ever built)
  // is left for a human to clean up. Null means live. See db/lib/placeDeletable.js.
  retiredAt DateTime?

  locations        Location[]
  factions         Faction[]         @relation("FactionHomeZone")
  characters       Character[]
  actions          Action[]
  notes            Note[]
  gmZoneViews      GmZoneView[]
  stagedMessages   StagedMessage[]
  startingForRoles Role[]            @relation("RoleStartingZone")
  cavingRolls      CavingRoll[]
  laborDropOptions LaborDropOption[]
  oraclePages      OracleSynopsis[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([seatZoneId])
  @@index([parentZoneId])
}

/// Which zones one GM has chosen to SEE. Replaced GmAssignment, which was a
/// soft seat -- it picked the default filter on the GM tables and hid
/// nothing. This is the opposite: it is a real gate, on both faces at once.
/// The rows decide which "GM: <Zone>" Discord roles the GM holds (so which
/// Location channels exist for them at all, db/lib/gmZoneRoles.js) and which
/// rows the adjudication and player desks show.
///
/// NO ROWS MEANS EVERY ZONE. A GM who has never touched the control, or who
/// unticks the lot, sees everything -- never nothing. The alternative locks
/// a new GM out of their own job on their first day and looks like a broken
/// app rather than an unset preference. It is also what makes the migration
/// off GmAssignment safe: the table lands empty and nobody loses anything.
///
/// ONE ROW PER ZONE, keyed on discordUserId rather than hung off Character,
/// because a GM may never roll one -- and should not lose their view when
/// theirs dies. Unlike the old seat, a CAVE_LEVEL row is fine here: this is
/// about which channels you can open, and the cave levels have their own.
model GmZoneView {
  discordUserId String
  zoneId        String
  zone          Zone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([discordUserId, zoneId])
  @@index([zoneId])
  @@index([discordUserId])
}

/// Where a character STANDS — the unit of presence and channel access since
/// Bascinet 2. One Discord text channel per Location under its zone's
/// category. A Location wears NO Discord role: the channel is opened to
/// whoever is standing in it by a per-member permission overwrite, written by
/// db/lib/locationMove.js and reconciled by the channel doctor's
/// location-occupancy check. 56 locations would otherwise have cost 56 of the
/// guild's 250 roles on top of one personal role per living character;
/// Discord allows 1000 overwrites per channel instead. Its Rooms are threads
/// under that channel. Mastered by docs/zones.yaml's per-zone `locations:`
/// maps (db/lib/syncZones.js); everything Discord-side is create-once and
/// reconciled every run, the way zones are.
///
/// linksA/linksB are the two halves of the undirected travel graph, which is
/// LocationLink — see that model. A hop between two Locations of the same
/// zone is free (on the GameConfig.locationMoveCooldownSeconds cooldown); a
/// hop whose edge crosses into another zone costs the Move, exactly as zone
/// travel used to.
// The four specialised labor types. A Location carries one LocationYield row
// per kind it supports; no row at all means that kind is impossible there,
// which is what the Labor? button prints as a bare "x".
enum LaborKind {
  HUNTING
  FARMING
  FISHING
  PROSPECTING
}

// What one Location yields for one labor type, and how far it has drifted from
// what docs/zones.yaml authored. One row per (location, kind) - at most 224 of
// them (56 Locations x 4 kinds), and only for kinds the location actually
// supports.
//
// Split out of Location rather than added as columns because the drift pass
// (db/lib/laborYield.js) wants one uniform row shape to walk, and nine columns
// plus six of drift state would have made Location unreadable for a concept
// that only laboring cares about.
model LocationYield {
  id         String    @id @default(cuid())
  locationId String
  location   Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  kind       LaborKind

  // Authored in docs/zones.yaml's per-location `yield:` block and pushed by
  // db:sync-zones. The value `current` reverts toward.
  base Float

  // The live coefficient, re-drifted at every turn close. This is what a
  // payout multiplies by and what the Labor? button reads - never `base`.
  current Float

  // An active swing. While set and unexpired, `current` reverts toward
  // `eventTarget` instead of `base`; when the window passes both are cleared
  // and the ordinary reversion walks it home on its own.
  eventTarget    Float?
  eventUntilTurn Int?

  updatedAt DateTime @updatedAt

  @@unique([locationId, kind])
}

// The labor drop die's config: what a Labor payout can find, keyed by which
// face of a 1-6 roll landed, up to two scopes at once (a labor type, and
// either a zone or a location — never both on one row), and an optional
// SEVENTH gate orthogonal to all of those — requiredTagId, "only joins the
// pool for a character who holds this tag too" (Forester in the Forest is
// the first user). Pure config, not player state — no CharacterTag or Action
// row ever points at one of these rows, so docs/labordrops.yaml replaces the
// whole table on every sync run rather than upserting it
// (db/lib/syncLaborDrops.js). See docs/systemdocs/LABORDROPS.md.
enum LaborDropLaborType {
  BASIC
  SKILLED
  HUNTING
  FARMING
  FISHING
  PROSPECTING
}

enum LaborDropKind {
  TAG
  RESOURCES
  NOTHING
}

// How rare a TAG entry is within its pool. The same six names
// db/lib/cavingLoot.js uses, deliberately — two loot systems in one game
// should not speak two vocabularies. The NUMBERS are not shared: the
// probability each name carries lives in db/lib/labordropsRarity.js, keyed by
// die face, and a cave 6 and a labor 6 are different events.
//
// Only TAG rows carry one. A NOTHING pad and a RESOURCES delta are not items
// and sit in their own bands, outside the ladder — the sync refuses a rarity
// on either.
enum LaborDropRarity {
  ULTRACOMMON
  COMMON
  UNCOMMON
  RARE
  EXTREMELY_RARE
  NEARLY_IMPOSSIBLE
}

// One entry in one pool. A "table" is never its own row: it is every
// LaborDropOption sharing one (roll, laborType, zoneId, locationId) scope.
// Combining several scopes at once (LABORDROPS.md §2) is a query over this
// table, not a join anywhere else.
//
// The draw is TWO-STAGE now, not uniform: land on a rarity band by the die
// face's column, then pick evenly among that band's members
// (db/lib/labordropsRarity.js), the same shape db/lib/cavingLoot.js has
// always had. Repeat-to-weight is gone with it — a repeated entry is now
// just a duplicate, and the sync says so.
model LaborDropOption {
  id String @id @default(cuid())

  // Which face of the Labor die this entry answers, 1-6.
  roll Int

  // Every dimension below is optional, and the SET of six legal combinations
  // (laborType alone, zoneId alone, locationId alone, laborType+zoneId,
  // laborType+locationId, or all-null for Global) is enforced by the sync,
  // not by the schema — zoneId and locationId are never both set on one row.
  laborType LaborDropLaborType?

  zoneId String?
  zone   Zone?   @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  kind LaborDropKind

  // TAG only, and required on every TAG row (the sync enforces both).
  // Authored as `rarity:` in docs/labordrops.yaml.
  //
  // This replaced repeat-to-weight, which was the only lever the old uniform
  // draw had: 87 of the file's 180 lines were duplicates, 53 more were
  // `nothing` pads, and nothing could be rarer than 1/poolsize. See
  // db/lib/labordropsRarity.js for what each name is worth and why the
  // column is keyed by face.
  rarity LaborDropRarity?

  // TAG only. Cascades on delete rather than blocking a tag prune — the sync
  // fully rebuilds this table from docs/labordrops.yaml on every run, so a
  // row orphaned by a pruned tag either comes back on the next sync or the
  // sync throws on a YAML entry naming a slug that no longer exists, the
  // same as any other stale reference.
  tagId String?
  tag   Tag?    @relation("LaborDropGrantTag", fields: [tagId], references: [id], onDelete: Cascade)

  // RESOURCES only. A ⬢ delta — usually a bonus, but nothing stops a
  // negative one for a bad-table entry.
  resourceAmount Int?

  // The seventh gate, orthogonal to roll/laborType/zoneId/locationId: null
  // (the overwhelming common case) means every character; set, this row only
  // enters the combined pool for a character who holds this tag, checked in
  // application code (db/lib/laborDrops.js#passesRequiredTag) rather than the
  // SQL WHERE — the six scopes above are matched in the query, this is a
  // post-filter over whichever of those rows come back, because "does this
  // character hold tag X" isn't expressible as a join against a query keyed
  // on the drawing character's zone/location/laborType alone. Authored in
  // docs/labordrops.yaml as a `requiresTag:` block nested under any of the
  // six buckets. Same cascade reasoning as tagId above.
  requiredTagId String?
  requiredTag   Tag?    @relation("LaborDropRequiredTag", fields: [requiredTagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([roll, laborType, zoneId, locationId])
  @@index([requiredTagId])
}

model Location {
  id   String @id @default(cuid())
  slug String @unique
  name String

  // The -# subtext under the name on the channel's anchor message, and the
  // channel topic.
  description String @default("")

  // Authoring order within the zone, from the YAML — channel order under the
  // category and picker order.
  sortOrder Int @default(0)

  // A place you walk INTO: the Cathedral, the Sanctuary, the Inn, the Keep,
  // the Undercroft, the Factory. A cart or a mount is unequipped on arrival
  // (db/lib/locationMove.js) and cannot be equipped while you stand here, so
  // its carry bonus is parked at the door with it. Authored as `indoors: true`
  // in docs/zones.yaml; the anchor message says so in its own -# line.
  indoors Boolean @default(false)

  // What else is true about this place, authored as docs/zones.yaml's
  // per-location `attributes:` map. A flat JSON object of registry keys from
  // db/lib/locationAttributes.js, which is the only thing that should read it
  // — the sync rejects a key that module does not know, so a typo is a loud
  // problem rather than a line that never prints.
  //
  // JSON rather than a column per fact because these are sparse, additive and
  // player-facing prose triggers, not things anything queries or indexes on.
  // `indoors` stays a real column precisely because it IS queried
  // (db/lib/indoors.js, db/lib/mounts.js); it is merely rendered alongside
  // these.
  attributes Json @default("{}")

  zoneId String
  zone   Zone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  // See Zone.retiredAt — same soft-retire, same reason.
  retiredAt DateTime?

  // Both halves of the undirected travel graph. Never read directly: go
  // through db/lib/locationGraph.js, which normalises the two sides into one
  // neighbour list and applies each link's gating.
  linksA LocationLink[] @relation("LinkA")
  linksB LocationLink[] @relation("LinkB")

  structures Structure[]

  // The Location's text channel, null until provisioned.
  discordChannelId String?

  // The pinned anchor message (name, description, the Public Rooms index and
  // the Who's here? / Secret rooms? / Converse buttons), content-hash
  // reconciled so a no-op re-sync makes zero Discord calls.
  anchorMessageId String?
  anchorHash      String?

  rooms            Room[]
  quests           Quest[]
  characters       Character[]
  playerThreads    PlayerThread[]
  startingForRoles Role[]          @relation("RoleStartingLocation")
  yields           LocationYield[]
  noticePosts      NoticePost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Moves filed while standing here (Action.locationId).
  actions          Action[]
  threatSpawns     ThreatSpawn[]
  cavingRolls      CavingRoll[]
  visits           LocationVisit[]
  vantages         Vantage[]
  auditLogs        AuditLog[]
  // Everybody lying in wait here. A watch is anchored to one place and dies
  // when its owner leaves it (docs/systemdocs/INTERCEPT.md §1), so a Location
  // that goes away takes them with it.
  interceptWatches InterceptWatch[]
  attacks          Attack[]
  laborDropOptions LaborDropOption[]

  @@index([zoneId])
}

/// What one character knows of the map — the fog behind /map.
///
/// There was no record of this anywhere before: AuditLog's locationId/roomId
/// (added later, forward-only, and NULL on most rows even now) can't answer
/// "where has this character ever been", ArchiveEntry is keyed to a zone
/// rather than a Location, and a free in-zone hop files no Action at all. So
/// "where have I been" had to become a table.
///
/// Two grades, and the difference is the whole UI. `stood` means the character
/// has actually been here. A row with `stood` false means they have only ever
/// seen the place from next door — it draws hollow, and carries a name and a
/// colour but no description.
///
/// NEITHER IS EVER UNLEARNED. Seen once, drawn forever: the map only grows, so
/// walking away never takes a place back off it. db/lib/locationVisits.js is
/// the only module that writes here, and its neighbour write is a createMany
/// with skipDuplicates precisely so it cannot downgrade an existing stood row.
///
/// Per CHARACTER, not per player. A re-roll starts with a blank map rather
/// than inheriting the dead character's.
model LocationVisit {
  id String @id @default(cuid())

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  stood Boolean @default(false)

  firstSeenAt DateTime @default(now())

  @@unique([characterId, locationId])
  @@index([characterId])
}

/// A Location this character walked into THIS TURN and is no longer standing
/// in — the per-turn fog of war on the channels, not the permanent fog on the
/// map. Walking in lights a place; it stays lit until the character leaves the
/// zone or the turn shifts, and either of those puts every light out at once.
///
/// Deliberately NOT called fog in code: LocationVisit above already owns that
/// word, it is never unlearned, and two tables called fog with opposite
/// lifetimes would be a trap. A vantage is a place you still have eyes on.
///
/// WHERE YOU STAND IS NEVER A ROW. That is Character.locationId, as it always
/// was, so the turn wipe is a bare deleteMany with nothing to put back and
/// there is only ever one writer of "here".
///
/// zoneId and turnId are SNAPSHOT columns with no foreign key, the same
/// reasoning the log tables use (ARCHITECTURE.md): zoneId makes the
/// leave-the-zone wipe one statement, and turnId makes a wipe that failed to
/// run read as dark rather than as a leak — every reader filters on both, so
/// a stale row is already invisible before the channel doctor takes its
/// overwrite off. db/lib/vantages.js is the only module that touches this.
model Vantage {
  id String @id @default(cuid())

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  zoneId String
  turnId String

  litAt DateTime @default(now())

  @@unique([characterId, locationId])
  @@index([characterId, turnId])
  @@index([locationId])
}

/// One edge of the travel graph, mastered by docs/zones.yaml's `connections:`.
///
/// Undirected, and stored as ONE row rather than a mirrored pair: aId/bId are
/// held in ascending Location.slug order by the sync, so an attribute cannot
/// disagree between the two directions and a modular gate cannot end up open
/// one way and shut the other. Readers must therefore match on either side —
/// db/lib/locationGraph.js is the only thing that should ever do so.
///
/// The behaviours compose rather than enumerate, because one real edge on the
/// map (the Gatehouse to the Road) is a manned gate AND a modular one:
///
///   announce         GATE / UNMANNED GATE. Posts into the destination zone's
///                    #summary on crossing — TRUE_NAME with the traveller's
///                    real name, CONCEALED with only their concealed alias.
///   requiredTagSlug  LOCKED. Crossing needs this tag. Held as a slug, not an
///                    FK, because tags sync AFTER zones and an FK would make
///                    the master unloadable in the working order; db:doctor
///                    validates it instead.
///   hidden           HIDDEN. requiredTagSlug plus omission from the travel
///                    list, so a player without the tag never learns the edge
///                    is there.
///   modular          An Open/Close button on the WATCHTOWER at the gate.
///                    Impassable while isOpen is false. Reaching the tower is
///                    the whole permission model: the room's access: list
///                    decides who may work the winch, so there is no opener
///                    list of its own.
///   onFoot           Too tight, too steep or too enclosed for a horse or a
///                    cart. A MOUNTED character is refused at the threshold —
///                    which is the point, because Location.indoors only parks
///                    a mount on ARRIVAL, and by then the rider has already
///                    spent the extra free zone-crossing an equipped mount
///                    buys (freeZoneMoves, db/lib/locationTravel.js). This is
///                    the edge-level sibling of indoors: same effect, earlier
///                    moment. Unequipping the horse is the way through.
///   keyed            On crossing, the key-holder is DM'd "Leave open for the
///                    next 24 hours?". Yes stamps openUntil, and until then
///                    the edge ignores requiredTagSlug AND is listed even when
///                    hidden — which is the point: it is how somebody without
///                    the key can follow you through. Nothing closes it; the
///                    check just compares openUntil against now.
model LocationLink {
  id String @id @default(cuid())

  aId String
  bId String
  a   Location @relation("LinkA", fields: [aId], references: [id], onDelete: Cascade)
  b   Location @relation("LinkB", fields: [bId], references: [id], onDelete: Cascade)

  announce LinkAnnounce @default(NONE)

  requiredTagSlug String?
  hidden          Boolean @default(false)

  modular         Boolean  @default(false)
  isOpen          Boolean  @default(true)
  // Orphans since the winch moved into the watchtower and the tower's access:
  // list became the only thing that decides who may work a gate. Nothing
  // reads them; db:sync-zones writes them empty. Kept rather than dropped so
  // the change needs no migration.
  openerRoleSlugs String[]
  openerTagSlugs  String[]

  // The BORN state of a modular gate (`modular.open` in docs/zones.yaml),
  // re-asserted by every sync unlike isOpen, which is play state: it is
  // what the Restart wipe resets isOpen to.
  authoredOpen Boolean @default(true)

  keyed     Boolean   @default(false)
  openUntil DateTime?

  onFoot Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([aId, bId])
  @@index([bId])
}

/// What crossing a gate announces in the destination zone's #summary.
enum LinkAnnounce {
  NONE
  TRUE_NAME
  CONCEALED
}

/// A thread under a Location's channel, sync-owned: the starter message is the
/// room's description, the message wipe empties the thread down to that starter,
/// and nothing player-facing can create, delete or unwipe one. PUBLIC rooms
/// are public threads; PRIVATE rooms are private threads whose membership is
/// exactly "holds one of accessTagSlugs", reconciled by db/lib/roomAccess.js
/// on every arrival and tag change. Mastered by docs/zones.yaml's per-location
/// `rooms:` maps.
model Room {
  id   String @id @default(cuid())
  slug String @unique
  name String

  description String @default("")

  // Authoring order within the location, from the YAML.
  sortOrder Int @default(0)

  kind RoomKind @default(PUBLIC)

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  // See Zone.retiredAt — same soft-retire, same reason.
  retiredAt DateTime?

  // Tag slugs, any of which admits a character to a PRIVATE room. Slugs, not
  // FKs, because the room is authored against docs/tags.yaml's fixed
  // identifiers and the two syncs run independently. Empty for PUBLIC.
  accessTagSlugs String[] @default([])

  // A room that eats what is put into it. Set from `destroys: true` in
  // docs/zones.yaml; the Godard Factory's Spillway is the only one. A
  // Transfer whose destination carries this never writes a RoomTag or touches
  // Room.resources — the lines are recorded on the request's effect instead,
  // so a GM can still Undo. See docs/systemdocs/CARRY.md.
  destroysContents Boolean @default(false)

  // The walls hold a shout in. Set from `soundproof: true` in
  // docs/zones.yaml. db/lib/shout.js#soundproofAt reads this — a Room's own
  // fact, and a Conversation (PlayerThread) hanging off one inherits it.
  // A Location is never soundproof itself: standing in the street outside a
  // soundproof room is not being in it.
  //
  // The column is created by migrations/20260913140000_room_soundproof. This
  // DECLARATION was lost in be5c3d7 while the column and every reader stayed,
  // so soundproofAt's query threw, its catch swallowed the error, and every
  // soundproof room quietly stopped being one.
  soundproof Boolean @default(false)

  // A key from the registry in db/lib/roomLive.js, set from `live:` in
  // docs/zones.yaml. The room's starter message carries one extra line read
  // off live state, re-rendered whenever that state moves — the Landing Pad
  // saying whether the shuttle is sitting on it. Null for the ordinary room,
  // whose starter is written once and never touched again.
  live String?

  // The thread, its starter message (a thread in a text channel has an
  // ordinary first message with its own id — only a forum post's starter
  // shares the thread id) and the body hash last written.
  discordThreadId  String?
  starterMessageId String?
  postHash         String?

  // The stash. ⬢ left lying in this room, moved only through
  // db/lib/resourceTransfer.js#moveParty with a `room:` party, and the tag
  // stacks below. Unlimited on purpose — a room is where you put what you
  // can't carry (docs/systemdocs/CARRY.md).
  resources Int       @default(0)
  tags      RoomTag[]

  // Which stash slugs this room has EVER been seeded with, from
  // docs/zones.yaml's `stash:`. seedRoomStash writes a slug only while it is
  // absent here, so an item players carried off never comes back, and a slug
  // newly authored into the YAML still seeds once.
  //
  // The old test was "does a RoomTag row exist", which could not tell
  // "emptied" from "never seeded" — taking the last unit DELETES the row
  // (db/lib/tagWrites.js#dropRoomTag), so an looted room looked identical to
  // a fresh one and every re-sync refilled it. That cost a live game 139
  // duplicated items on 2026-09-10. Slugs rather than tag ids for the same
  // reason accessTagSlugs above is: zones and tags sync independently.
  seededStashSlugs String[] @default([])

  // The Quest that minted this room, if any. A quest room is the ONE Room in
  // the game that docs/zones.yaml does not master: a GM stages it at runtime
  // from /gm/dev?s=quests, so syncZones.js's stale-room prune skips every row
  // where this is set. Everything else about it is an ordinary Room.
  questId String? @unique
  quest   Quest?  @relation("QuestRoom", fields: [questId], references: [id], onDelete: SetNull)

  playerThreads PlayerThread[]
  guests        RoomGuest[]
  auditLogs     AuditLog[]

  // Factions banking here. A list rather than a single back-reference because
  // nothing stops two factions sharing a room -- the Church and the Order
  // both sit in the Cathedral.
  siloOf Faction[] @relation("FactionSilo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId])
}

/// One stack of a tag lying in a Room. No per-room limit, and unlike
/// CharacterTag there is no non-stackable pin: two players can each leave a
/// Longbow here and the row goes to 2 — the pin is a rule about what one
/// CHARACTER can hold, re-applied on the way out by tagWrites.js#addToStack.
/// `expiresTurn` rides along from the holder's row so stashing a meal can't
/// stop it rotting; the sweeps in db/index.js shed it the same way.
// A paper pinned to a Location's noticeboard. See
// docs/systemdocs/PAPERWORK.md.
//
// Its own table rather than a RoomTag, for three reasons. A noticeboard is a
// LOCATION fixture and only Rooms carry stashes. A post needs its own clock,
// which RoomTag.expiresTurn could have carried but nothing sweeps for a room.
// And a pinned notice must not show up in the Storage readout — a board is
// public by nature and a stash is not.
//
// tagId is @unique: the paper is ON the board or it is in somebody's hands,
// never both. Pinning moves the CharacterTag row here; tearing moves it back.
model NoticePost {
  id String @id @default(cuid())

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  tagId String @unique
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  // Who put it up, for the GM's benefit and for the ambient line. Nullable and
  // SetNull, because a notice outlives the person who pinned it — that is
  // rather the point of nailing something to a wall.
  postedById String?
  postedBy   Character? @relation("NoticePostAuthor", fields: [postedById], references: [id], onDelete: SetNull)

  postedTurn  Int
  // Absolute turn number, the same convention as CharacterTag.expiresTurn, and
  // computed through db/lib/turnFormat.js#expiryFrom so N turns means N turns
  // counting the one it was pinned in. Swept by db/lib/noticeboardPass.js,
  // which destroys the paper with the post — it blew away.
  expiresTurn Int

  createdAt DateTime @default(now())

  @@index([locationId])
  @@index([expiresTurn])
  // SetNull on a character delete, so without this Postgres scans the whole
  // table for every deleted character.
  @@index([postedById])
}

model RoomTag {
  id String @id @default(cuid())

  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  tagId String
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  quantity    Int  @default(1)
  expiresTurn Int?

  // Same pair as CharacterTag's, and the reason a room stash isn't a
  // laundering hole by accident: dropping a poisoned meal here and picking
  // it up carries the count and payload with it. Schema only for now.
  poisonedCount Int   @default(0)
  poisonPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, tagId])
  @@index([tagId])
  @@index([expiresTurn])
}

/// A Conversation: the one kind of thread a player can open, from the
/// Converse button on a Location's anchor. A private thread under the
/// Location's channel, linked to one of its Rooms — every 15 minutes the
/// linked room hears who is whispering in it (bot/src/lib/whisperPoll.js).
/// Deleted at every Dawn, no exceptions; there is no persistence any more.
/// The bot is the ONLY creator (players hold no create-thread permission),
/// so this table is complete.
///
/// Creator fields are snapshots, not FKs — the thread outlives a dead or
/// wiped character, same posture as the log tables.
model PlayerThread {
  id       String @id @default(cuid())
  threadId String @unique
  name     String

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  // The room the whispering is heard in. Set-null rather than cascade: a
  // room pruned from the YAML mid-day shouldn't destroy a live conversation.
  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)

  creatorCharacterId   String?
  creatorDiscordUserId String?

  // Written by the bot's messageCreate (debounced to one write per thread
  // per turn). Informational since Bascinet 2 retired inactivity expiry.
  lastActivityTurn Int?
  lastActivityAt   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members PlayerThreadMember[]

  @@index([locationId])
  @@index([lastActivityTurn])
}

/// Who is IN a conversation, as a row rather than as a Discord thread member
/// list. Added in phase 2 of the Hall (docs/systemdocs/HALL.md §2a).
///
/// Membership used to live only in Discord, which made it unreadable from the
/// web — the feed could not tell whose conversation this was — and unusable by
/// a player whose Discord account is out of the channels entirely. Discord's
/// thread membership is now a PROJECTION of these rows: every writer records
/// the row first and then adds the account.
///
/// `characterId` carries no FK, like PlayerThreadInvite: the conversation is
/// keyed to the PlayerThread and cascades with it, and a character that ceases
/// to exist takes the whole game's rows with it through the wipe rather than
/// through a constraint here.
model PlayerThreadMember {
  playerThreadId String
  playerThread   PlayerThread @relation(fields: [playerThreadId], references: [id], onDelete: Cascade)

  characterId String

  createdAt DateTime @default(now())

  @@id([playerThreadId, characterId])
  @@index([characterId])
}

/// Who /add has invited into a conversation. Discord's thread-member list
/// is the live truth, but it refuses (or loses) a member who can't currently
/// view the parent channel — which is exactly what /add supports: invite
/// anyone, they see the thread when they reach the Location. So the invite is
/// recorded here and re-applied by applyPendingInvites whenever the character
/// arrives in the Location, in the same pass that swaps their location role.
///
/// threadId deliberately carries no FK to PlayerThread so the doctor can
/// clean the two independently; characterId is a plain id for the same
/// reason.
model PlayerThreadInvite {
  threadId    String
  characterId String

  createdAt DateTime @default(now())

  @@id([threadId, characterId])
  @@index([characterId])
}

/// One character let into one private Room by hand rather than by holding a
/// key — the Baron waving somebody into his office. A private Room's
/// membership is otherwise pulled entirely from Room.accessTagSlugs
/// (db/lib/roomAccess.js), and this is the one exception.
///
/// The grant is SPENT WHEN THEY LEAVE. syncCharacterRoomAccess deletes every
/// row whose Room is not where the character now stands, and it already runs
/// on every arrival, so walking out of the Location is what closes the door.
/// That is why a guest is a row rather than a thread-member add and nothing
/// else: Discord's member list survives a move, and the rule must not.
///
/// Real FKs both ways, unlike PlayerThreadInvite — a Room and a Character are
/// both rows here, so the cascade is free and there is nothing for the doctor
/// to reconcile except a guest who wandered off.
model RoomGuest {
  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  /// Who opened the door, for the audit trail. Snapshot id, not an FK — the
  /// inviter may be dead by the time anyone reads it.
  invitedById String?

  createdAt DateTime @default(now())

  @@id([roomId, characterId])
  @@index([characterId])
}

/// The outcome of a long-running operational pass that runs in after() or a
/// side-effect thunk — Restart Game, the channel doctor, the message wipe, a GM
/// bulk move — where the UI has already returned "ok" long before the work
/// finishes. The Dev Panel shows the latest report per kind instead of
/// claiming a success it cannot know about. A row with finishedAt null is
/// itself the signal: the container died mid-pass.
model SystemReport {
  id   String           @id @default(cuid())
  kind SystemReportKind

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)

  actorDiscordUserId String?

  /// { steps: [{ name, ok, detail?, message? }], ... } — one entry per step,
  /// in execution order.
  summary Json @default("{}")

  /// [{ step, target?, message }] — every failure, never truncated to a
  /// count.
  failures Json @default("[]")

  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

model Character {
  id            String @id @default(cuid())
  discordUserId String

  // A displayed name is four parts, joined by
  // db/lib/characterName.js#formatCharacterName as
  // `Sir Jorren "the Blind" Vask`. `honorific` is EARNED at
  // creation: a tag the character holds or the role they took grants the
  // word, and `gender` below decides which form of it they wear
  // (db/lib/titles.js). `title` renders in quotes and is a GM's to grant.
  // Most characters carry neither. The one exception to both is the Mulligan
  // Potion, which lets a player type all four parts, prefix and quoted title
  // included — one bottle, one name (docs/systemdocs/CHARACTERS.md §1b).
  honorific String?
  firstName String
  title     String?
  lastName  String?

  // Chosen once, on the last step of creation, and never editable afterwards:
  // character/actions.js#updateCharacterProfile simply doesn't read the key,
  // which is the lock — the same silence that keeps a name immutable, not the
  // null-until-set conditional `age` below uses. A GM can still correct one
  // from /gm/dev/characters/[characterId].
  //
  // Four seats fix it rather than letting the player choose: Baron and Heir
  // are MAN, Baroness and Successor are WOMAN, declared as `gender:` in
  // docs/roles.yaml and carried on Role.lockedGender. Those are the same four
  // that already inherit the dynasty surname.
  //
  // Defaulted rather than nullable so the column backfills itself and no
  // reader has to handle an absent value.
  gender Gender @default(NEUTRAL)

  // Denormalized mirror of formatCharacterName(...) above, same posture as
  // zoneId below. It exists because ~60 readers want a single string —
  // orderBy, `select: { name: true }`, the /gm/audit `contains` search, the
  // proxy webhook username and the messageWipe map key — and Prisma cannot
  // concatenate columns in orderBy or contains, so dropping it would force
  // search and sort into OR-over-three-columns for correctness nobody sees.
  //
  // Exactly four writers keep it in sync, and every one of them goes
  // through formatCharacterName:
  //   web/app/(app)/character/createActions.js      (creation)
  //   web/lib/characterWrite.js                     (GM raw edit, dev panel)
  //   web/lib/dynasty.js                            (the Baron renames his house)
  //   web/app/(app)/character/requestActions.js     (a Mulligan Potion, drunk)
  // A fifth writer must do the same; `npm run db:backfill-name-parts` is the
  // drift check that catches one that doesn't.
  //
  // The Bio form is NOT one of them. A name is set once in the creation
  // wizard and is immutable afterwards — web/app/(app)/character/actions.js
  // used to be a writer and now ignores the name keys entirely, which is the
  // lock. The only player-facing change is the Mulligan Potion
  // (docs/tags.yaml), drunk from the tag's own tooltip; that path plans the
  // same Discord fan-out the others do (role title, nickname, dynasty
  // propagation).
  name String

  // Display-only snapshot of the role's name at creation. `roleId` is the
  // authoritative link; roleTitle survives so a GM can hand-write something
  // off-catalog and so history reads correctly if a Role row is later pruned.
  roleTitle String?
  roleId    String?
  role      Role?   @relation(fields: [roleId], references: [id])

  factionId String?
  faction   Faction? @relation(fields: [factionId], references: [id])

  // Applications this character has open, in either direction.
  factionApplications FactionApplication[]

  // AUTHORITATIVE "where is this character" since Bascinet 2. Drives the
  // "Location: {Name}" Discord role (swapped by
  // db/lib/locationMove.js#applyLocationMoveSideEffects) and therefore the
  // one channel they can see. Null only for a character not yet placed.
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  // DENORMALIZED from location.zoneId — every writer of locationId writes
  // both, and db/lib/channelDoctor.js flags a mismatch. Kept because dozens
  // of readers group by zone (the seat tables, factions, #summary, the
  // narrowcast rules). Always a presence zone (SURFACE or CAVE_LEVEL, never
  // the CAVE_GROUP row); rows stamped onto Action/Note/
  // StagedMessage carry the SEAT zone instead (db/lib/seatZone.js).
  zoneId String?
  zone   Zone?   @relation(fields: [zoneId], references: [id])

  // When this character last walked between Locations under their own power
  // — the GameConfig.locationMoveCooldownSeconds clock. Set only by
  // db/lib/locationTravel.js#performLocationMove; a GM teleport or creation
  // leaves it alone so the character can step at once.
  lastLocationMoveAt DateTime?

  // ESCORTING (docs/systemdocs/MAP.md §3a). Who this character is currently
  // following: their party leader walks, and they walk too. One leader, so a
  // column rather than a join table — the column IS the "you can only follow
  // one person" rule, and nothing has to enforce it separately.
  //
  // The whole authority lives in db/lib/escort.js. A stale row is inert
  // rather than dangerous: escortAuthority() returns null the moment the two
  // are not standing in the same Location, so a GM teleport that leaves this
  // set costs one poll of a wrong-looking panel and nothing else.
  escortedById String?
  escortedBy   Character?  @relation("Escort", fields: [escortedById], references: [id])
  escorting    Character[] @relation("Escort")

  // A standing agreement to be escorted, so a consented follower need not be
  // asked again every time they are picked up. Stamped by acceptEscort on the
  // RESPONDER's own row: who they said yes to, and the last turn NUMBER (not
  // a turn id — the window is two turns of arithmetic) that yes still covers.
  // One agreement at a time, which is the right rule: you cannot promise your
  // feet to two people at once.
  escortConsentToId      String?
  escortConsentUntilTurn Int?

  // The conceal toggle (/conceal, or the switch on /character). While on,
  // every message proxies under the concealedAlias with the unknown avatar,
  // and Who's here? lists the alias instead of the name.
  concealed Boolean @default(false)

  // Personal Discord role titled after this character's BARE name (first +
  // last, via formatBareName) and seeded to a muted color by
  // db/lib/roleColor.js#hashNameToColor from that same bare string, re-synced
  // whenever it changes (web/lib/discordGuild.js#ensureCharacterRole). Bare,
  // not the displayed name: the role is an @-mentionable name token rather
  // than an RP surface, and seeding off the bare name means granting or
  // changing a title never renames or recolours anyone.
  // It is assigned to NOBODY and grants nothing — holding it would list the
  // player's account under the character's name. Channel access is a
  // per-member overwrite instead (db/lib/locationAccess.js).
  discordRoleId String? @unique

  isLeader    Boolean         @default(false)
  isTreasurer Boolean         @default(false)
  status      CharacterStatus @default(ALIVE)
  resources   Int             @default(0)

  // When this body went into the ground, set by a BURY_CHARACTER request.
  // Nullable, so the column is both the flag and the record of when. A buried
  // corpse is out of the world: it cannot be looted, dragged or bound, and it
  // stops appearing in the zone's target menus. Cleared on revive, so a
  // GM-revived character is never a live person marked buried.
  buriedAt DateTime?

  // A GM's override of the curse, from the character dev panel. NULL means
  // "work it out" — the normal case, answered by db/lib/curse.js from this
  // character's buriedAt. True or false forces it either way and nothing
  // recomputes over the top.
  //
  // It exists because the curse used to be a Discord role a GM could add or
  // remove by hand in the member list, and moving the truth into the database
  // took that away with nothing to replace it. A player wrongly cursed would
  // otherwise have no remedy but to ask another player to spend 4 ⬢ and a Move
  // engraving them a headstone.
  //
  // Deliberately NOT buriedAt: stamping that to lift a curse would also take
  // the body out of the world, so it could not be looted, dragged or bound
  // (db/lib/presence.js, db/lib/escort.js).
  cursedOverride Boolean?

  // The in-game DAY a FAST_TRAVEL was last claimed on — despite the name,
  // NOT a turn id. A day is TWO turns (Dawn/Dusk), so this stores
  // The load at the last db/lib/carry.js settle — the watermark that tells an
  // ACQUISITION from a capacity SHRINK, which is the whole of what decides
  // whether anything is set down (docs/systemdocs/CARRY.md §5).
  //
  // Only a load that GREW past the ceiling sheds. Unequipping a cart at an inn
  // door, handing one over, or a GM lowering the base cap all leave the load
  // exactly where it was, so they make a character Overburdened and take
  // nothing off them. Without this the settle cannot tell the two apart, and
  // walking into an inn empties your cart onto its floor.
  //
  // The LOAD is stored, never the derived cap, for the same reason the old
  // multiplier watermark stored the multiplier: a cap is a thing the GM moves,
  // and moving it must not read as "you just picked something up".
  carryWeightSeen    Float @default(0)
  carryResourcesSeen Int   @default(0)

  // The free zone crossings this character has already spent, and the turn
  // they were spent in (docs/systemdocs/CARRY.md §2). Everyone gets
  // GameConfig.freeZoneMovesPerTurn a turn; an EQUIPPED mount adds one; being
  // Overburdened takes them all away. Past the allowance a crossing spends the
  // Move instead, exactly as it always did.
  // A push on (docs/systemdocs/MAP.md §3) claims this counter too — and only
  // this one, never zoneMovesBonusUsed below — which is how
  // db/lib/locationTravel.js#exertedThisTurn tells one happened: the base
  // pool reading over the base allowance.
  //
  // Keyed on the TURN, not the day — a mount now carries you in both halves of
  // one day, which is the whole point of the rework. Claimed by a conditional
  // updateMany whose WHERE is the check, the same structural shape the hunger
  // decrement uses: counting a character's Actions afterwards would let two
  // tabs both pass and put the rider two zones away. A differing turn id
  // resets the counter in the same statement, so nothing has to sweep it.
  // Not a foreign key on purpose — it is a claim token, and deleting a turn
  // must never cascade into a character row.
  zoneMovesTurnId String?
  zoneMovesUsed   Int     @default(0)

  // How many of those spent crossings were charged to a BONUS crossing (a
  // mount's, or a boat's on the water) rather than the base allowance. The
  // bonus is always charged first, so losing the bonus later in the turn —
  // a horse parked at an indoors door — can never reach back and take the
  // base crossing the rider still had. Reset by the same differing-turn-id
  // write as the counter above.
  zoneMovesBonusUsed Int @default(0)

  // The movement mood ration (db/lib/mood.js, MOVE_MOOD_TURN_CAP). Same claim-
  // token shape as zoneMovesTurnId above, and not a foreign key for the same
  // reason. Float because what it counts is the magnitude that actually
  // landed, after the multipliers and after GameConfig.moodIntensity — Brave
  // halves a step to 1, so the total is not an integer.
  moveMoodTurnId String?
  moveMoodUsed   Float   @default(0)

  // The in-game DAY this character's bird last flew — the same claim token as
  // fastTravelTurnId above, for the same reason and with the same trap. A day
  // is TWO turns, so this stores String(describeTurn(openTurn).day) and NOT a
  // turn id; keying it on the turn would hand out two letters a day instead of
  // the one the feature promises. Written by a conditional updateMany whose
  // WHERE is the check, so two tabs racing cannot both send. Not a foreign key
  // — it is a claim token, and deleting a turn must never cascade into a
  // character row. See docs/systemdocs/BIRD.md.
  birdTurnId String?

  // How many of that day's flights are spent. The Bird's own allowance is 1,
  // and a Rookery standing where the sender is raises it
  // (Tag.placement.birdSendsPerDay, db/lib/structures.js). Written by the
  // same conditional updateMany that claims birdTurnId, so the WHERE is
  // still the check and two tabs racing cannot both spend the last flight.
  // Reset, not cleared, when the day key moves: there is no sweep, and a
  // stale count against yesterday's key would refuse a flight nobody took.
  birdDaySends Int @default(0)

  // The wall clock between Rookery flights (db/lib/rookery.js). A DateTime
  // column rather than an in-memory Map because a bot restart must not hand
  // somebody a free flight and because the web face — which is where the
  // Bird is actually sent from — cannot see the bot's memory at all. Null
  // for anyone who has never sent one. Only consulted when the allowance is
  // above 1; the ordinary once-a-day bird needs no cooldown, the day is one.
  birdLastSentAt DateTime?

  // The in-game DAY this character last cut Godflesh out of the marsh. Extract
  // used to cost the whole Move and take its "once per turn" from the Action
  // table's @@unique([characterId, turnId]); it costs no Move at all now, so
  // the cooldown had to become its own thing (docs/systemdocs/FACTORY.md §3).
  //
  // Same claim token as birdTurnId just above, and named for what it actually
  // holds rather than inheriting that column's turn-shaped name: a day is TWO
  // turns, so this stores String(turnDay(openTurn)) and not a turn id. Written
  // by a conditional updateMany whose WHERE is the check, so two tabs racing
  // cannot both cut. Not a foreign key — deleting a turn must never cascade
  // into a character row.
  extractDayKey String?

  // The Turn.number `bound` was freshly granted on — not a foreign key, the
  // same reasoning extractDayKey gives: a turn can be deleted with no
  // cascade into a character row. Stamped once, in db/lib/bind.js#applyBind,
  // only when the target wasn't already bound; cleared to null the moment
  // Break Restraints succeeds (db/lib/breakRestraints.js). Read back as
  // `openTurn.number - boundSinceTurnNumber` to know how many turns a Bound
  // character has been struggling, which is what sets the escalating
  // threshold (LESSONS.md §3c). A GM manually stripping `bound` from
  // /gm/dev leaves this stale until the character is bound again — low
  // risk, since the button is hidden the whole time `bound` is absent.
  boundSinceTurnNumber Int?

  // Consecutive turns' worth of hunger this character is carrying — written
  // only by db/lib/hungerPass.js. Each hungry turn increments it; a fed turn
  // (paid or Ate Meal) only sheds ONE tick, not the whole streak, so it takes
  // as many fed turns to climb back down as it took starved turns to climb
  // up. Hungerless resets it to 0 outright (immunity, not eating). It scales
  // the Gambit penalty (db/lib/gambitModifier.js). At 6 the pass grants
  // `dying` and leaves it there — a GM confirms the death by hand, same as
  // every other terminal chain (tagExpiryPass.js).
  hungerStreak Int @default(0)

  // The mood dial, +64 down to −100 (docs/systemdocs/MOOD.md). Nothing shows
  // the number to a player; db/lib/mood.js projects the band it falls in onto
  // one WORD in its own box on the sheet — Happy … Fine … Panicking. Dragged
  // down by the world (wilderness, caves, wounds, hunger, a death nearby),
  // lifted by comfort, and slid back toward Fine at every turn close by
  // db/lib/moodPass.js. Float because GameConfig.moodIntensity divides.
  // Editable on the Dev Panel. Was `fear`, 0–100 with the sign the other way
  // up, until the mood rework.
  mood Float @default(0)

  // Turn number this character last acted or spoke in character — a
  // player-filed Action (never an auto one; defaultMovePass.js does not
  // touch this) or a proxied/`/speak` message. Same shape as
  // PlayerThread.lastActivityTurn and for the same reason: "no activity for
  // N turns" cannot be read reliably out of best-effort, player-erasable
  // records (ArchiveEntry writes swallow failure, and a ❌ reaction deletes
  // the row). Written debounced to one update per character per turn by
  // db/lib/characterActivity.js#touchCharacterActivity. Read by
  // db/lib/catatonicPass.js. Null only before this column's own backfill
  // migration and for a character created after — the pass treats null as
  // "as of right now", never as stale. (The debouncing writer's `not:` guard
  // used to exclude NULL rows — Prisma's `not: N` is SQL `<>`, NULL-false —
  // so this column never got stamped at all for the game's first six turns;
  // characterActivity.js carries the fix and the note.)
  lastActivityTurn Int?

  // Real-clock "online" timestamp — a different grain from lastActivityTurn
  // above on purpose. That one is turn-scoped (one real day) and drives the
  // Catatonic clock; this one is minute-scoped and drives the "online" badge
  // on HereList/GmHereList (db/lib/whosHere.js), which asks "in the last
  // hour," a question a turn number cannot answer. Touched by
  // db/lib/characterActivity.js#touchLastSeen — any authenticated page view
  // (web/app/(app)/layout.js) or a proxied Discord message
  // (bot/src/lib/proxy.js#sendAsCharacter) — debounced to one write per five
  // minutes per character, the same conditional-updateMany idiom
  // touchCharacterActivity uses. Null means "never seen since this column
  // existed," read as offline, never as "just now."
  lastSeenAt DateTime?

  // Turn number this character was flagged `catatonic-afk` — the death
  // countdown's clock, read only by db/lib/catatonicDeathPass.js. Written by
  // db/lib/catatonicPass.js when it grants the tag and by
  // db/lib/playerDeparture.js when the player leaves the guild; nulled when
  // the pass clears the tag and when the death pass kills them. Kept separate
  // from lastActivityTurn so a GM moving GameConfig.catatonicTurns mid-game
  // doesn't retroactively move everybody's execution date. Null while holding
  // the tag means "no countdown" (a GM hand-grant), which fails safe.
  catatonicSinceTurn Int?

  // Set when guildMemberRemove (or the startup reconcile in
  // bot/src/lib/leaveReconcile.js) sees this character's player is gone;
  // cleared by guildMemberAdd on rejoin. Three readers: the catatonic pass
  // never clears the tag off a character carrying this (a departed player's
  // activity clock can't move, and a NULL clock reads as "active now"); the
  // death pass's reason text; and the reconcile's idempotency guard, which is
  // what stops a restart loop re-alerting #leave.
  leftGuildAt DateTime?

  // Unspent point-buy points. Seeded at creation with whatever the player
  // didn't spend in the wizard (budget minus purchases) and drawn down by
  // the mid-game store.
  tagPoints      Int     @default(0)
  avatarData     Bytes?
  avatarMimeType String?

  // The uploaded-avatar review queue (docs/systemdocs/PORTRAITS.md §1a).
  //
  // `avatarSetAt` is stamped by the UPLOAD branch of updateCharacterProfile
  // and by nothing else — not the portrait maker, which cannot produce
  // anything to review, and not `updatedAt`, which every rename and
  // appearance edit bumps and so cannot say "they changed their picture".
  //
  // A picture is waiting when it is an upload and `avatarSetAt` is newer than
  // `avatarReviewedAt` — so a player who uploads again after a GM kept the
  // last one comes back into the queue, which is the behaviour you want and
  // is free. Both nullable: null `avatarReviewedAt` means never looked at.
  // db/lib/avatarReview.js is the only place that spells the comparison out.
  avatarSetAt      DateTime?
  avatarReviewedAt DateTime?

  // The portrait maker's selection as JSON — part indices and palette indices,
  // never pixels. avatarData holds the render; this holds what it was built
  // from, so reopening the modal resumes where the player left off instead of
  // starting from the default face. Null for an uploaded picture or a letter
  // plaque. Validated on every read by
  // web/lib/portrait/catalog.js#parseSelection, so a stale index left behind
  // by a catalog change degrades to the default part rather than throwing.
  portrait      String?
  appearance    String?
  turnPingOptIn Boolean @default(true)

  // Orphan: the "Automatically ride my mount" switch was removed. Nothing
  // reads or writes this any more; kept rather than dropped (CARRY.md §3).
  autoMount Boolean @default(false)

  // unread since 2026-09-15, drop after a week — replaced by
  // discordMirrored below (opt-in Discord now, opt-out then).
  webOnly          Boolean   @default(false)
  webOnlyChangedAt DateTime?

  // "Play on Discord too" (docs/systemdocs/CHAT.md §6). Off by default: a
  // fresh character holds NO Discord game access at all — no Location
  // overwrite, no zone role, no room or conversation thread — so nobody
  // stands anywhere that tells the room which account they are. They read
  // and speak on /play instead, and every re-materialiser (the mover, the
  // doctor, room access, the invite replay, nickname sync) checks this flag
  // first, or the next pass would quietly put them back. The fiction is
  // untouched: they still stand there and still appear in Who's here.
  discordMirrored          Boolean   @default(false)
  // Stamped on every flip, and the DISCORD_MIRROR_COOLDOWN_SECONDS clock in
  // db/lib/discordMirroring.js.
  discordMirroredChangedAt DateTime?

  // 18-90, or null until the player first sets one. Free to edit while null;
  // the moment a number lands it is fixed — the /character input renders
  // disabled and updateCharacterProfile refuses to overwrite a non-null age,
  // the same shape as the GM-granted `title` above. A GM can still change it
  // from /gm/dev/characters/[characterId]. Read by
  // db/lib/concealedIdentity.js for the Young/Old half of a concealed alias.
  age Int?

  // Which secretly GM-assigned antagonist seats this player is open to being
  // handed (Succubus, the Judge...). Consent data only: nothing in
  // the game reads it, grants from it, or gates on it — it exists so a GM
  // picking who receives one can tell who is willing.
  //
  // Set once, on the Antagonists step of the creation wizard, and never
  // player-editable afterwards; updateCharacterProfile not reading the key is
  // the lock, same posture as the GM-granted `title` above.
  //
  // A String[] of slugs validated against db/lib/threats.js rather than a
  // relation: eleven fixed values that can never differ per environment, so a
  // table would only add a join and a way to drift.
  antagonistOptIns String[] @default([])

  // Which private Room threads this character is currently a MEMBER of, as
  // Room ids. Not a source of truth about entitlement — that is always
  // recomputed from tags and RoomGuest rows — but a record of what has actually
  // been pushed to Discord, so db/lib/roomAccess.js can act on the DIFFERENCE
  // instead of re-asserting all 66 private rooms every time.
  //
  // It exists because membership stopped following presence (2026-09-06) and
  // the recompute moved onto the tag-change path, which fires on every equip,
  // meal and transfer. Without this, equipping a hat cost 66 Discord round
  // trips. With it, an unchanged set costs none.
  //
  // Drift is expected and harmless: the channel doctor reads Discord's real
  // member list and is the backstop, exactly as it was before this column.
  roomThreadRoomIds String[] @default([])

  tags                    CharacterTag[]
  actions                 Action[]
  auditLogTargets         AuditLog[]
  notes                   Note[]
  desires                 Desire[]
  stagedMessageRecipients StagedMessageRecipient[]
  deliveries              Delivery[]
  stagedEffects           StagedEffect[]
  cavingRolls             CavingRoll[]
  craftProjects           CraftProject[]
  roomGuestOf             RoomGuest[]
  questInteractions       QuestInteraction[]
  noticePosts             NoticePost[]             @relation("NoticePostAuthor")
  // Every Location this character has stood in or seen from next door.
  locationVisits          LocationVisit[]
  // Every Location still lit for this character this turn (db/lib/vantages.js).
  vantages                Vantage[]

  // BEING HELD (docs/systemdocs/INTERCEPT.md). Somebody laid in wait where
  // this character walked in and stopped them: they cannot MOVE until
  // heldUntil passes, and they can do everything else. Two minutes for a
  // Safe intercept, the turn's own end (db/lib/turnClock.js#turnEndsAt) for
  // an Ambush.
  //
  // A DateTime rather than a flag plus a sweep, the keyed-way pattern
  // (MAP.md §2b): the hold lapses on its own with no cron, no pass and no row
  // to clean up, and one comparison against now() is the whole check.
  // Deliberately NOT an incapacitating tag — those take ACT as well, and a
  // held character is meant to be able to fight back, talk, and file a Gambit
  // of their own (db/lib/incapacitation.js).
  //
  // heldById is who is holding them, so that only that person may let them go
  // early, and so the three writers that end a hold before its time — the
  // holder's own Release, the holder walking off, and the holder dying — know
  // whose holds to clear. Not a cascade: a hold outliving its holder by a few
  // minutes is harmless, and the clears below are what actually end it.
  heldUntil DateTime?
  heldById  String?
  heldBy    Character?  @relation("InterceptHold", fields: [heldById], references: [id])
  holding   Character[] @relation("InterceptHold")

  // WHICH of the two things is holding them — "intercept" or "attack" — so
  // that db/lib/intercept.js#heldReasonFor can name the right one while
  // staying PURE. That predicate is read by the mover's own gate and by every
  // picker that draws a way out, and a query inside it would have to be
  // awaited at eight call sites. A column is the cheaper half of that trade.
  heldReason String?

  interceptWatch   InterceptWatch?
  // Caught by somebody, and the catches they made. Two relations to the same
  // table, so both ends are named.
  interceptHits    InterceptHit[]  @relation("InterceptCaught")
  interceptCatches InterceptHit[]  @relation("InterceptCatcher")

  // Searches asked of them, and searches they asked for
  // (docs/systemdocs/SEARCH.md §4). Same two-ended shape as the catches above.
  searchesOfThem   SearchAttempt[] @relation("SearchTarget")
  searchesTheyMade SearchAttempt[] @relation("SearchSearcher")

  // Fights this character started, and fights started on them
  // (docs/systemdocs/ATTACK.md). Two relations to the same table, so both
  // ends are named.
  attacksMade  Attack[] @relation("AttackMade")
  attacksTaken Attack[] @relation("AttackTaken")

  // Taxes this character filed as a faction officer, and taxes filed against
  // them (the Taxman tag). Two relations to the same table, so both ends are
  // named.
  taxesFiled PendingTax[] @relation("TaxesFiled")
  taxesOwed  PendingTax[] @relation("TaxesOwed")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The one Tag row this character's death wrote. See Tag.corpseOfCharacterId.
  corpseTag Tag? @relation("CharacterCorpseTag")

  @@index([discordUserId])
  @@index([status])
  @@index([status, lastActivityTurn])
  // The one query an escort party ever runs: everyone following this leader.
  @@index([escortedById])
  // The one query a release ever runs: everyone this character is holding.
  @@index([heldById])
}

// Fresh or rotten. A player's corpse is written FRESH and turns ROTTEN three
// turns later (Tag.expiresInto, progressed by db/lib/tagExpiryPass.js on a
// sheet and db/lib/roomTagExpiryPass.js on a floor). The three monster
// corpses in docs/tags.yaml are always FRESH and never rot — a Nekker left
// lying around stays butcherable, and only a person stinks.
enum CorpseKind {
  FRESH
  ROTTEN
}

// What a sheet of paper currently IS. Null on every ordinary tag, and null on
// the blank `paper` catalog tag too — a blank sheet is stackable stock, not a
// document. A row only gets one of these once somebody has written on it.
//
// SEALED is the same row renamed in place, the way a corpse rots
// (db/lib/corpseRotPass.js): a letter somebody is carrying seals in their
// hands with no second row to reconcile. BROKEN_SEAL is a separate row minted
// when the seal is broken — the spent envelope, which is evidence.
enum PaperKind {
  PAPER
  SEALED
  BROKEN_SEAL
  BOOK
}

// Master-sourced from docs/tags.yaml (db/lib/syncTags.js#syncTagsFromYaml,
// npm run db:sync-tags) — same non-destructive upsert-by-slug contract as
// Location/docs/locations.yaml: removing a tag from the YAML never deletes
// its row here.
model Tag {
  id String @id @default(cuid())

  // NOT unique, deliberately. It was, and that is the only reason a written
  // sheet used to be titled "A Note (XY-1234)": every new one needed a name no
  // other tag had, so the code went in the title. Identity is `slug`, which is
  // unique and always was, and every lookup in the game matches on it —
  // Role.startingTagSlugs included, since db:sync-roles resolves the display
  // names docs/roles.yaml authors. /gm/dev/tags still refuses a duplicate name
  // when a GM types one, because two identically named HOMEBREW tags is a
  // confusion worth stopping; two notes both called "A Note" is the point.
  name        String
  slug        String  @unique
  description String?
  category    String
  pointCost   Int     @default(0)

  // Authored by a GM at /gm/dev/tags rather than declared in docs/tags.yaml.
  // syncTags.js is keyed by slug and upsert-only, so it never sees these
  // rows; db:prune-tags, which IS destructive, skips them explicitly. Their
  // slugs are server-generated with a "custom-" prefix so a GM naming one
  // after an existing YAML tag can't collide with it and get upserted over.
  custom Boolean @default(false)

  // --- Corpses (docs/systemdocs/CORPSES.md) ------------------------------
  //
  // A THIRD kind of tag, beside the YAML catalog and a GM's homebrew: one the
  // SYSTEM authors. db/lib/characterDeath.js writes ONE row per death ("Ada's
  // Corpse"), and the three monster corpses come from docs/tags.yaml instead.
  // Both kinds set corpseKind, so "is this a corpse?" is one field however the
  // row got here — which is what the Butcher button and Miasma's ingredient
  // check both ask.
  //
  // Rotting RENAMES that one row rather than chaining into a second tag
  // (db/lib/corpseRotPass.js). expiresInto could not do it: it names catalog
  // SLUGS, and "Ada's Rotten Corpse" is per-character and never in the YAML.
  // Renaming also means a corpse someone is carrying rots in their hands with
  // no second row to reconcile — the holding is the same row it always was.
  //
  // Reusing `custom` for this was the obvious shortcut and it does not work:
  // TAGS.md §5d deliberately refuses to let a GM hand-author a decay chain,
  // and `custom` says "a GM typed this", which is exactly what a corpse is not.
  corpseKind CorpseKind?

  // The body this tag IS — the whole point of the design. A corpse is a HANDLE
  // to a dead sheet, not a container: the goods stay on the Character row and
  // LOOT_CHARACTER is untouched, but db/lib/corpseFollow.js joins through this
  // to walk the dead sheet after its corpse, so looting works wherever the
  // body was carried to. Null on the three monster corpses.
  //
  // Unique because there is exactly one corpse per death, which makes the
  // death path an upsert and the revive path a delete-by-character.
  //
  // Cascade, and it is load-bearing: it is the ONLY thing that stops these
  // rows outliving a Restart Game. wipeGameData deliberately never touches the
  // catalog, and its existing order already clears CharacterTag and RoomTag
  // before character.deleteMany() — so the cascade lands clean with no edit to
  // the wipe at all. A GM deleting one character gets the same for free.
  corpseOfCharacterId String?    @unique
  corpseOf            Character? @relation("CharacterCorpseTag", fields: [corpseOfCharacterId], references: [id], onDelete: Cascade)

  // A photograph's subject (db/lib/photoMint.js): the character the camera
  // was pointed at, so a rite that needs "a photograph of the target" can
  // resolve one without parsing the name off the print. A snapshot id, no
  // FK — the print outlives the person. Null on prints from before this
  // column existed, which fall back to the name.
  photoOfCharacterId String?

  // Whether other players who 🔍-react to this character's proxied messages
  // see this tag, alongside Character.appearance (see
  // bot/src/events/messageReactionAdd.js). Three states, authored in
  // docs/tags.yaml as `visible: true | false | worn | named` — WORN means the
  // tag is shown only while CharacterTag.equipped, so a stowed dagger stays
  // hidden and a drawn one doesn't, and NAMED only while the subject is going
  // under their own name. Defaults closed so identity/status tags (Mortus,
  // Drained, ...) stay hidden unless explicitly opened up.
  //
  // This replaced a `visibleOnInspect Boolean`, and the RENAME was the point:
  // a tri-state kept under the old name would have been truthy for WORN, so
  // every surviving `if (tag.visibleOnInspect)` would have leaked every stowed
  // weapon on the day of the migration. Under a new name a missed read site
  // gets `undefined` instead, and the tag stays hidden — a vision gate should
  // fail closed. Read it through seenByBystander() (db/lib/medicalVision.js)
  // rather than comparing the enum by hand.
  inspectVisibility TagVisibility @default(HIDDEN)

  // Mutually exclusive with every other tag carrying this flag IN THE SAME
  // GROUP: a character may hold at most one of them per group. Set on the
  // Beliefs (Post-Christian, Atheist, Existentialist, Fundamentalist, the
  // four Old Ways), which are meant to be a single answer rather than a
  // collection. The one exception is
  // a pair joined by requiredTag — Fundamentalist requires Post-Christian and
  // so stacks on it. Enforced by exclusiveConflict()
  // (web/lib/characterCreation.js), called from PointBuy, createCharacter,
  // the store's buyTags and the Add Tag request. A GM grant ignores it,
  // deliberately, like every other gate.
  exclusive Boolean @default(false)

  // Optional grouping within a category (e.g. Status -> Health/Food/Buffs/
  // Debuffs), purely for display coloring (see TagGroup.color / TagChip.js)
  // — groupless tags render with no color accent.
  groupId String?
  group   TagGroup? @relation(fields: [groupId], references: [id])

  // For sequential/tiered skill tags (Cooking (Basic) -> Cooking (Skilled)):
  // the tier this one upgrades from. Buying/granting a tag with a parent
  // replaces the parent on the character rather than stacking with it.
  parentTagId String?
  parentTag   Tag?    @relation("TagUpgrade", fields: [parentTagId], references: [id])
  upgrades    Tag[]   @relation("TagUpgrade")

  // Non-replacing prerequisite, distinct from the parentTag chain above: a
  // character must already hold requiredTag before this one is meant to be
  // obtainable, but acquiring this one does NOT remove/replace requiredTag
  // (e.g. Fighting (Archer) requires Fighting (Basic) but coexists with
  // Fighting (Skilled)). Also the mechanism behind whole-group gating — see
  // TagGroup.requiredTag — for hiding an entire group behind a membership
  // tag. Both are enforced by requirementSatisfied()
  // (web/lib/characterCreation.js): the point-buy menu, the Add Tag picker,
  // and the createCharacter/addTagRequest server actions that re-check them.
  // A GM grant still ignores both, deliberately.
  requiredTagId String?
  requiredTag   Tag?    @relation("TagPrerequisite", fields: [requiredTagId], references: [id])
  unlocks       Tag[]   @relation("TagPrerequisite")

  // Live: whether this tag can change hands at all. It gates BOTH directions —
  // handing it to someone in your zone (TRANSFER_TAG) and lifting it off a
  // corpse or a helpless body (LOOT_CHARACTER) — via
  // web/lib/tagRequests.js#isTradeable, which every one of those menus filters
  // on and both server actions re-check. This used to be a category test
  // (Items + Assets), which was wrong in both directions: it let a corpse be
  // stripped of its House and its Drone, and it ignored the graft in somebody's
  // neck that already said false right here. One flag on purpose; splitting
  // give from take would be a second field. See docs/systemdocs/TAGS.md §5.
  //
  // db/lib/syncTags.js THROWS if an items/assets tag omits it, so the `false`
  // default below can never silently make new gear unmovable.
  tradeable Boolean @default(false)

  // What one UNIT of this tag weighs, in pounds — the load half of
  // docs/systemdocs/CARRY.md §1, against GameConfig.carryWeightLbs. Null means
  // weightless: every skill, status, injury and belief, plus the Assets, which
  // carry themselves (a horse) or do not move at all (a house).
  //
  // Price it off the band table in CARRY.md §1a, never by feel — the same
  // discipline the point scale gets in TAGS.md §4a.
  weightLbs Float?

  // What this tag adds to BOTH carry caps, as a signed distance from ×1: Cart
  // +4, Giant +0.75, Frail −0.1. Counted only while the row is EQUIPPED
  // (CharacterTag.equipped) — a cart you are not pulling hauls nothing. A body
  // trait like Pack Mule or Frail is not equippable at all, so it always
  // counts. ADDITIVE across held rows, floored at ×0.25; see db/lib/carry.js.
  carryBonus Float?

  // How many of the four hand slots this tag takes away — a maiming, and only
  // a maiming (docs/systemdocs/TAGS.md, "equipSlot / equipLayer / twoHanded").
  // A whole arm is 2, a hand that no longer grips properly is 1.
  //
  // Counted while HELD, never while equipped: nobody wears a missing arm.
  // That is the opposite of carryBonus above and the reason this is its own
  // column rather than a negative carryBonus — the two caps are moved by
  // different kinds of thing, under different conditions.
  //
  // The TOTAL loss is capped so a character never falls below two hand slots,
  // whatever they have lost. See HANDS_FLOOR in db/lib/equipSlots.js: a
  // character who could hold nothing at all is a dead end rather than a
  // drawback, and the game has nowhere to put them.
  handsLost Int?

  // How much this piece of gear turns a blow aside, 0.0 to 1.0. Two numbers
  // because the two things that hit you in Ravenheart are nothing alike: a
  // breastplate is excellent against a sword and paper against a rifle, and the
  // catalog's own line about Light Infantry Armour ("nothing forged in
  // Ravenheart stops a bullet") only means something once those can differ.
  //
  // Counted only while EQUIPPED, and combined across pieces with diminishing
  // returns rather than added — see db/lib/armorValue.js, which owns both the
  // combination and the word scale.
  //
  // NEVER shown to a player as the number. Armour reads as a word — None,
  // Meager, Sufficient, Good, Strong, Overkill — the same posture Laboring
  // yields take (db/lib/laborYield.js#qualityWord): working out that Strong
  // beats Good is the player's job, and a decimal on a chip would turn kit
  // choice into arithmetic.
  //
  // meleeArmor is authored and displayed but nothing reads it mechanically yet.
  // There is no melee resolver in the codebase — melee is GM-adjudicated or a
  // Gambit outcome — so the number is here so the catalog is complete and
  // consistent on the day one lands. ballisticArmor is live: it is what the
  // turrets roll against.
  meleeArmor     Float?
  ballisticArmor Float?

  // Whether this tag is a thing a character can wear or carry readied, and so
  // occupies its equipSlot. Equipped state lives on CharacterTag.equipped;
  // equipping is instant and writes no Request.
  equippable Boolean @default(false)

  // Marks gear that hides who the wearer is — a mask, hood or closed helm.
  // This is the gate on /conceal: without one of these EQUIPPED, a character
  // cannot go unnamed at all. Only meaningful together with equippable, and
  // db/lib/syncTags.js throws if it is set without it, since a mask nobody can
  // equip could never conceal anything. See docs/systemdocs/TAGS.md.
  concealsIdentity Boolean @default(false)

  // Concealment with no say in it — a sack tied over the head, a plague mask
  // whose whole point is that the wearer is nobody. While one of these is
  // equipped the character is concealed whatever Character.concealed says, and
  // both /conceal toggles refuse to turn it off. Requires concealsIdentity;
  // syncTags.js throws otherwise, since forcing a concealment the catalog does
  // not grant is a contradiction rather than a stricter setting.
  forcesConceal Boolean @default(false)

  // Which plated 256px avatar a concealed wearer shows, as a basename under
  // web/public/assets/helms (built by web/scripts/generate-helms.js). Required
  // alongside concealsIdentity — a hood nobody can see is not concealment,
  // it is a missing image — and syncTags.js checks the file is really there,
  // because a typo here would otherwise surface as a broken avatar in Discord
  // rather than as a failed sync.
  concealSprite String?

  // Where this sits on the body, and how deep. Two equipped tags may not share
  // a layer within HEAD/BODY/MOUNT: layer 1 is against the skin and 3 is
  // outermost, so a mail coif (1) goes under a knight's helm (2) but two helms
  // do not go together. The OUTERMOST equipped concealing piece is the one
  // whose concealSprite the room sees. Enforced in both places that flip
  // CharacterTag.equipped — equipActions.js and db/lib/tagOps.js.
  equipSlot  EquipSlot?
  equipLayer Int?

  // A WEAPON that fills two of the three hands (db/lib/equipSlots.js). Only
  // meaningful on equipSlot WEAPON; syncTags.js throws anywhere else.
  twoHanded Boolean @default(false)

  // The opposite of hiding: a tag that FIXES how the character presents. While
  // any held tag carries this, the character posts under this name with the
  // letter plaque for its initial (never their own face), Who's here? and 🔍
  // name them this way, and both /conceal toggles refuse. Apex Form sets it to
  // "Beast". Nothing on the Character row changes — every surface resolves it
  // at read time through db/lib/presentedIdentity.js (forced > concealed >
  // own name), the same posture as the letter plaque itself. The @-mention
  // role and the nickname deliberately keep the real bare name. Authored in
  // docs/tags.yaml as `forcesName:`; syncTags.js caps it at
  // NAME_LIMITS.firstName and refuses it beside concealsIdentity.
  forcedName String?

  // Whether a character can hold more than one of this tag at a time —
  // meals, ammunition, anything a crafting Move produces in a batch. A
  // stack is ONE CharacterTag row carrying a count (CharacterTag.quantity),
  // never N rows: @@unique([characterId, tagId]) stays, so every presence
  // check in the codebase (narrowcastAccess, gambitModifier, labor)
  // keeps reading "holds it or doesn't" unchanged. Safe to combine with
  // defaultDurationTurns: the expiry sweep sheds one unit per expiry and
  // rerolls the remaining stack's timer, rather than deleting the row.
  stackable Boolean @default(false)

  // Whether a player could ever buy this via point-buy, and (only meaningful
  // when true) whether it stays buyable once the game is underway vs. being
  // a starting-package-only pick. No purchase flow exists yet — catalog data
  // only, for a future store to read.
  purchasable           Boolean @default(false)
  purchasableAfterStart Boolean @default(true)

  // A MASTERY tag: the third state the two flags above could not express.
  // `purchasable` says "buyable at all" and `purchasableAfterStart` says "still
  // buyable mid-game"; there was no way to say "buyable ONLY once play has
  // started". This is that — a capstone bought with points earned in play
  // rather than out of a starting budget, which is why it is also the one
  // deliberate exception to the 14-point ceiling (TAGS.md 4a). The web draws a
  // star beside the name of one. Implies purchasableAfterStart: a mastery tag
  // that left the store would be buyable nowhere, and db/lib/syncTags.js
  // throws on that pairing rather than letting it go quiet.
  mastery Boolean @default(false)

  // Tag Catalog tier (see the CatalogVisibility enum above). Defaults GM,
  // not ALL, so a row the sync never touches — a GM-authored tag, a minted
  // headstone — can never land fully public by omission.
  catalogVisibility CatalogVisibility @default(GM)

  // Role slugs (docs/roles.yaml) that may NOT buy this tag, authored in
  // docs/tags.yaml as `excludedRoles:`. Devoted Follower is the first user:
  // a Migrant or a Bum has no faction to be devoted to. Plain slugs rather
  // than a Role relation on purpose — db:sync-roles rewrites Role rows and a
  // relation would need re-linking every time, while the slug is the stable
  // key the rest of the codebase already matches roles on (CURSED_ROLE_SLUGS).
  // Empty is the overwhelmingly common case: a tag open to every seat.
  //
  // Enforced by roleExcluded() (web/lib/characterCreation.js) — the point-buy
  // menu drops the row, and createCharacter/the store's buyTags re-check it.
  // A GM grant ignores it, like every other gate here.
  excludedRoleSlugs String[] @default([])

  // The other direction: role slugs that are the ONLY seats which may buy this
  // tag, authored in docs/tags.yaml as `onlyRoles:`. Vow of Silence is the
  // first user — a Minstrel who will not sing is a character, anybody else
  // choosing it is just a free tag. Empty means "open to every seat", which is
  // the overwhelmingly common case, so the default is the permissive one.
  //
  // A whitelist rather than listing the other 38 seats in excludedRoleSlugs:
  // that spelling would silently open the tag every time a new role is added
  // to docs/roles.yaml. Same plain-slug reasoning as above.
  //
  // Read by the same roleExcluded() (web/lib/characterCreation.js), so the
  // menu, createCharacter and the store's buyTags all inherit it at once. A GM
  // grant ignores it, like every other gate here.
  onlyRoleSlugs String[] @default([])

  // The other side of purchasable: whether the Merchant's Depot will buy
  // this off him, and for how many ⬢. Live as of the Merchant Update — read
  // by the Sell counter on /depot (DEPOT_SELL). syncTags.js requires the two
  // fields to travel together: sellable without a positive sellablePrice is
  // an error, and so is a price without sellable: true.
  sellable      Boolean @default(false)
  sellablePrice Int?

  // The buy side of the same counter: what the Depot CHARGES the Merchant for
  // one of these, read by DEPOT_BUY. Null means the station does not stock it
  // at all, which is the case for everything Ravenheart makes itself — the
  // Depot only imports. A ware is Depot-stocked purely by having this, so it
  // travels with nothing else; syncTags.js only checks it is positive, and
  // warns (without throwing) if it is at or under the tag's own sellablePrice,
  // since buying and selling the same tag in a loop would print ⬢.
  // See docs/systemdocs/DEPOT.md §3.
  depotPrice Int?

  // Whether a shipment of this arrives SEALED. A sealed crate prints no
  // manifest and only a Depot Keycard opens it, so this is how a dangerous or
  // valuable ware stays unreadable on the landing pad until the right person
  // gets to it. Authored in docs/tags.yaml rather than guessed from the
  // category, because "dangerous" is a judgement about the fiction and the
  // catalog is where those live. One sealed line item seals the whole crate it
  // lands in. See docs/systemdocs/DEPOT.md §5.
  sealedShipping Boolean @default(false)

  // What falls out of a crate when it is opened, as
  // `[{ tagId, name, quantity }]`. Set only on the runtime crate tags
  // db/lib/depotCrates.js mints, and null on every catalog row.
  //
  // It lives on the crate rather than on the shipment so a crate is entirely
  // self-describing: it can be carried out of the landing pad, traded away and
  // opened in a cellar three zones over without anything needing to look up
  // where it came from. See docs/systemdocs/DEPOT.md §5.
  crateContents Json?

  // --- Paperwork (docs/systemdocs/PAPERWORK.md) --------------------------
  //
  // A written sheet is a Tag row minted at runtime, the same shape as a crate
  // or a corpse. What makes it different from every other tag in the catalog
  // is that its text is PRIVATE: whether you can read it depends on your eyes
  // and your letters, so the sentence a reader sees cannot be baked into
  // `description` the way every other tag's is.
  //
  // That matters more than it sounds. web/lib/referenceData.js#getVisibleTags
  // ships the WHOLE catalog, descriptions included, to every signed-in
  // browser. A letter's text in `description` would publish every letter in
  // the game. So it lives here instead, TAG_CHIP_FIELDS never selects it, and
  // the description is composed per request, per viewer, by
  // db/lib/paper.js#paperDescription.
  paperKind PaperKind?

  // The sheet's contents. APPEND-ONLY — the Write dialog shows what is already
  // there read-only and adds beneath it. You can always write more; you can
  // never unwrite.
  paperText String?

  // Who wrote on it first, by presented name, for the generated title ("A Note
  // (hand of Ada)"). Kept as a snapshot rather than a relation: the row has to
  // outlive its author, and a dead writer's letter still names them.
  paperAuthor String?

  // What the writer chose to call it, kept apart from `name` because `name` is
  // COMPOSED and recomposed as the sheet moves through its states: sealing
  // rewrites it to lead with the title and trail the wax, breaking the seal
  // puts the bare title back. Holding the title in `name` alone meant sealing
  // destroyed it, so a courier with two sealed letters could not tell them
  // apart without opening one — which is permanent.
  //
  // Null means the writer advertised nothing, which stays the default: a sheet
  // with no title seals to "Sealed Letter (<wax>)" exactly as it always did.
  // Set once, on the first write, or by the sealer if the sheet reached them
  // untitled — a second hand may not rename what a first hand called it.
  //
  // PUBLIC, unlike paperText. It travels everywhere Tag.name travels (Transfer,
  // Loot, a room's Storage readout, the bot's inspect embed), none of which
  // knows anything about literacy. That is the bargain a title makes and the
  // reason it is optional.
  paperTitle String?

  // A wax stamp's distinguishing line — "Three cups, stacked." Authored in
  // docs/tags.yaml as `sealMark:`, which is also what makes the stamp a stamp:
  // db/lib/syncTags.js composes the whole description around it, so the
  // boilerplate is written once and {sealMark} has one clean source.
  //
  // Copied onto a letter this stamp seals, and onto the envelope left behind
  // when that seal is broken. The Merchant's is the one exception — null in
  // the YAML, written at character creation beside setMerchantFace, because it
  // bears his actual initials (web/app/(app)/character/createActions.js).
  sealMark String?

  // Minted at runtime rather than authored, and therefore GAME state rather
  // than catalog: crates, headstones, written paper, sealed letters. A Restart
  // Game deletes exactly these rows and leaves the docs/tags.yaml catalog and
  // a GM's homebrew from /gm/dev/tags alone.
  //
  // This closes a real leak. wipeGameData never touched the Tag catalog, and
  // db:prune-tags skips every `custom` row on purpose — so crates and
  // headstones were permanent orphan rows accumulating across every game. Only
  // corpses escaped, and only through corpseOfCharacterId's cascade. `custom`
  // could not be reused for this: a GM's homebrew is custom and must SURVIVE a
  // restart, which is the opposite of what this asks.
  ephemeral Boolean @default(false)

  // Catalog-level default duration in turns, for tags that auto-expire once
  // granted (mirrors CharacterTag.expiresTurn's "absolute turn number, swept
  // by resolveNeeds()" convention). E.g. Drained sets this to 3, so donating
  // blood expires 3 turns after it's granted.
  defaultDurationTurns Int?

  // Whether a player can use this tag up — eat the meal, unpack the crate.
  // Live, like removable/craftable above: it drives the Consume menu on
  // /character (web/lib/tagRequests.js) and is re-checked server-side by
  // consumeTagRequest, since the client's filtered menu is only advisory.
  // See docs/systemdocs/REQUESTS.md. Consuming always takes exactly ONE
  // unit, so a stack of meals feeds the character several times.
  consumable Boolean @default(false)

  // Tag slugs this tag turns INTO when it is consumed: a meal becoming Ate
  // Meal, Starting Wares unpacking into a revolver and jewelry. Slugs rather
  // than a relation specifically so a slug may REPEAT — listing one twice
  // grants two of it (for a stackable tag; a non-stackable repeat collapses
  // to one). A granted tag with its own defaultDurationTurns starts that
  // clock at the moment it's granted, so chains work (meal -> Ate Meal that
  // the sweep then clears). Empty means consuming just uses the tag up.
  consumesInto String[]

  // The Resources half of consuming, added for the Caves Update's Purse and
  // Supply Kit — a Purse has no tag half at all (consumesInto: []), while a
  // Supply Kit combines both. Null means consuming grants no Resources.
  // Applied by the same consumeTagRequest that reads consumesInto, through
  // the ordinary creditResources primitive (web/lib/tagEffects.js), and
  // snapshotted into Request.effect so CONSUME_TAG's undo can debit it back
  // without re-deriving from live state. See docs/systemdocs/CAVING.md.
  consumesIntoResources Int?

  // Parallel array to consumesInto, same length and order — added for the
  // Caves Update's Skinned Cave Rat (a 50/50 pick between Ate Meal and
  // Vomiting). Each entry is either null (that position grants exactly the
  // slug consumesInto holds there) or a list of two-or-more alternative
  // slugs to pick between with even odds; when it is a list, the
  // corresponding consumesInto[i] holds the first alternative only as a
  // display fallback — web/lib/consumeGrants.js reads this field first and
  // rolls the real pick, the same { oneOf: [...] } shape expiresInto already
  // uses for db/lib/tagExpiryPass.js. Null (the column, not an entry) is by
  // far the common case — almost nothing needs a random consume outcome.
  consumesIntoOneOf Json?

  // Per-target conditions on the list above, as { "<target slug>": ["<blocking
  // slug>", ...] } — the target is granted only if the character holds NONE of
  // its blocking tags. Null when a tag's grants are all unconditional, which is
  // almost all of them. consumesInto still carries every target slug in order,
  // so validation and the "Becomes:" previews keep reading one field.
  //
  // Nothing in the catalog sets this today — Fine Meal was the only user, via
  // { "happy": ["nobility"] }, and it went with the Mood system. The field and
  // its resolver stay because the mechanism is general: it is resolved by
  // web/lib/consumeGrants.js, which both the server action and the client
  // previews call so a preview can't promise something the grant won't
  // deliver.
  consumesIntoUnless Json?

  // Per-target expiry overrides on the same list, as { "<target slug>": N } —
  // the granted tag's clock is set to N turns instead of its own
  // defaultDurationTurns. Null when nothing overrides, which is almost every
  // tag.
  //
  // This exists because one status can mean different things depending on
  // what produced it: raw Cave Fungus leaves you High for 2 turns, while
  // Bliss — the refined version — leaves you High for 3. Encoding that on the
  // High tag itself is impossible (it has one defaultDurationTurns), and
  // splitting it into high-2/high-3 would push an implementation detail into
  // the player-facing catalog and multiply with every future drink.
  //
  // Read by web/lib/consumeGrants.js alongside consumesIntoUnless and applied
  // by grantTagSlugs, which prefers the override and falls back to the target
  // tag's own defaultDurationTurns. An override on a target that has no
  // duration of its own is legal and simply gives it one for this grant — but
  // don't point one at Ate Meal, which is deliberately never swept because the
  // Hunger pass consumes it explicitly.
  consumesIntoDurations Json?

  // What this tag turns INTO when its timer runs out, rather than simply
  // being swept away: the untreated-condition chain (Infected -> Festering ->
  // Feverish + Necrosis -> ...). Distinct from consumesInto above, which is
  // player-driven and chosen; this one fires on the clock whether or not
  // anybody wanted it to, which is the entire point of a wound that gets
  // worse while you ignore it.
  //
  // A JSON array whose entries are either a bare slug string, or
  // { "oneOf": ["<slug>", "<slug>"] } for an even random pick between them
  // (Necrosis costing you a leg or an arm). Json rather than String[] only
  // because of that second form. Null means the tag just expires.
  //
  // Applied by db/lib/tagExpiryPass.js, which runs inside resolveNeeds()
  // immediately BEFORE the sweep that deletes the expired row — it has to
  // read the row before the delete removes it. Validated up front by
  // db/lib/syncTags.js: every slug must exist, the tag must carry a
  // defaultDurationTurns (or nothing would ever fire it), and a tag may not
  // list itself (the grant would be undone by the sweep one statement later).
  expiresInto Json?

  // What this tag turns INTO when it leaves the sheet through a PLAYER-DRIVEN
  // removal — the Remove Tag request and the Heal request, both of which grant
  // it inside their own transaction. This is the treated-wound aftermath: a
  // Broken Bone cured is a Splinted limb for four turns, so medicine ends the
  // danger without erasing the injury. Distinct from expiresInto (the clock)
  // and consumesInto (using a tag up); a GM removal (/heal, the Dev Panel
  // revoke) stays godmode and never fires it.
  //
  // Same Json shape as expiresInto — entries normalized to { oneOf: [...] } —
  // and validated by the same db/lib/tagShapes.js pair on both authoring
  // doors. No durationTurns requirement: the removal fires it, not a clock.
  // The granted tag's own defaultDurationTurns (or permanence) decides how
  // long the aftermath lingers. A successor the character already holds is
  // left alone, matching the expiry pass.
  removesInto Json?

  // --- The medical pass: item cures (docs/systemdocs/TAGS.md §5c) --------
  //
  // The health-tag slugs this CONSUMABLE cures — explicit catalog slugs, no
  // rung selector. Every slug must exist and be category Health; the carrier
  // must itself be `consumable`. Deliberately NOT validated against
  // `healable` — Forgiveness cures the untreatable Shell Shocked, which is
  // the whole point: medicine can do what no medic can. Validated by
  // db/lib/tagShapes.js on both authoring doors (docs/tags.yaml's sync and
  // the GM tag form), applied by `consumeTagRequestImpl`
  // (web/app/(app)/character/requestActions.js), which fires `removesInto`
  // (or the `curesInto` override right below) and half fear relief per
  // cured tag — the same aftermath a Heal leaves.
  cures Json?

  // Per-item aftermath override for a cured slug: `{ <cured-slug>:
  // <aftermath-slug> }`. What a cure leaves behind can depend on the ITEM
  // rather than the wound alone — a crafted peg-leg cures Missing Leg into
  // Peg Leg, while a cybernetic leg leaves nothing at all. Keys must be a
  // subset of this tag's own `cures`; values are any catalog slug. A cured
  // slug with no entry here falls back to its own `removesInto`, same as an
  // ordinary Heal.
  curesInto Json?

  // An item may be administered to someone else even with no `cures`
  // intersection at all — Mercy grants increased-recovery, which stabilizes
  // rather than curing anything on a list. "May this be applied to someone
  // else?" is `cures` non-empty OR this flag; see consumeTagRequestImpl.
  administerable Boolean @default(false)

  // The skill required to APPLY this item to anyone — the actor's own self
  // included (fitting a prosthetic needs medical-expert even on your own
  // leg). A catalog slug, the same single-slug convention `escalatesInto`
  // uses rather than a relation; null means anyone may administer it. This
  // gates EVERY consume of the item, self or targeted — a different question
  // from ACT, which self-consume stays exempt from (TAGS.md §5f) and this
  // never is.
  administerSkill String?

  // Plain slugs to strip off the CONSUMER when this item is consumed —
  // deliberately not `cures`: no category-Health restriction, no removesInto
  // aftermath, no fear relief, no relation to the medical pass at all. For a
  // consumable whose whole point is undoing an unrelated, non-Health tag
  // (Coffee clearing Tired/Exhausted, Bar Soap clearing Unhygienic) rather
  // than treating a wound. Validated only for "the slug exists" — see
  // db/lib/tagShapes.js. Applied in the ordinary consume path
  // (web/app/(app)/character/requestActions.js), a plain drop on the
  // consumer, never routed through web/lib/consumeGrants.js (kept pure/
  // Prisma-free for previews).
  removesOnConsume Json?

  // Whether this tag is a POISON that can be dosed into a held food/drink
  // stack. Schema only for now — the Poison action that reads it is a later
  // milestone of the medical pass.
  poison Boolean @default(false)

  // Slugs whose consume/poison-path grant this trait shrugs off — Iron
  // Constitution's eventual `resists: [poisoned, ...]`. Meant to live on the
  // consume/poison path only, never in `grantTagSlugs` itself, so a GM's
  // `/heal` grant is never filtered by it. Schema only for now.
  resists Json?

  // The drinking ladder (docs/systemdocs/BREWING.md). A STATUS tag names the
  // rung above it, so consuming something that grants a rung you already hold
  // moves you up instead of doing nothing: tipsy -> wasted -> unconscious.
  //
  // Deliberately a single slug and not the Json { oneOf } shape expiresInto
  // and removesInto use — a ladder has one next rung, and letting it branch
  // randomly would make "one more drink" unpredictable in a way no player
  // could plan around.
  //
  // Only the CONSUME path walks it (web/lib/consumeGrants.js). A GM handing
  // somebody Tipsy twice from the Dev Panel is not pouring them a drink, and
  // db/lib/tagWrites.js#grantTagSlugs stays deliberately ignorant of this.
  escalatesInto String?

  // The four capability flags. Each one fills exactly one player menu and is
  // re-checked server-side by the matching request (docs/systemdocs/TAGS.md
  // §5). Three are explicit in docs/tags.yaml; `removable` is the one the
  // sync derives.
  //
  // removable: the Destroy menu (web/lib/tagRequests.js#destroyableTags,
  // REMOVE_TAG). DERIVED by db/lib/syncTags.js from the category — Destroy is
  // for things you own, so every Items and Assets tag has it and nothing else
  // does, less a short opt-out list the YAML writes as `removable: false`.
  // Runtime-minted rows (paperMint, corpseMint, the packed crate) set it by
  // hand, since no sync ever sees them. Destroying refunds nothing.
  removable Boolean @default(false)

  // craftable: the Craft menu (docs/systemdocs/CRAFTING.md). A recipe also
  // needs its requirementSkills held; turns and ⬢ come from the requirement
  // block below.
  craftable Boolean @default(false)

  // healable: the Heal menu (HEAL_CHARACTER). A cure exists — its cost is the
  // requirement block below, and the medic must hold requirementSkills.
  healable Boolean @default(false)

  // teachable: Learn / Teach can move it between characters
  // (docs/systemdocs/LESSONS.md).
  teachable Boolean @default(false)

  // Not a capability flag — a classification. True on the drawbacks a
  // Chaplain can lift in Confession (docs/systemdocs/CONFESSION.md): the
  // addictions and the compulsions, never a sensory affliction. It fills the
  // penitent's Confess dropdown and nothing else. `health-mind` could not
  // stand in for it — half that group is blindness and muteness.
  psychological Boolean @default(false)

  // What it costs a character to gain or shed this tag through play (e.g.
  // curing Arthritis needs Medical (Skilled), some turns, and resources;
  // forging a sword tag costs turns, resources, Smithing, no Gambit). One
  // shared set of fields covers whichever direction is narratively relevant
  // for a given tag (crafting only cares about adding it; healing only cares
  // about removing it) rather than separate add/remove blocks.
  //
  // Enforced in both directions now. Heal (HEAL_CHARACTER) charges
  // requirementResources and needs requirementSkills held by the medic;
  // Craft (docs/systemdocs/CRAFTING.md) needs requirementSkills held by the
  // crafter, charges requirementResources up front, and spends
  // requirementTurns Moves of work per unit (0 = Dead Simple, no Move; the
  // YAML's fractional `turnsCost: 1/N` stores as 1 here with N in
  // requirementPerTurn below). requirementGambit is a cure-only flag:
  // crafting is always a Routine.
  requirementTurns     Int?
  requirementResources Int?
  requirementGambit    Boolean @default(false)

  // Two authoring concepts share this column, told apart by requirementTurns
  // (CRAFTING.md §2). At 0 turns it is a RATION — the YAML's `perTurn:`, a
  // hard daily cap below the Dead Simple pool; null falls back to
  // DEAD_SIMPLE_PER_TURN (web/lib/tagRequests.js). At 1 turn it is the WORK
  // DENOMINATOR the sync derives from `turnsCost: 1/N` — each unit is 1/N
  // of a turn's work (web/lib/craftBudget.js), and null means a whole turn:
  // one per Routine by arithmetic. Never authored directly on a Move-costing
  // recipe (normalizeTurnsCost refuses it). A project (2+ turns) makes one
  // unit, full stop.
  requirementPerTurn Int?
  requirementSkills  Tag[] @relation("TagRequirementSkill")
  requiredForSkillOf Tag[] @relation("TagRequirementSkill")

  // This recipe may be crafted as a CUSTOM item: +1 ⬢ a unit, and the player
  // names and/or describes it. The craft then mints a runtime Tag row —
  // custom+ephemeral, the paperMint.js door — cloning this tag's mechanics
  // with the player's words on top, and grants that row instead. YAML
  // `customizable: true` on the designated recipes only; the sync refuses it
  // on anything not craftable+stackable, or carrying `placement`
  // (db/lib/tagShapes.js). See CRAFTING.md.
  customizable Boolean @default(false)

  // WHO may open that door. A tag slug the character has to hold before the
  // name/description fields are offered at all — `smithing-skilled` on the
  // arms and armour, so signing your work is a skilled smith's privilege and
  // not something an apprentice does to a cudgel. Null means anyone who can
  // make the thing may customize it, which is the meals, the painting, the
  // sketch, the badge and the hat. YAML `customizableSkill:`; the sync
  // refuses one that names no real tag, or one without `customizable`
  // (db/lib/tagShapes.js). Deliberately NOT derived from the recipe's own
  // skills: a padded cap is `crafting` work and still wants the smith's
  // rung, and the hat is `crafting` work that must stay open to everyone.
  customizableSkillSlug String?

  // What this row is a COPY of, on a mint from the door above — the base
  // recipe's slug. A mint gets a fresh `custom-craft-*` slug, so every rule
  // that reads a held tag's slug back (db/lib/godflesh.js's cutting tools and
  // body armour, db/lib/torture.js's bonuses) would stop seeing it: a custom
  // Breastplate would protect nobody at the Spillway. Those rules resolve
  // through this instead. Null on every catalog row and on the other four
  // runtime authoring doors.
  customOfSlug String?
  // What a customizable recipe charges for the player's words, and whether it
  // takes a description at all. Both authored under `custom:` in
  // docs/tags.yaml and only legal beside `customizable: true`.
  //
  // NULL cost means CUSTOM_SURCHARGE (web/lib/customCraft.js) — the painting,
  // the sketch, the badge, the hat. `0` means free, which is what the two
  // meals are: a cook naming their own dish is the whole point of the cooking
  // rework, not an upsell. surchargeFor() is the one verdict both the dialog
  // and the server action read, so the ⬢ shown is always the ⬢ billed.
  customCost   Int?

  // False hides the description box and refuses a posted description. The
  // Fine Meal takes a name and nothing else; the Lavish Meal takes both.
  customDescribable Boolean @default(true)

  // --- Cooking (docs/systemdocs/COOKING.md) -------------------------------
  //
  // What this tag contributes AS AN INGREDIENT, once it has been cooked into
  // something. Authored as the `cooked:` block in docs/tags.yaml, normalized
  // and validated by db/lib/tagShapes.js#normalizeCooked.
  //
  //   { taste: String, mood: Float, into: [<consumesInto entry>, ...]? }
  //
  // The presence of this block is the ONLY thing that makes a tag a legal
  // ingredient — there is no separate flag and no per-recipe list, so adding
  // a fourteenth thing you can cook with is one YAML entry and a sync.
  //
  // `into` is OPTIONAL, and its absence is not "nothing" — it means "use my
  // own consumesInto, live". That is the raw/cooked split, and the medical
  // rework's whole hand-off rests on it: COOKING.md §4-5, and the block
  // comment on db/lib/tagShapes.js#normalizeCooked.
  cooked Json?

  // What this raw material is worth as a Trinket INLAY (TRINKETS.md): added
  // to a minted Trinket's sell price when the smith slots it. A second,
  // narrower "what does this contribute as an ingredient" annotation beside
  // `cooked` above, deliberately not folded into it — Trinket and Cooking are
  // two separate ingredient pools (a smith does not season a Trinket with
  // onion, and a cook does not inlay a stew with malachite), and
  // `resolveIngredientSlots`'s caller tells the two apart by which of these
  // two columns is non-null. No `into`, no `cures` interaction, and no
  // restriction against `craftable`/`equippable` — unlike `cooked`, an inlay
  // ingredient (Iron) can happily also be a recipe ingredient elsewhere.
  inlayValue Int?

  // The ingredient slugs that went into THIS dish, in the order the cook
  // slotted them. Written only on rows minted by a cooking craft
  // (mintCustomCraft), empty on every catalog row and every other mint.
  //
  // Load-bearing twice over. It is what consumeTagRequestImpl reads to work
  // out what a dish does, and it is part of the mint's REUSE KEY: two cooks
  // who type the same words over different ingredients must get two rows, or
  // one of them is eating the other's feces.
  //
  // NEVER ship it to a browser. It is deliberately absent from
  // TAG_CHIP_FIELDS (web/lib/referenceData.js) — a dish says what it tastes
  // of and never what it was made with, and a column in a flight payload
  // would undo that in one dev-tools inspection.
  cookedFrom String[] @default([])

  // A meal recipe's own small mood, before its ingredients. Copied onto the
  // minted dish row. Small on purpose (5 and 8): the ingredient is meant to
  // do the work, which it cannot do if the plate it arrives on is already
  // worth +30. See MOOD.md §6.
  mealMood Float?

  // How many ingredients this recipe takes: `{ min, max }`, authored as
  // `requirement.ingredientSlots`. A sibling of requirementItems below rather
  // than a second `anyOf` entry — the legal set is "any tag with a `cooked`
  // block", which no authored list could keep up with.
  requirementIngredientSlots Json?

  // The INGREDIENT half of a recipe — BREWING.md's "no code enforces a
  // recipe, least of all the ingredient" is no longer true of any entry that
  // carries this. Authored in docs/tags.yaml as `requirement.items`,
  // normalized and validated by
  // db/lib/tagShapes.js#normalizeRequirementItems.
  //
  // Json rather than a Tag[] relation, because an entry is a tag slug
  // ({ slug: "godflesh" }), a whole group ({ group: "items-corpse" }, which
  // Miasma needs: a corpse tag written at death is never in the YAML, so no
  // relation authored there could ever name one), or a choice of slugs
  // ({ anyOf: ["tea", "sweets", "honey"] }).
  //
  // SPENT BY DEFAULT: the craft consumes the ingredient when the work starts
  // and snapshots what went in (CraftProject.consumed, then the audit row's
  // details.consumed). `keep: true` makes holding it the whole check — you
  // keep the corpse you bottled the Miasma over. See CRAFTING.md §3.
  requirementItems Json?

  // Overrides the ingredient-based Craft-menu hiding CRAFTING.md §2b
  // describes: a public recipe whose OWN catalogVisibility is ALL still
  // drops off the menu if any requirementItems ingredient (or, for a
  // `group:` entry, any current member of that group) isn't ALL. Miasma's
  // `group: items-corpse` names a group three catalog:secret monster
  // corpses always sit in (nekker/graga/skinless), so that gate never opens
  // on its own — a player never holding a corpse never learns Brewing
  // (Basic) makes Miasma at all, which was never the design for a basic
  // recipe. `recipePublic: true` (docs/tags.yaml) says this ONE recipe
  // should always be listed regardless of what its ingredient's group
  // contains; `computeKnownRecipeIds` (web/lib/tagRequests.js) checks it
  // before the ingredient walk. Leaves Bone Mask and Death Mask — the same
  // group, still meant to be discovered by holding a body — alone.
  recipePublic Boolean @default(false)

  // What holding (or wearing) this tag adds to one kind of Laboring, from
  // docs/tags.yaml's `laborBonus:` block. Normalised by db/lib/tagShapes.js
  // and read by db/lib/laborAccess.js when it scores a labor candidate.
  //
  // Shape: { kind: "hunting"|"farming"|"fishing", amount: Int,
  //          equipped: Bool, requiresTag: String? }. A flat number of the
  //          hexagon, added AFTER the location coefficient has scaled the
  //          range, so a tool is worth the same everywhere.
  //
  // Json rather than three columns because most tags have no bonus at all,
  // and because `requiresTag` (the Plow needs a horse) has no column shape.
  laborBonus Json?

  // What this tag does in a fight, from docs/tags.yaml's `fighting:` block.
  // Normalised by db/lib/tagShapes.js and read by db/lib/fightingSkill.js,
  // which owns the band words and the stacking rule the way
  // db/lib/armorValue.js owns armour's. Same Json-rather-than-columns posture
  // as laborBonus above: most of the catalog has no block at all, and `when`
  // has no column shape.
  //
  // Shape, every key optional: { tree: "melee"|"ranged"|"both",
  //   rung: Int, points: Int, floor: BandKey, cap: BandKey,
  //   weaponClass: String, when: { weaponClass: [String], holds: [String],
  //   equipped: [String], unarmoured: [EquipSlot] }, situational: String,
  //   note: String, cancels: [String] }.
  //
  // AUTHORED IN TIERS, STORED IN POINTS. docs/tags.yaml writes `tiers: -0.5`
  // because that is the unit twenty tag descriptions already speak ("counts
  // as 2 tiers higher"); tagShapes.js multiplies by POINTS_PER_TIER so every
  // number in the database and in the arithmetic is an integer. Nothing reads
  // `tiers` back out of here.
  //
  // NEVER shown to a player as the number, exactly like meleeArmor above.
  // A fighting skill reads as a word — Pitiful, Weak, Mediocre, Capable,
  // Seasoned, Dangerous, Lethal, Legendary — and the breakdown behind it
  // names contributors in tiers. A score on a tile would turn a fight into
  // arithmetic, and would also hand players a way to compare themselves to
  // somebody they should not be able to measure at all.
  fighting Json?

  // Structure type data, from docs/tags.yaml's `placement:` block —
  // normalised and validated by db/lib/tagShapes.js, same posture as
  // laborBonus above. Its PRESENCE is what makes a craftable BUILD ON SITE
  // (a Structure row at the builder's Location) instead of landing in a
  // pocket; there is deliberately no separate `placeable` boolean, because
  // a bare flag would still need somewhere to put the numbers.
  //
  // Shape (all keys optional):
  //   { unique: Bool (default true),
  //     fieldwork: Bool (default false — true skips needsWorkshop()),
  //     examine: String, defenseNote: String,
  //     inscribable: Bool (the builder may write a line on it),
  //     laborBonus: { kind: "hunting"|"farming"|"fishing", amount: Int },
  //     provides: [tagSlug, ...],
  //     locations: [locationSlug, ...] — where it may be raised at all;
  //       absent means anywhere the ground rules allow (canBuildHere),
  //     yields: { tag: slug, room: roomSlug, quantity: Int } — poured into
  //       that room's floor every turn (db/lib/structureYieldPass.js); the
  //       room need NOT be at the structure's own Location,
  //     birdSendsPerDay: Int — the Bird allowance standing here is worth
  //       (BIRD.md); biggest at the Location wins,
  //     music: { mood: Int, needs: tagSlug } — what the six-hourly sweep
  //       pays each listener, and what must lie in a Room here for any of it
  //       to happen (bot/src/lib/stagePlay.js) }
  //
  // `locations`, `yields.room` and `music.needs`'s ROOM/LOCATION slugs name
  // docs/zones.yaml, which syncs independently of docs/tags.yaml — so those
  // are resolved at runtime and fail soft, never at sync time.
  //
  // A tag carrying this must be craftable and must NOT be tradeable,
  // stackable, equippable, or carry a carryBonus — db:sync-tags throws on
  // every one of those, because a structure is never on anyone's person.
  placement Json?

  // What holding this tag does to the Desire catalog, from docs/tags.yaml's
  // `desires:` block. Normalised + validated by db/lib/desireShapes.js
  // (shared by db:sync-tags and db:sync-desires, same posture as
  // db/lib/tagShapes.js). Null for the ~99% of tags that lock nothing.
  // An ARRAY of clauses, union semantics — each clause is exactly one of
  // {all:true} | {families:[...]} | {tiers:[...]}, plus an optional
  // exceptFamilies. Multi-clause is needed for Nobility. The GM's
  // custom-tag form at /gm/dev/tags does NOT get an editor for this — a GM
  // homebrew tag never locks catalog content.
  desireLocks Json?

  // Pairwise cross-group incompatibility. Tag.exclusive above is same-group
  // only (one Belief, one Addiction); this is the "this Addiction and that
  // Restriction cannot coexist" rule, which no existing mechanism could
  // express. Written in BOTH directions by db:sync-tags, so a caller only
  // ever has to check one side.
  conflictsWith Tag[] @relation("TagConflicts")
  conflictedBy  Tag[] @relation("TagConflicts")

  desireRequiredBy    DesireTemplate[] @relation("DesireRequiresAnyTag")
  desireForbiddenBy   DesireTemplate[] @relation("DesireForbidsTag")
  desireAllRequiredBy DesireTemplate[] @relation("DesireRequiresAllTag")

  characters          CharacterTag[]
  roomTags            RoomTag[]
  noticePost          NoticePost?
  gatedGroups         TagGroup[]        @relation("TagGroupGate")
  cavingRolls         CavingRoll[]
  offers              Offer[]
  craftProjects       CraftProject[]
  laborDropOptions    LaborDropOption[] @relation("LaborDropGrantTag")
  laborDropRequiredBy LaborDropOption[] @relation("LaborDropRequiredTag")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Declared here as well as in 20260906010000_corpses/migration.sql, so the
  // schema and the migration history agree about it. They did not at first:
  // the index was raw SQL only, which made every `prisma migrate diff` propose
  // DROP INDEX "Tag_corpseKind_idx" as if it were drift somebody introduced.
  // The two trgm indexes still read that way and still have to be declined by
  // hand (see CLAUDE.md); this one no longer does.
  @@index([corpseKind])
  // Declared here as well as in the migration SQL, so `prisma migrate diff`
  // does not read it as drift. Same reasoning as the corpseKind index above.
  @@index([ephemeral])
}

// Optional grouping of tags within a single category, purely for display
// coloring (see TagChip.js) — e.g. the Status category's Health/Food/Buffs/
// Debuffs groups. Also master-sourced from docs/tags.yaml, same
// non-destructive upsert-by-slug contract as Tag.
model TagGroup {
  id   String @id @default(cuid())
  slug String @unique
  name String

  // Must match one of the categories declared at the top of docs/tags.yaml —
  // a plain string, not a DB-enforced FK, same as Tag.category.
  category String

  // Freeform hex color (e.g. "#6fa8ab"), rendered directly by TagChip.js —
  // null means uncolored. Not theme-aware; docs/taggroups.yaml is the
  // source of truth for values in use.
  color String?

  // Whole-group gate: every tag in this group stays hidden until the
  // character holds requiredTag. This is the hidden-category mechanism —
  // the Demoness category holds exactly one gated group,
  // so until you hold the unlocking tag the category has no tab in any
  // picker and its tags are withheld from /api/tags outright. Live:
  // requirementSatisfied() in web/lib/characterCreation.js is the single
  // reader, called by PointBuy, the Add Tag picker, createCharacter and
  // addTagRequest; the API route filters on it directly.
  requiredTagId String?
  requiredTag   Tag?    @relation("TagGroupGate", fields: [requiredTagId], references: [id])

  tags Tag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CharacterTag {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id])
  tagId       String
  tag         Tag       @relation(fields: [tagId], references: [id])
  source      TagSource
  acquiredAt  DateTime  @default(now())

  // Turn number this tag expires at, swept by resolveNeeds() in db/index.js
  // once the closing turn's number reaches it. Null means it never
  // auto-expires. An ordinary tag's row is deleted; a Tag.stackable one
  // instead loses a single unit and has this field pushed forward by the
  // tag's defaultDurationTurns, until the last unit takes the row with it.
  // Used for system-granted temporary status tags (Ate Meal, Tipsy) — see
  // EVENT below.
  expiresTurn Int?

  // Whether AT LEAST ONE unit of this held tag is currently equipped —
  // `equippedQuantity > 0`, kept in sync with it on every write. Only ever
  // true for a Tag.equippable one. Every "holds it or doesn't" check in the
  // codebase (fear, armour, mounts, concealment, labor bonuses...) reads only
  // this column and is unaffected by how many units that actually is. The cap
  // itself is per slot, not a flat count across the character: Tag.equipSlot
  // says where a thing goes and db/lib/equipSlots.js says how many fit there.
  equipped Boolean @default(false)

  // How many of `quantity` are currently equipped, each occupying its own
  // slot or hand (db/lib/equipSlots.js) — five swords equipped is three hands
  // spent and two still in the pack, not one hand for "a stack of swords".
  // Never above `quantity`: whatever shrinks quantity below it
  // (dropCharacterTag, a GM's patch) clamps this down first and frees the
  // slots that unequips. Always 0 or 1 for a non-stackable tag, mirroring
  // `equipped` exactly.
  equippedQuantity Int @default(0)

  // How many of this tag the character holds. Always 1 for an ordinary tag;
  // only Tag.stackable ones ever go above it, and nothing may drive it
  // below 1 — the row is deleted instead. Point-buy never sets this: the
  // wizard is a toggle-set, so a bought tag lands on the default.
  quantity Int @default(1)

  // Poison state on this REAL food/drink row (never a minted clone — a
  // poisoned meal is the same row a bystander sees, so there is no name/leak
  // problem to solve). How many of the held `quantity` units are dosed, and
  // the payload identifying which poison (its Tag id) produced them. Schema
  // only for now — the Poison action that reads/writes this is a later
  // milestone of the medical pass.
  poisonedCount Int   @default(0)
  poisonPayload Json?

  @@unique([characterId, tagId])
}

// A playable seat, master-sourced from docs/roles.yaml's
// zones[].factions[].roles[] (db/lib/syncRoles.js, npm run db:sync-roles).
// Threats are deliberately not in that YAML at all — they live in
// db/lib/threats.js, hand-assigned by a GM, and never appear in the
// player-facing picker. See docs/systemdocs/THREATS.md.
model Role {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  intro       String   @default("")
  description String[] @default([])
  difficulty  String?

  // Authoring order within the faction, so the picker matches roles.yaml.
  sortOrder Int @default(0)

  factionId String
  faction   Faction @relation(fields: [factionId], references: [id])

  // Seat math, from the YAML's `multiple`/`weight` pair. Exactly one of
  // these three shapes applies, resolved by roleCapacity() in
  // db/lib/roleCapacity.js:
  //   isUnique  -> exactly 1 seat, forever (`multiple: false`)
  //   unlimited -> no cap at any scale (`weight: unlimited`)
  //   weight    -> round(weight * GameConfig.playerCount / 100)
  isUnique  Boolean @default(false)
  unlimited Boolean @default(false)
  weight    Int?

  // The starting package handed to a character who picks this role.
  startingResources   Int      @default(0)
  extraStartingPoints Int      @default(0)
  startingTagSlugs    String[] @default([])
  grantsLeader        Boolean  @default(false)
  grantsTreasurer     Boolean  @default(false)
  docElements         String[] @default([])

  // Whether picking this role needs the @Leader Whitelist Discord role. This
  // used to ride on grantsLeader, which conflated two unrelated things: the
  // Baron HAS to lead the Court, but "who may claim this seat" is a hosting
  // decision that has nothing to do with faction mechanics. Declared as
  // `whitelist:` in docs/roles.yaml. Gated by GameConfig.leaderWhitelistEnabled;
  // superadmins bypass. See docs/systemdocs/CHARACTERS.md §2.
  requiresWhitelist Boolean @default(false)

  // A seat that fixes the holder's gender rather than letting them choose:
  // Baron and Heir are MAN, Baroness and Successor are WOMAN. Null for every
  // ordinary role, which is nearly all of them. Declared as `gender:` in
  // docs/roles.yaml, so a future gendered seat needs no code — same posture
  // as grantsLeader/grantsTreasurer above.
  //
  // createCharacter stamps this over whatever the form posted, exactly as it
  // does for a dynasty member's last name; the disabled picker in the wizard
  // is only the hint.
  lockedGender Gender?

  // Where characters with this role begin. startingLocationId is what
  // creation writes; startingZoneId is its zone, kept for the readers that
  // group by zone. Derived by db/lib/syncRoles.js from `starting_location:`
  // in docs/roles.yaml, or — when absent — the first Location of
  // `starting_zone:`.
  startingZoneId     String?
  startingZone       Zone?     @relation("RoleStartingZone", fields: [startingZoneId], references: [id])
  startingLocationId String?
  startingLocation   Location? @relation("RoleStartingLocation", fields: [startingLocationId], references: [id])

  characters   Character[]
  reservations RoleReservation[]
  lobbyEntries LobbyEntry[]
  threatSpawns ThreatSpawn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([factionId])
}

// A creation-wizard-in-progress hold on a Role seat. Without this, a player
// who picks a capacity-1 role at step 1 and spends ten minutes on the tag
// menu can lose the seat at Confirm with no warning — reported verbatim as
// "someone took my role". See db/lib/roleReservation.js for the seat math
// and CHARACTERS.md's Seat caps section.
//
// discordUserId is @unique so a player can hold exactly one seat at a time —
// reserving a second role is an upsert that releases the first. Expiry is
// swept lazily wherever taken counts are read; there is no cron job.
model RoleReservation {
  id            String   @id @default(cuid())
  discordUserId String   @unique
  roleId        String
  role          Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([roleId, expiresAt])
}

/// What a player asked for if the roll leaves them with nothing
/// (docs/systemdocs/LOBBY.md §3). COMMONER and MIGRANT are the two unlimited
/// seats; RETURN_TO_LOBBY means they late-join by hand after Start.
enum JoblessRole {
  COMMONER
  MIGRANT
  RETURN_TO_LOBBY
}

/// A player's lobby preferences, keyed by Discord user and DURABLE — Restart
/// Game never touches this table, so a returning player only has to ready up.
/// Priorities are keyed by Role.slug, so a role that leaves docs/roles.yaml
/// silently drops out rather than dangling on an id.
model PlayerPreference {
  discordUserId String @id

  // { [roleSlug]: "LOW" | "MEDIUM" | "HIGH" }; a slug that is absent is Off.
  // At most one HIGH — db/lib/playerPreferences.js#setPriority demotes the
  // previous one to MEDIUM, the way SS13's set_job_preference_level does.
  rolePriorities Json @default("{}")

  // Threat catalog slugs (the REAL slugs, never the public opt-in names —
  // db/lib/threats.js). Copied onto Character.antagonistOptIns at creation,
  // where it locks; this row stays editable only while there is no character.
  antagonistOptIns String[] @default([])

  joblessRole JoblessRole @default(COMMONER)
  updatedAt   DateTime    @updatedAt
}

/// READY:      in the lobby, waiting for Start.
/// ASSIGNED:   Start gave them a seat; the sheet is theirs to build until
///             expiresAt. An ASSIGNED row with a future expiresAt HOLDS the
///             seat for capacity purposes (db/lib/seatCount.js).
/// CREATED:    the character exists; the row is history.
/// DECLINED:   they pressed Decline in the DM; the seat is free again.
/// EXPIRED:    the lobby sweep found expiresAt in the past; the seat is free.
/// UNASSIGNED: nothing matched and they asked to return to the lobby.
enum LobbyStatus {
  READY
  ASSIGNED
  CREATED
  DECLINED
  EXPIRED
  UNASSIGNED
}

/// One row per player per GAME: readying up creates it, un-readying deletes
/// it, Start Game stamps the assignment on it, and Restart Game clears the
/// table. Everything a game needs to know about a player before they have a
/// character. See docs/systemdocs/LOBBY.md.
model LobbyEntry {
  id            String      @id @default(cuid())
  discordUserId String      @unique
  status        LobbyStatus @default(READY)
  readyAt       DateTime    @default(now())

  assignedRoleId String?
  assignedRole   Role?     @relation(fields: [assignedRoleId], references: [id], onDelete: SetNull)
  assignedAt     DateTime?
  expiresAt      DateTime?
  // When the six-hours-left reminder went out, so it goes out once.
  reminderSentAt DateTime?
  // The Character the ASSIGNED seat became, once it did.
  characterId    String?
  // When the assignment DM was delivered; null until it was, which is what the
  // sweep reads to send it again after a Start that died mid-loop.
  notifiedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, expiresAt])
  @@index([assignedRoleId, status])
}

// Master-sourced from docs/documents.yaml
// (db/lib/syncDocuments.js#syncDocumentsFromYaml, npm run db:sync-documents).
// `key` is the stable match key, and is what docs/roles.yaml's
// `doc_elements` lists point at. The sync is destructive: an entry no longer
// in the YAML has its row removed, same posture as syncLocations.
//
// Assignment is denormalized into string arrays rather than join tables. The
// catalog is ~30 rows, fully rebuilt from YAML on every sync, and read in one
// query per page view, so four relations would buy nothing. A document is
// ASSIGNED to a character if ANY of these matches: their role's docElements
// lists this key, they hold one of tagSlugs, their role is in roleSlugs,
// their faction is in factionSlugs, or flags names a Character boolean they
// have set.
model Document {
  id          String @id @default(cuid())
  key         String @unique
  name        String
  description String @default("")

  // Everyone sees it, character or not — this is what the PUBLIC tab of
  // /documents renders, and the reason that page is readable before the
  // game opens.
  isPublic Boolean @default(false)

  // Master-GM-only. The SECRET tab of /documents shows these to GMs with
  // no zone assignment, so the master can reference threat briefs without
  // handing every zone-GM the full picture.
  isSecret Boolean @default(false)

  tagSlugs     String[] @default([])
  roleSlugs    String[] @default([])
  factionSlugs String[] @default([])
  // "leader" / "treasurer", read against Character.isLeader/isTreasurer,
  // which are booleans rather than tags (see docs/systemdocs/TAGS.md §6).
  flags        String[] @default([])

  // Authoring order from the YAML, so the gallery matches the file.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Turn {
  // Set once every pass in resolveNeeds() has completed for this turn.
  // A RESOLVED turn with this still null is one whose advance was claimed and
  // then died mid-flight — the process was killed, or a redeploy landed at
  // 04:00. advanceTurn() looks for exactly that and finishes the job instead
  // of silently skipping hunger and decay for the day, which is what it used
  // to do (the claim leaves no OPEN turn, so the rerun took the
  // nothing-to-resolve branch).
  needsResolvedAt DateTime?

  // Which passes have already been applied, as a JSON array of names. The
  // passes are NOT individually idempotent — re-running hunger charges upkeep
  // twice — so a resume has to know precisely which ones landed rather than
  // re-running the lot. A pass that throws is deliberately left unrecorded so
  // the next advance retries it.
  resolvedPasses Json?

  // The resume LEASE, which needsResolvedAt above cannot be: that one is the
  // completion stamp, written at the end, and a lease has to be taken at the
  // start.
  //
  // The resume branch used to be a plain findFirst, so the bot's 04:00 cron
  // and a GM clicking End turn on a crashed turn both matched the same row,
  // both read the same empty resolvedPasses, and both ran every outstanding
  // pass — hunger charged twice, Lifeweb decayed twice. resolvedPasses is not
  // a lock; last-write-wins cannot arbitrate. advanceTurn() now claims this
  // field with a conditional updateMany, the same compare-and-swap the normal
  // path does on status: "OPEN".
  //
  // Stale rather than permanent: a resume that dies holding the lease would
  // otherwise wedge the turn forever, so a claim older than the timeout can be
  // taken over.
  needsResumeClaimedAt DateTime?

  // The DISCORD half of the turn, which the three fields above do not cover at
  // all. resolveNeeds() stamps needsResolvedAt when the database passes are
  // done — before advanceTurn() has even built the side-effect thunk — so a
  // turn whose fan-out died was already "finished" as far as the resume query
  // was concerned. On 2026-09-08 the bomb detonated, twelve characters died in
  // the database, and a redeploy SIGTERM'd the container twenty-eight seconds
  // later: three of twelve death DMs went out, the fireball and the Game Ended
  // post never did, and nothing was ever going to retry them.
  //
  // Everything the thunk needs, as plain JSON, so it can be replayed by a
  // process that never saw the turn resolve. See buildSideEffectPayload in
  // db/lib/turnSideEffects.js for what may go in here — no Prisma rows, no
  // Dates, no functions.
  sideEffectPayload Json?

  // Which sends have already gone out, as a JSON array of keys —
  // resolvedPasses' shape and resolvedPasses' reason. A DM is not idempotent;
  // re-running the loop tells somebody a second time that they died.
  sideEffectSteps Json?

  // The completion stamp, and the sole selector for the side-effect resume.
  sideEffectsDoneAt DateTime?

  // The side-effect resume's LEASE, needsResumeClaimedAt's twin and taken for
  // the same reason: sideEffectSteps is last-write-wins and cannot arbitrate
  // two resumes racing. Stale after RESUME_LEASE_MS so a resume that dies
  // holding it cannot wedge the turn.
  sideEffectClaimedAt DateTime?

  id         String     @id @default(cuid())
  number     Int        @unique
  phase      TurnPhase
  // Which banner #turns posted for this turn — a filename in docs/assets/turn/,
  // chosen once when the turn opens so a repost shows the same picture rather
  // than a fresh roll. Null on rows that predate the column; the resolver
  // picks one on the spot for those (db/lib/turnBanner.js).
  banner     String?
  gameDate   DateTime
  status     TurnStatus @default(OPEN)
  startedAt  DateTime   @default(now())
  resolvedAt DateTime?

  actions        Action[]
  stagedMessages StagedMessage[]
  stagedEffects  StagedEffect[]
  cavingRolls    CavingRoll[]
  offers         Offer[]
  oraclePages    OracleSynopsis[]
  pendingTaxes   PendingTax[]
}

model Action {
  id                     String      @id @default(cuid())
  characterId            String
  character              Character   @relation(fields: [characterId], references: [id])
  turnId                 String
  turn                   Turn        @relation(fields: [turnId], references: [id])
  type                   ActionType?
  description            String
  zoneId                 String?
  zone                   Zone?       @relation(fields: [zoneId], references: [id])
  // WHERE this Move happened, stamped at filing time. zoneId above is not
  // enough: a free zone move (CARRY.md §2a) costs no Action, so a character
  // can file a Labor on the Factory floor and walk out before the turn closes,
  // and the payout runs at turn close. db/lib/moveEffects.js#refined reads
  // this to decide whether a Labor was a REFINING one; without it, it asked
  // where the character is standing NOW and paid for the wrong room.
  // Nullable, and readers fall back to the live location, so rows filed
  // before this existed still resolve.
  locationId             String?
  location               Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  resourceDelta          Int?
  // A range like "5-12", rolled at ⚜ confirm. @map keeps the original column
  // names: this used to hold dice notation ("1d6*2"), which the labor
  // shorthands and ranges replaced, so the field renamed but the SQL didn't.
  resourceRollExpression String?     @map("resourceDiceExpression")
  resourceRollValue      Int?        @map("resourceDiceRoll")
  diceRoll               Int?

  // The summed adjustment applied to a Gambit's d6 — Hunger only, see
  // db/lib/gambitModifier.js. Kept SEPARATE from diceRoll, which stores the raw
  // roll — otherwise a GM can't tell a modified 5 from a natural 5, and a
  // re-roll during adjudication would compound the modifier.
  diceModifier Int?
  status       ActionStatus @default(PENDING)

  // Routine vs Gambit (see MoveKind above) and the GM's spreadsheet-workflow
  // status — set during the DM submission flow (moveKind) and/or later
  // edited by a GM from the Moves adjudication popup (both, plus
  // moveReviewStatus itself).
  moveKind         MoveKind?
  moveReviewStatus MoveReviewStatus @default(OPEN)

  // Did a player write this Move themselves, in the modal or the Move dialog?
  // Only db/lib/moves.js#fileMove sets it. That is what makes a Gambit
  // editable and withdrawable until lock-in (db/lib/moves.js#moveIsEditable) —
  // a Move the GAME filed is a receipt for something that already happened,
  // and has nothing left to withdraw.
  //
  // Defaults FALSE so it fails closed. Three places file a GAMBIT row whose
  // cost is already paid — Research, the forge's Trinket and an above-skill
  // heal — and a withdrawal there would refund nothing while handing the turn
  // back. Deliberately a column rather than a `gmNotes` string match: that
  // matching is what this change exists to retire.
  playerFiled Boolean @default(false)

  // Which tier actually won for a LABOR Move — "basic" | "skilled" |
  // "hunting" | "farming" | "fishing" | "refining", db/lib/laborAccess.js's
  // own tier strings, not a Prisma enum (nothing else needs to query on it).
  // Stamped once, at filing (db/lib/moves.js) or at auto-labor creation
  // (db/lib/autoLaborPass.js), and never recomputed — a free zone move can
  // carry a character somewhere else before turn close (see locationId's own
  // comment above), so re-deriving from where they stand NOW would answer a
  // different question than the one that was actually priced.
  // db/lib/moveEffects.js's `laborDrop` effect is the one reader; a row filed
  // before this field existed reads null and simply rolls no drop, same as
  // any LABOR Move whose roll matches no configured pool.
  laborTier String?

  // Who resolved this Move and when. Request has carried these since the
  // rework; Moves need them too now that several GMs share the queue behind a
  // lock. The ID is stored, the Discord username is rendered.
  reviewedAt              DateTime?
  reviewedByDiscordUserId String?

  // Cooperative lock so two GMs don't adjudicate the same Move. Deliberately
  // NOT moveReviewStatus: a crashed browser lets lockExpiresAt lapse, where a
  // status write would strand the row "In Progress" forever. The Moves table
  // derives "In Progress" from a live lock.
  lockedByDiscordUserId String?
  lockExpiresAt         DateTime?

  // Snapshot of what was actually pushed onto the sheet — `{"resources":5}`
  // today. Written by the turn-end staged push (db/lib/stagedPush.js), which
  // also uses the SQL-NULL → `{}` transition as its per-row claim so a
  // resumed pass can never pay twice; the Default Move pass and travel stubs
  // stamp theirs at filing time. Reverts (deleteActionRestoringTurn) read
  // ONLY this and never re-derive from live state, the same
  // payload-vs-effect rule Request.effect follows (REQUESTS.md §2). JSON
  // rather than an Int so the push can grow past resources without a
  // migration. Null means nothing has been pushed yet.
  appliedEffects Json?

  // The craft ledger for this turn: which skill family the Move was spent in
  // and how much of it is left, so several small crafts can share one Routine.
  // Deliberately NOT folded into appliedEffects above, which the turn-end
  // staged push owns and claims rows through. Written and read by the Craft
  // path only. Null on every Action that is not a craft.
  craftBudget Json?

  // The Result box — the GM-facing canon of what happened, never auto-sent
  // (players are told through StagedMessages at the push; ADJUDICATION.md).
  resultMessage      String?
  // Machine markers only since the staged-arbitration rework — the "auto:*"
  // family (auto:labor, auto:zone_change, auto:silent_close…). No GM UI
  // renders or edits it any more.
  gmNotes            String?
  forumThreadId      String?
  confirmDmMessageId String?         @unique
  confirmedAt        DateTime?
  createdAt          DateTime        @default(now())
  stagedMessages     StagedMessage[]
  stagedEffects      StagedEffect[]

  // One Action per character per turn — the rule every writer already applies
  // by hand (db/lib/travel.js, interactionCreate's Move modal,
  // defaultMovePass's `acted` set, and the Dev Panel's spendTurn), each
  // via a non-transactional findFirst-then-create. At rollover, when everyone
  // acts at once and Discord retries interactions, that gap lets a
  // double-submit file two Actions and pay out twice. The database is the only
  // place the check can't be raced.
  @@unique([characterId, turnId])
  @@index([status, createdAt])
  @@index([characterId])
  @@index([turnId])
  // [status, createdAt] leads with status, so it cannot serve /gm/turns'
  // unfiltered `orderBy: { createdAt: "desc" }`. This one can.
  @@index([createdAt])
}

enum StagedMessageKind {
  PRIVATE
  PUBLIC
}

// A message a GM composed during adjudication that has NOT gone out yet.
// Nothing a GM stages reaches a player until the turn-end push
// (db/lib/stagedPush.js): PRIVATE rows fan out as DMs to their recipient
// characters' players, PUBLIC rows post to their zone's #summary channel.
// Until then every row is freely editable and deletable from the /gm/turns
// workspace; sentAt non-null is what freezes one.
model StagedMessage {
  id     String @id @default(cuid())
  turnId String
  turn   Turn   @relation(fields: [turnId], references: [id])

  // The Move this message narrates, if any. SetNull rather than Cascade so
  // a Reject (which deletes the Action to give the turn back) detaches the
  // staged work instead of destroying it — the tray shows it "unattached"
  // with a delete affordance, and the GM decides.
  moveId String?
  move   Action? @relation(fields: [moveId], references: [id], onDelete: SetNull)

  // Same SetNull reasoning as moveId, for the Caving lens: a GM can stage
  // narration against a Caving Die roll of 1 exactly as against a Move.
  cavingRollId String?
  cavingRoll   CavingRoll? @relation(fields: [cavingRollId], references: [id], onDelete: SetNull)

  kind    StagedMessageKind
  content String

  // PUBLIC only, required: the zone whose #summary channel this posts to
  // (db/lib/stagedPush.js).
  zoneId String?
  zone   Zone?   @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  // Snapshot, no FK — same log-table convention as AuditLog's actor.
  createdByDiscordUserId String

  // Stamped by the push thunk after delivery is attempted. deliveryFailures
  // holds [{characterId, name, error}] for recipients whose DM bounced (or
  // {reason} for a PUBLIC row with no channel configured) — the audit row
  // staged_push_delivery_failed carries the same list.
  sentAt           DateTime?
  deliveryFailures Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipients StagedMessageRecipient[]
  deliveries Delivery[]

  @@index([turnId])
  @@index([moveId])
}

// One send, one row. The unit of delivery for a staged message: one per
// PRIVATE recipient, one for a PUBLIC row's post (docs/systemdocs/ADJUDICATION.md §1a).
//
// WHY IT EXISTS. The push used to record its progress as a step key on the
// Turn — `delivery:<messageId>:<index>` — and swallow a bounced DM inside the
// step, so the key was written whether or not the player got anything. A
// resumed push then skipped the bounce for good, and the Resend button ran a
// SECOND copy of the send logic (web/app/(desk)/gm/turns/actions.js) reading a
// JSON blob to work out who to retry. Three problems fall out of that, and all
// three are the same problem: there was no row that said what happened to ONE
// recipient.
//
// `state` is that row. `dedupeKey` is its identity — built from ids, never a
// loop index, so it survives a recipient being removed between a crash and its
// resume (db/lib/dmPolicy.js#dedupeKey). The claim is `updateMany` from a
// non-terminal state to IN_FLIGHT: count 0 means somebody else has it, which is
// how two pushes, or a push and a GM's Resend, stay out of each other's way.
//
// StagedMessage.sentAt and deliveryFailures are still written — the desk, the
// tray and every archived turn read them — but they are now DERIVED from these
// rows rather than being the only record.
model Delivery {
  id              String        @id @default(cuid())
  stagedMessageId String
  stagedMessage   StagedMessage @relation(fields: [stagedMessageId], references: [id], onDelete: Cascade)

  // Who it is for. SetNull rather than Cascade: a character deleted after a
  // push must not take the record of what they were sent with them — the
  // snapshot below is what the failure list reads. Null on a PUBLIC row, which
  // is addressed to a channel.
  characterId String?
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  // Snapshots, no FK — the log-table convention (ARCHITECTURE.md). The name is
  // what a GM reads in "failed: Ada", and it has to keep reading right after
  // the character is gone. On a cave declaration's fan-out row it is the
  // LOCATION's name, so the tray reads "Customs: Missing Access"; null on a
  // #summary row, which the tray renders as "the channel".
  discordUserId String?
  name          String?

  // Stable across the push and every later resend. Partial on nothing.
  //
  // A PUBLIC message has one row per CHANNEL it posts into. For a surface zone
  // that is the one #summary and the key ends in the bare word "public" — the
  // key it has always had, kept byte-identical because production is full of
  // them and a changed tail would write a second row on every declaration ever
  // pushed. A CAVE_LEVEL zone has no #summary, so its declaration fans out to
  // every Location channel in the level and each row's key ends in
  // "public:loc:<locationId>" (db/lib/publicPostTargets.js).
  //
  // The LOCATION, not its channel id: syncZones and the channel doctor both
  // rewrite Location.discordChannelId on re-provisioning, and a channel-id tail
  // would orphan a SENT row and post the declaration into that room twice.
  //
  // A PRIVATE row's ends in the CHARACTER id, not the Discord one — a recipient
  // who never linked Discord has no id, and keying on it collapsed every such
  // recipient onto one row (and onto the PUBLIC row's key besides).
  dedupeKey String @unique

  state    DeliveryState @default(PENDING)
  attempts Int           @default(0)

  // The claim stamp. A row left IN_FLIGHT by a killed process is reclaimable
  // after STALE_CLAIM_MS (db/lib/stagedDelivery.js) — FIVE minutes, not the
  // thirty Turn.sideEffectClaimedAt uses. That window covers a whole
  // side-effect thunk; this one covers a single DM, and anything still in
  // flight five minutes later is a process that is not coming back.
  claimedAt DateTime?
  sentAt    DateTime?

  discordMessageId String?
  lastError        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stagedMessageId])
  @@index([state])
}

enum DeliveryState {
  PENDING
  IN_FLIGHT
  SENT
  FAILED
}

// PRIVATE recipients, one row per recipient character. Cascade both ways:
// deleting the message drops its recipients, and a deleted character simply
// falls out of every recipient list (a DEAD one deliberately does not — "you
// died" is exactly what a staged message is for). A PRIVATE message whose
// recipients have all cascaded away is skipped at push and shown as
// "no recipients" in the tray.
model StagedMessageRecipient {
  id              String        @id @default(cuid())
  stagedMessageId String
  stagedMessage   StagedMessage @relation(fields: [stagedMessageId], references: [id], onDelete: Cascade)
  characterId     String
  character       Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([stagedMessageId, characterId])
  @@index([characterId])
}

// A mechanical adjustment a GM staged during adjudication — resources and/or
// tag ops against one target character — applied by the turn-end push, never
// before. payload is what the GM asked for; appliedEffect is what actually
// moved (the clamped resource delta, the tag ops that validated), the same
// payload-vs-effect rule Request.payload/effect and Action.appliedEffects
// follow. appliedAt doubles as the push pass's per-row claim, so a resumed
// pass can never apply one twice.
model StagedEffect {
  id     String @id @default(cuid())
  turnId String
  turn   Turn   @relation(fields: [turnId], references: [id])

  // Same SetNull reasoning as StagedMessage.moveId above.
  moveId String?
  move   Action? @relation(fields: [moveId], references: [id], onDelete: SetNull)

  // Same SetNull reasoning, for the Caving lens.
  cavingRollId String?
  cavingRoll   CavingRoll? @relation(fields: [cavingRollId], references: [id], onDelete: SetNull)

  // Nullable: a Room -> Room transfer has no character end, and neither does
  // a staged change to a room's own stash. The filing rule is "the character
  // end of this row, if any" — the recipient when both ends of a transfer are
  // characters (they're the one who gets the DM), null when neither is. Every
  // other staged effect (resources/tagPoints/tagOps/location) always targets
  // exactly one character, so this stays required in practice for every
  // payload shape but `transfer` and `room`.
  targetCharacterId String?
  targetCharacter   Character? @relation(fields: [targetCharacterId], references: [id], onDelete: Cascade)

  // Snapshot, no FK — log-table convention.
  createdByDiscordUserId String

  // A mass-apply ("Explosion Burns to these 4") writes one row per target
  // under a shared batchId, so the tray can show and delete it as one line.
  batchId String?

  // { resources?: Int, tagOps?: [op] } — the op shape is the Dev Panel's
  // (see db/lib/tagOps.js): {tagId, op: add|remove|patch, quantity?, source?,
  // expiry?, equipped?}. May also carry `locationId?: String` — a staged
  // relocation, applied as a raw write at the push with the Discord half
  // handed to the side-effect thunk. May instead carry
  // `transfer?: { from: {kind,id,name}, to: {kind,id,name}, amount }` —
  // mutually exclusive with `resources`; a row either mints/burns ⬢ from
  // nowhere or moves it between two named parties, never both.
  //
  // A ROOM row is the third shape and stands entirely apart:
  // `{ room: {id, name, locationName}, roomTagOps?: [{tagId, op, quantity?}],
  // roomResources?: Int }`, with targetCharacterId null and NONE of the keys
  // above. Its own keys are deliberately distinct so the push's field-by-field
  // builder can never hand a null character id to a character branch. Tags go
  // through db/lib/roomTagOps.js, not tagOps.js — see ADJUDICATION.md §1 for
  // what that engine deliberately does not do.
  //
  // A DEATH row is the fourth shape: `{ death: true, gib?: Boolean,
  // reason: String }`. It DOES carry a real targetCharacterId, like the
  // first shape, but is exclusive with every key in it — a dead character
  // has no further sheet to move ⬢ onto, gain tagPoints on, retag, or
  // relocate in the same row, so db/lib/stagedPush.js#applyOneStagedEffect
  // short-circuits on `death` before considering any other key. Applied via
  // db/lib/characterDeath.js#applyDeathToRow inside the row's own
  // transaction — instantaneous at the push, same as everything else here.
  // `gib: true` mints no corpse (CORPSES.md §1a). A target no longer ALIVE
  // by push time (killed some other way meanwhile) resolves as a clean
  // no-op rather than an error — `appliedEffect.death.claimed === false`.
  payload Json

  appliedAt     DateTime?
  appliedEffect Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([turnId])
  @@index([moveId])
  @@index([targetCharacterId])
  @@index([batchId])
}

enum DmDirection {
  INBOUND
  OUTBOUND
}

// Every insert here fires a Postgres trigger, `DirectMessage_notify`, that
// raises NOTIFY bascinet_dm (db/lib/dmNotify.js) — it lives only in migration
// SQL (20260913060000_dm_notify), like the trgm indexes, and `prisma migrate
// diff` never sees it. The Hall's Bascinet conversation listens (HALL.md §2b).
model DirectMessage {
  id            String      @id @default(cuid())
  discordUserId String
  direction     DmDirection
  content       String
  createdAt     DateTime    @default(now())

  // The GM who sent it; null = bot/system or inbound.
  authorDiscordUserId String?

  // What PRODUCED the row. Plain String on purpose — a PG enum would cost a
  // migration per new value, and there are a couple of dozen of these.
  //
  // Only five of them are still read by anything: gm_letter, gm_letter_reply
  // and bird draw as a letter, mention draws as a ping, and staged_push /
  // gm_broadcast put a chip beside the name (web/app/components/DmThread.js).
  // The rest are an audit trail. Do NOT add a new one to a filter list to
  // make it behave — what a row WEIGHS on the GM desk is `kind` below, and
  // the two are deliberately orthogonal. The accurate roster of historical
  // values is the CASE in migrations/20260913140000_dm_kind.
  source String?

  // CONVERSATION | NOTICE | QUIET (db/lib/dmKinds.js). How much of the GM
  // inbox this row is entitled to: a NOTICE is invisible to the rail and grey
  // in the thread, a QUIET row is never drawn at all. String rather than a PG
  // enum for the same reason `source` is one, and NOT NULL because a row with
  // no answer here is exactly the bug this column exists to end. The default
  // is the quiet one at the database level too, not just in sendDm.
  kind String @default("NOTICE")

  // Discord id of the sent message — the last chunk when postDmBatched had
  // to split it, which is the same message for anything under 2000 chars.
  discordMessageId String?

  // e.g. { attachments: [{ name, url, contentType, width, height }] } — inbound
  // player IMAGES only (db/lib/dmAttachments.js; DmThread.js#AttachedImages
  // draws them, the raw Discord CDN url reused as-is) — or { embed: true }.
  // Same Json column either way; a shape change here is not a migration.
  meta Json?

  // The id the CLIENT minted for this send, before it knew the row's own id.
  // An optimistic line in a composer used to be retired by matching its TEXT
  // against whatever came back, so sending "ok" twice retired both at once.
  // The nonce is also what makes a retry safe: a sender that never heard the
  // answer re-sends the same one, and the partial unique index below (it is
  // partial, so the null every other writer passes never collides) means the
  // second attempt can only find the first row, not add a second.
  //
  // The index lives in migration SQL only (20260921020000_dm_client_nonce) —
  // Prisma's schema language cannot say WHERE — so `migrate diff` offers to
  // drop it. Decline, the way the trgm indexes are declined.
  clientNonce String?

  @@index([discordUserId, createdAt])
  @@index([createdAt])
  @@index([direction, discordUserId, createdAt]) // unread scans
  @@index([kind, discordUserId, createdAt]) // the rail's DISTINCT ON
}

// Per-GM read cursor on a player conversation. Unread = INBOUND
// DirectMessage rows newer than lastReadAt. Snapshot ids, no relations/FKs —
// same log-table convention as DirectMessage.
model ConversationRead {
  id                  String   @id @default(cuid())
  gmDiscordUserId     String
  playerDiscordUserId String
  lastReadAt          DateTime

  @@unique([gmDiscordUserId, playerDiscordUserId])
}

// Conversation-level state: advisory claiming, plus the "no reply needed"
// mark. Snapshot ids, no relations/FKs — same log-table convention as
// DirectMessage.
model ConversationMeta {
  id                     String    @id @default(cuid())
  playerDiscordUserId    String    @unique
  claimedByDiscordUserId String?
  claimedAt              DateTime?
  // When a GM marked this conversation as needing no reply. Desk-wide, not
  // per-GM, same as the claim above. It self-expires: the rail only counts it
  // as handled while it is at or after the conversation's last message, so the
  // next inbound DM puts the row back in the awaiting pile with no cleanup.
  handledAt              DateTime?
  // When a GM muted this conversation. Desk-side only — nothing about the
  // bot's behaviour toward the player changes, and their DMs still arrive.
  // A muted row leaves the rail (behind a "Show muted" toggle), renders
  // greyed when shown, and stops counting toward unread/awaiting. Unlike
  // handledAt above this does NOT expire: it holds until a GM unmutes.
  mutedAt                DateTime?
}

// A player's personal note on a message in a Location channel — created by
// reacting ⭐ to any proxied message (bot/src/events/messageReactionAdd.js);
// the bot strips the reaction back off immediately, so the note's presence
// on /notes is the only lasting trace, not the Discord reaction itself. Each
// (message, starrer) pair gets its own row, since a note is personal to
// whoever starred it — not a shared/aggregate count.
model Note {
  id               String     @id @default(cuid())
  discordMessageId String
  discordChannelId String
  characterId      String?
  character        Character? @relation(fields: [characterId], references: [id])

  // The name the room HEARD, which for a hooded or forced line is the alias
  // rather than the person (bot/src/events/messageReactionAdd.js).
  characterName String

  // And the face that went with it, frozen for the same reason
  // ArchiveEntry.presentedAvatarPath is. NULL means the speaker's own face,
  // resolved live from /api/avatar/<id> — which is the right answer only
  // because a note under somebody's real name is a note about somebody whose
  // face the starrer could see. A note from before this column draws the
  // question-mark plate instead of a guess.
  presentedAvatarPath String?
  zoneId              String?
  zone                Zone?    @relation(fields: [zoneId], references: [id])
  content             String
  sentAt              DateTime
  discordUserId       String
  createdAt           DateTime @default(now())

  @@unique([discordMessageId, discordUserId])
  @@index([discordUserId])
  @@index([zoneId])
}

// A player's personal journal entry — the /notes page's Journal tab, distinct
// from Note (a starred Discord message) above. Keyed on discordUserId only,
// same reasoning as Note: it is a player's own writing, never
// a shared or GM-visible surface. `body` may embed `{char:<characterId>}`
// mention tokens (web/app/components/richTokens.js); there is no FK to
// Character on purpose — a deleted or renamed character just degrades the
// mention to a letter-plaque / raw token, the token pipeline's existing
// behaviour for an unresolvable reference, rather than cascading a delete
// into someone's private writing.
model JournalEntry {
  id            String   @id @default(cuid())
  discordUserId String
  title         String
  body          String
  pinned        Boolean  @default(false)
  turnNumber    Int?
  labels        String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([discordUserId])
}

// A consent handshake between two characters, alive for one turn
// (docs/systemdocs/LESSONS.md). LESSON pairs a teacher and a learner around
// one skill and, once accepted, owns the two Moves it filed; BIND asks the
// target's leave before BIND_CHARACTER fires. Character ends are snapshot
// ids without FKs, the log-table convention — a dead character's offers stay
// readable. No DM message id is stored: the bot strips the buttons with
// interaction.update() on click, and a stale button just says the offer's
// gone.
enum OfferKind {
  LESSON
  BIND
  CONFESSION
  ESCORT
  KISS
  SEARCH
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
  RESOLVED
}

model Offer {
  id     String      @id @default(cuid())
  kind   OfferKind
  status OfferStatus @default(PENDING)
  turnId String
  turn   Turn        @relation(fields: [turnId], references: [id])

  // Who pressed the button on the web, and who gets the DM.
  initiatorId String
  responderId String

  // LESSON only. One of them is the initiator.
  teacherId String?
  learnerId String?
  tagId     String?
  tag       Tag?    @relation(fields: [tagId], references: [id])
  // 5, or 4 for a fighting skill under a Drill Instructor. Fixed at accept.
  threshold Int?

  // The two Moves acceptLesson filed. The learner's is a Gambit the lesson
  // pass resolves; the teacher's is a Routine a Lecturer can share across
  // up to three learners.
  learnerActionId String? @unique
  teacherActionId String?

  // SEARCH only, the way teacherId/learnerId above are LESSON only. The tag
  // ids the responder ticked on "Hide items", written BEFORE they answer and
  // read once by acceptSearch. Saved WHOLE each time the picker is saved, so
  // an array rather than row churn — the InterceptWatch.targetNames shape.
  //
  // Deliberately not folded into `outcome`: that column is what every other
  // kind writes at RESOLVE time, and a pre-answer payload sharing it would
  // make one column answer both "what was hidden" and "what was found".
  // No FK, the convention this table's character ends already use — a tag
  // deleted afterwards should leave a dud id the reveal never finds rather
  // than cascading into a resolved offer.
  hiddenTagIds String[] @default([])

  // { diceRoll, diceModifier, total, succeeded, gmDecided }
  outcome Json?

  createdAt   DateTime  @default(now())
  respondedAt DateTime?
  resolvedAt  DateTime?

  @@index([status, turnId])
  @@index([responderId, status])
  @@index([initiatorId, status])
  @@index([teacherActionId])
}

// Which stack a PendingTax row moves. An obol is one ⬢ (DEPOT.md), but it is
// a physical Tag stack rather than a balance column, so taxPass.js has to
// take it off a CharacterTag row instead of running it through
// resourceTransfer.js's applyTransfer.
enum PendingTaxKind {
  RESOURCES
  OBOL
}

// A tax filed by a faction's Leader or Treasurer against a member standing in
// their zone (docs/systemdocs/TAGS.md, the Taxman tag). OPT-OUT, which is why
// this is not an Offer: an Offer does nothing until ACCEPTED, this moves ⬢
// unless REFUSED. Resolves at the close of the turn it was filed in
// (db/lib/taxPass.js) — the same "filed now, resolves at turn close" shape
// every other turn-pass mechanic uses, not a multi-turn delay.
model PendingTax {
  id     String @id @default(cuid())
  turnId String
  turn   Turn   @relation(fields: [turnId], references: [id])

  taxerId String
  taxer   Character @relation("TaxesFiled", fields: [taxerId], references: [id], onDelete: Cascade)

  targetId String
  target   Character @relation("TaxesOwed", fields: [targetId], references: [id], onDelete: Cascade)

  // Snapshots — what the DM said when it was pressed. The seat can change
  // before the close; the words already went out.
  factionId String
  taxerRole String
  amount    Int
  // Which stack `amount` (and paidAmount/appliedAmount) counts against —
  // Resources or physical Obols. A row is always single-currency: taxing
  // both off one target files two rows, same as everywhere else two things
  // move together (FACTIONS.md, resourceTransfer.js's own ⬢-only shape).
  // Defaulted for the rows filed before Obols were taxable.
  kind      PendingTaxKind @default(RESOURCES)

  // Set by the Refuse button (db/lib/tax.js#refuseTax). The pass's own claim
  // re-checks this, so a refusal landing between the read and the close still
  // wins.
  declinedAt DateTime?
  // Set by the Partial button (db/lib/tax.js#payPartialTax): what the target
  // chose to pay instead, 1..amount. Null means the full amount. A 0 is never
  // written here — it is a refusal and sets declinedAt instead.
  paidAmount Int?

  // The pass's claim (double-apply guard, stagedPush.js's shape) and what it
  // actually moved once clamped to the target's balance at close.
  appliedAt     DateTime?
  appliedAmount Int?
  // "declined" | "gone" | "broke" | null — why nothing moved, when nothing did.
  skippedReason String?

  createdAt DateTime @default(now())

  @@index([turnId, appliedAt])
  @@index([targetId, turnId])
  @@index([taxerId, turnId])
}

// LAYING IN WAIT (docs/systemdocs/INTERCEPT.md). A standing order: stop these
// people when they walk in where I am standing, and hand them this line.
//
// ONE watch per character, which is what the unique on characterId is for —
// the column IS the rule, the same way Character.escortedById is the whole of
// "you can only follow one person". Editing a watch is an upsert; there is no
// history to keep.
//
// It stores NO Location. The watch fires wherever the interceptor happens to
// be standing at the moment somebody arrives, read live — which is what "lay
// in wait at your location" literally means, and which leaves no stale row
// behind when they walk off.
enum InterceptMode {
  SAFE
  AMBUSH
}

model InterceptWatch {
  id          String    @id @default(cuid())
  characterId String    @unique
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  // WHERE they are lying in wait, stamped from where they stood when they set
  // it. The watch fires here and nowhere else, and any move at all deletes the
  // row (db/lib/locationMove.js). Anchored rather than read live: laying in
  // wait is a fact about a place, not a property you carry around with you.
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  mode    InterceptMode @default(SAFE)
  // What the interceptor says to whoever they stop. Player-typed, so it is
  // capped and stripped of broadcast pings before it is ever sent
  // (db/lib/intercept.js#cleanMessage).
  message String        @default("")

  // The names typed into the picker, stored RAW and matched at FIRE time
  // against what the arrival's face actually presents
  // (db/lib/presentedIdentity.js). Never resolved to ids when the watch is
  // saved: a dialog that answered "is there anybody called that?" would be a
  // roster oracle, which is the same reasoning Engrave and the Arrest Warrant
  // give for typing a name instead of picking one.
  targetNames String[] @default([])

  // The two dragnets. `anyPerson` subsumes `anyConcealed`.
  anyConcealed Boolean @default(false)
  anyPerson    Boolean @default(false)

  // Only catch somebody who crossed INTO this zone on the move that brought
  // them here. The gate guard's mute button: a watch at the town gate is for
  // strangers coming up the road, not for the townsfolk crossing their own
  // square all day. Read at FIRE time against each arrival's own previous
  // zone, so an escort party is judged one person at a time.
  outsideZoneOnly Boolean @default(false)

  // Ask to search whoever this watch catches (docs/systemdocs/SEARCH.md §6).
  // NOT a "who" and not a narrowing of one — it is what happens once you have
  // them, which is why it sits under the mode picker in the dialog rather than
  // in the dragnet row beside the two above. The search still asks consent
  // like any other; catching somebody is not being handed their pockets.
  autoSearch Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId])
}

// One row per person an interceptor has actually caught, per turn. This is the
// ration, not a log: without it a lapsed two-minute hold is walked straight
// back into, and a Safe watch on a busy road becomes an endless roadblock and
// an endless DM feed. The unique IS the enforcement — the insert is what
// claims the catch, inside the firing transaction, so two arrivals in one tick
// cannot both pass.
model InterceptHit {
  id String @id @default(cuid())

  // The CATCHER, not the watch row. A watch is churn — Stop and re-save, or
  // walk away and set another one when you come back (INTERCEPT.md §1) — and
  // keying the ration to the row would let anybody mint a fresh slate of
  // catches inside one turn by doing either. The catch belongs to the person
  // who made it.
  interceptorId String
  interceptor   Character @relation("InterceptCatcher", fields: [interceptorId], references: [id], onDelete: Cascade)

  targetCharacterId String
  targetCharacter   Character @relation("InterceptCaught", fields: [targetCharacterId], references: [id], onDelete: Cascade)

  // Not a foreign key, the Character.zoneMovesTurnId reasoning: it is a claim
  // token, and deleting a turn must never cascade into somebody's catch.
  turnId String

  createdAt DateTime @default(now())

  @@unique([interceptorId, targetCharacterId, turnId])
  @@index([targetCharacterId])
}

/// One row per search ASKED, and the @@unique IS the once-a-turn rule
/// (docs/systemdocs/SEARCH.md §3). The insert is the claim, the InterceptHit
/// discipline: a count-then-create over AuditLog rows is not race-proof, and
/// this ration has no cooldown behind it the way the kiss ration has. It is
/// spent by the ASK and a No does not refund it, so it has to outlive a
/// refusal — which a PENDING-duplicate query cannot do, since a refused offer
/// is not pending any more.
///
/// Keyed to the SEARCHER, never to the offer: an offer is churn (asked,
/// refused, asked again) and keying the ration to one would make refusing a
/// way to be asked all afternoon.
model SearchAttempt {
  id String @id @default(cuid())

  searcherId String
  searcher   Character @relation("SearchSearcher", fields: [searcherId], references: [id], onDelete: Cascade)

  targetCharacterId String
  targetCharacter   Character @relation("SearchTarget", fields: [targetCharacterId], references: [id], onDelete: Cascade)

  // Not a foreign key, the InterceptHit reasoning: it is a claim token, and
  // deleting a turn must never cascade into somebody's spent ration.
  turnId String

  // The offer this claim bought, for reading the row back in an audit. Nullable
  // and no FK — the offer may be gone long before this row is.
  offerId String?

  createdAt DateTime @default(now())

  @@unique([searcherId, targetCharacterId, turnId])
  @@index([targetCharacterId])
}

// A fight somebody started (docs/systemdocs/ATTACK.md). One row per attacker
// per target per turn, and the unique below IS the "attacking is permanent for
// the turn" rule — the same shape as InterceptHit above, and for the same
// reason: the insert is what claims the act, so nothing has to be counted.
//
// Attack does not RESOLVE a fight. Nothing in this codebase does — a fight is
// a Gambit and a GM's ruling (docs/systemdocs/COMBAT.md). What this row buys
// is that neither side can walk out of the scene before the GM reads it: both
// Character.heldUntil are stamped with the turn's own end, so the turn advance
// frees everybody for free and nothing sweeps.
model Attack {
  id String @id @default(cuid())

  attackerId String
  attacker   Character @relation("AttackMade", fields: [attackerId], references: [id], onDelete: Cascade)

  targetCharacterId String
  targetCharacter   Character @relation("AttackTaken", fields: [targetCharacterId], references: [id], onDelete: Cascade)

  // Not a foreign key, the InterceptHit.turnId reasoning: it is a claim token,
  // and deleting a turn must never cascade into somebody's fight.
  turnId String

  // An ambush that fired rather than a button somebody pressed. The strength
  // gate does not apply to one — you set a watch blind and do not get to pick
  // who walks into it.
  fromAmbush Boolean @default(false)

  // Where it happened, for the GM's Other lens. Nullable and SetNull: a fight
  // outliving its Location by a zone resync is a stale label, not a lost row.
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  // Cancelled, NEVER deleted. Breaking off is meant to be final for the turn,
  // and a deleted row would hand the unique back and let somebody attack the
  // same person all afternoon. It is also what the GM reads.
  cancelledAt DateTime?

  createdAt DateTime @default(now())

  @@unique([attackerId, targetCharacterId, turnId])
  @@index([targetCharacterId])
  @@index([turnId])
}

// A multi-turn craft in progress (docs/systemdocs/CRAFTING.md). A table, not
// an "in progress" pseudo-tag: it has a counter, a payer and a link to the
// Move that last advanced it, none of which fit CharacterTag — and a tag
// would show on 🔍 inspect and count toward carry.
enum CraftStatus {
  ACTIVE
  DONE
  CANCELLED
}

model CraftProject {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  tagId       String
  tag         Tag       @relation(fields: [tagId], references: [id])
  quantity    Int       @default(1)
  turnsNeeded Int
  turnsDone   Int       @default(0)

  // Charged when the project starts, never refunded on cancel. The payer is
  // a party key ("character:<id>" | "room:<id>") snapshot so Undo can send it
  // back.
  resourcesCost Int     @default(0)
  payerKey      String?
  payerName     String?

  // What the ingredients cost, snapshotted when the work STARTED — the same
  // rule resourcesCost lives under, because a multi-turn project spends both
  // up front. Shape is the `replaced` snapshot list
  // (`[{ tagId, tagName, quantity, source, expiresTurn }]`). Copied onto the
  // completing `request_craft_tag` audit row's `details.consumed` — the only
  // record of the spend, what a GM repairing by hand reads. Null on a recipe
  // with no spent ingredient, and on every project filed before this column
  // existed.
  consumed Json?

  // Pending custom-item fields (`{ name?, description? }`) for a customizable
  // recipe's multi-turn project — held here until the finishing turn, when
  // continueCraftImpl mints the runtime row and grants it. Null on an
  // ordinary project. The +1 ⬢ a unit was charged into resourcesCost when
  // the work started, like everything else.
  custom Json?

  status        CraftStatus @default(ACTIVE)
  startedTurnId String
  // The turn whose Routine last advanced it — one advance per turn.
  lastTurnId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([characterId, status])
}

/// A built thing standing at a Location, and — while UNDER_CONSTRUCTION —
/// the build site itself: a half-raised palisade is a visible, burnable
/// object in a yard, not a plan in somebody's pocket, so there is
/// deliberately no separate project table. LIVE STATE: no YAML sync writes
/// this table, the same rule LocationYield.current and LocationLink.isOpen
/// live under, and wipeGameData deletes it explicitly (nothing it cascades
/// from is deleted there).
///
/// The TYPE is a Tag carrying a `placement:` block, matched by SLUG rather
/// than an FK — the tag and zone syncs run independently, the same
/// reasoning LocationLink.requiredTagSlug and Room.accessTagSlugs record —
/// and typeName is a display snapshot so the row still reads after a
/// catalog rename (the AuditLog posture). db:prune-tags counts a standing
/// Structure as a blocker.
///
/// A structure has NO owner: it belongs to its Location, and control of the
/// ground is possession. builderCharacterId/builderName are credit, not
/// permission — snapshots with no FK, because the builder can die (the site
/// stands; characterDeath.js is deliberately not involved) and a wipe
/// deletes Characters.
model Structure {
  id String @id @default(cuid())

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  typeSlug String
  typeName String

  status StructureStatus @default(UNDER_CONSTRUCTION)

  // Crew-turns: any character standing here can advance the work by one, one
  // advance per character per turn (StructureWork's unique index). The
  // UNDER_CONSTRUCTION -> COMPLETE transition is claimed by a conditional
  // updateMany on (status, turnsDone), so two same-tick finishers cannot
  // both file the completion.
  turnsNeeded Int
  turnsDone   Int @default(0)

  // There is deliberately no hp pool. Condition is the status enum and the
  // words each surface prints from it — the plan cut numeric HP on purpose,
  // and turnsNeeded/turnsDone is already the effort axis if a later repair
  // verb wants one.

  // Charged to the payer when the site opens, never refunded — the
  // CraftProject rule, and the same party-key snapshot shape.
  resourcesCost Int     @default(0)
  payerKey      String?
  payerName     String?

  builderCharacterId String?
  builderName        String?

  // The builder's optional line, offered only where the type's
  // `placement.inscribable` says so (the wayside shrine). When set it
  // REPLACES placement.examine in the Examine readout. Sanitized on the way
  // in (web/lib/customCraft.js): no rich tokens, no @.
  inscription String?

  startedTurnId    String?
  // Claim column for a FUTURE decay/upkeep pass; nothing reads it yet. Here
  // so a later pass needs no migration to be resume-safe.
  lastUpkeepTurnId String?

  work StructureWork[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId, status])
  @@index([typeSlug])
}

// ABANDONED and RUINED are different events wearing different words: a site
// its opener called off before completion reads as abandoned groundwork,
// while RUINED is wreckage something made — demolition and sabotage (both
// milestone C) write RUINED, cancel writes ABANDONED. Neither blocks a new
// build of the same type, and both wait on C's GM Clear tool to be swept.
enum StructureStatus {
  UNDER_CONSTRUCTION
  COMPLETE
  DAMAGED
  RUINED
  ABANDONED
}

/// One character's one turn of work on one site. The unique index IS the
/// per-turn claim — same discipline as Action's @@unique([characterId,
/// turnId]) — and the rows double as the credit record and the notification
/// list (contributors are DM'd when the structure's status changes).
/// Character fields are snapshots with no FK: a dead builder's contribution
/// stays in the record.
model StructureWork {
  id String @id @default(cuid())

  structureId String
  structure   Structure @relation(fields: [structureId], references: [id], onDelete: Cascade)

  characterId   String
  characterName String
  turnId        String
  actionId      String?

  createdAt DateTime @default(now())

  @@unique([structureId, characterId, turnId])
  @@index([characterId])
}

model AuditLog {
  id                 String     @id @default(cuid())
  actorDiscordUserId String
  actionType         String
  targetCharacterId  String?
  targetCharacter    Character? @relation(fields: [targetCharacterId], references: [id])
  details            Json?

  // Only GM-facing actions carry one now: a GM transfer, a staging decision.
  // Player actions stopped asking for a reason when they stopped being
  // Requests, so this is blank for most rows.
  reason    String?
  // The turn this happened in. It exists because the per-turn rations
  // (MEDICAL_TIER_CAPS, DEAD_SIMPLE_PER_TURN, a tag's own requirementPerTurn)
  // used to count Request rows, and this table is what replaced them — a
  // ration has to be a cheap indexed count, not a scan.
  //
  // Only the actions a ration counts set it, so it is NULL on most rows and
  // is not a general "which turn was this" column. /gm/audit's turn filter
  // does not read it; that still derives the turn from createdAt.
  turnId    String?
  createdAt DateTime @default(now())

  // WHERE this happened, for /gm/audit's room/location filter. Forward-only —
  // added long after the table, so every row before this column shipped is
  // NULL and stays NULL; there is no backfill, because most call sites never
  // recorded a place at all. Real relations, not snapshot ids, because
  // Locations and Rooms are mastered by docs/zones.yaml/db:sync-zones rather
  // than created by play, so they are stable enough to reference — same
  // reasoning as Action.locationId above.
  //
  // SetNull, never Cascade: a zone re-sync that prunes a Room must not take
  // its audit history with it.
  //
  // These are filter-only. Renderers in web/lib/auditNarrative.js keep
  // reading a place NAME out of `details` (e.g. d.locationName) rather than
  // this column, because that is a frozen snapshot a pre-migration row still
  // has — do not "deduplicate" that onto these columns, or old rows lose
  // their sentence and the details::text free-text search stops matching.
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  roomId     String?
  room       Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([actionType])
  @@index([actorDiscordUserId])
  // The rationing lookups. Craft counts the crafter, which IS the row's
  // target; healing counts the MEDIC, who is the actor rather than the
  // target — the target there is the patient — so the two need different
  // indexes. Getting that axis wrong uncaps the thing being rationed.
  @@index([targetCharacterId, actionType, turnId])
  @@index([actorDiscordUserId, actionType, turnId])
  // /gm/audit's default view sorts the whole table by createdAt with no
  // filter, and runs a count() beside it. Neither index above can serve that.
  @@index([createdAt])
  @@index([targetCharacterId])
  // The room/location filters, each leading its own composite so a room
  // filter with no location picked (a GM pasting a room link) still hits an
  // index, and both still serve the createdAt sort/count beside them.
  @@index([locationId, createdAt])
  @@index([roomId, createdAt])
}

// --- The economy ledger -------------------------------------------------
//
// One row per economic event, double-entry: `amount` is always POSITIVE and
// the direction is from -> to. Every ⬢ that moves, is minted, or is burned
// gets a row, written inside the same transaction as the balance write it
// records (db/lib/economyLedger.js). /gm/economy reads nothing else.
//
// This is a RECORD, never a source of truth for a balance. Character.resources
// and Room.resources stay authoritative; the ledger's worth is that its sum
// per account can be compared against them, and a mismatch means something
// wrote money without saying so. See docs/systemdocs/ECONOMY.md.
//
// Party ends are SNAPSHOT columns, not foreign keys — the ARCHITECTURE.md log
// table rule. A character dies, a Room is pruned by a zone re-sync, and the
// book still has to read.
model EconomyEntry {
  id String @id @default(cuid())

  // Plain String, deliberately NOT a Game relation: the archive-or-discard
  // wipe decides what happens to a finished game's books, and a cascade would
  // make that decision for it.
  gameId String

  at         DateTime @default(now())
  // turnNumber is snapshotted beside turnId so a row survives its Turn row and
  // so the per-turn charts group without a join. Turn numbers restart at 1
  // every game, which is why gameId leads every index that uses this.
  turnId     String?
  turnNumber Int?

  // "character" | "room" | "depot" | "world" | "offworld" — db/lib/economyLedger.js.
  // Either end may be null only when the other end is a world account.
  fromKind String?
  fromId   String?
  fromName String?
  toKind   String?
  toId     String?
  toName   String?

  form   EconomyForm
  amount Int

  // What actually moved, when it was not bare ⬢. unitValue is the price the
  // valuation used, frozen here: a catalog re-price must not silently restate
  // history.
  tagId     String?
  tagSlug   String?
  quantity  Int?
  unitValue Int?

  // The taxonomy. A plain String rather than an enum for the same reason
  // AuditLog.actionType is one — the vocabulary grows, and a migration per new
  // reason is a tax nobody would pay. The list lives in db/lib/economyReasons.js
  // and that module is the only place it is authored.
  //
  // A write that reaches the ledger with no reason is recorded as
  // UNATTRIBUTED rather than dropped, so an un-hooked call site shows up on
  // /gm/economy as an ugly bar instead of quietly vanishing. NEVER quiet a
  // noisy entry by filtering its reason out on the read side — fix the reason.
  reason String

  // The narrative row this came from, for drill-through. Not unique: one audit
  // row can be several entries (an order with five line items).
  actionType         String?
  auditLogId         String?
  actorDiscordUserId String?

  // Where it happened. zoneName is the snapshot the GmZoneView filter actually
  // reads — web/lib/zones.js#inVisibleZones matches on NAMES, and a zone that
  // has since been pruned must still scope correctly.
  zoneId     String?
  zoneName   String?
  locationId String?
  roomId     String?

  // Withheld from a plain GM: a cult purchase, a rite's cost, a concealed
  // character's dealings. The AMOUNT still counts toward every aggregate —
  // hiding it would make the books lie — only the counterparty is redacted.
  secret Boolean @default(false)

  source      EconomySource @default(LIVE)
  // Set by the backfill only, as `<auditLogId>:<n>`, so re-running it is
  // idempotent. Null for every live write, which is why the unique is partial
  // in the migration SQL.
  backfillKey String?

  @@index([gameId, turnNumber])
  @@index([gameId, at])
  @@index([reason, at])
  @@index([fromKind, fromId, at])
  @@index([toKind, toId, at])
  @@index([zoneName, at])
  @@index([auditLogId])
  // The reader's own predicates, which the first set did not cover:
  // reconcile() filters on form, the ledger chips and Health's UNATTRIBUTED
  // group filter (gameId, reason), the zone-scoped ledger filters
  // (gameId, zoneId), and Health's plug list sorts by amount within a source.
  @@index([gameId, form])
  @@index([gameId, reason, at])
  @@index([gameId, zoneId])
  @@index([gameId, source, amount])
}

// Which coat the value was wearing. A closed set, so a real enum.
//
// One obol is one ⬢ (DEPOT.md) — there is a single unit of account here, and
// these are its forms, not separate currencies. BALANCE is abstract ⬢ on a
// sheet or in a stash; COIN is physical `obol` tags, which have weight and can
// be looted; ACCOUNT and DEBT are the Depot's two books; MANIFEST is an order
// paid for but still in flight; GOODS is any priced tag at its catalog value.
enum EconomyForm {
  BALANCE
  COIN
  ACCOUNT
  DEBT
  MANIFEST
  GOODS
}

// Where the row came from. LIVE is a hook firing at the moment money moved.
// BACKFILL is reconstructed from AuditLog by db:backfill-economy. PLUG is the
// difference the backfill could not account for, written once per account so
// the books close at the seam — its size is a diagnostic, not a number to
// trust.
enum EconomySource {
  LIVE
  BACKFILL
  PLUG
}

enum CavingRollKind {
  TROUBLE
  QUIET
  FIND
}

// What produced a roll. Only ARRIVAL can be written now — walking into a cave
// Location is the one trigger left (db/lib/cavingPass.js). TURN_START is the
// retired turn-start sweep, kept because historic rows still carry it, the
// same posture every other dead enum value in this schema gets.
enum CavingTrigger {
  TURN_START
  ARRIVAL
}

// One roll per LOCATION per turn, written when a character arrives somewhere in
// a CAVE_LEVEL zone — db/lib/cavingPass.js. Walking is the only thing that
// rolls it: push deeper and each new place pays, turn back and the way out
// pays too, stand still and nothing happens at all. The @@unique below is what
// stops a character pacing between two rooms to farm it, and what makes a
// retried write or a double-fire idempotent.
//
// Shaped like a Move on purpose — it is adjudicated the same way, on the
// same /gm/turns desk, with the same staging attachments. See
// docs/systemdocs/CAVING.md.
model CavingRoll {
  id          String    @id @default(cuid())
  turnId      String
  turn        Turn      @relation(fields: [turnId], references: [id])
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  // Which trigger produced this roll. Historic now: ARRIVAL is the only value
  // anything writes, and TURN_START belongs to the retired turn-start sweep.
  // Defaulted to ARRIVAL rather than TURN_START: a default nothing can produce
  // any more is a trap for the next writer. It used to be load-bearing in a
  // @@unique that capped one roll per Location per turn; that cap is gone and
  // every arrival rolls (CAVING.md 2b).
  trigger CavingTrigger @default(ARRIVAL)

  // The presence zone the character stood in when it rolled. Snapshot,
  // because they may have moved since.
  zoneId String
  zone   Zone   @relation(fields: [zoneId], references: [id])

  // The Location they walked into. Nullable only because the rows written
  // before the Die became arrival-only have none; every new row sets it. It
  // gates nothing -- it is what lets the Caving lens say where -- so walking
  // back into somewhere you already saw today rolls again.
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  die  Int // 1-6, flat — no Gambit modifier
  kind CavingRollKind

  // Set on a FIND only: the tier drawn (db/lib/cavingLoot.js) and the tag
  // granted, so the lens can show "Rare -> Spyglass" without a second lookup.
  lootTier  String?
  lootTagId String?
  lootTag   Tag?    @relation(fields: [lootTagId], references: [id])

  // Set when a GM takes the find back off the sheet. The roll itself stands —
  // only the loot comes off — and this is what stops a second click dropping
  // the tag twice. It replaced a link to a CAVING_LOOT Request, back when
  // there was a Request table to link to.
  lootUndoneAt DateTime?

  // Only a TROUBLE row is ever left unresolved — QUIET and FIND are stamped
  // at creation, which is what keeps the Caving lens showing the 1s instead
  // of every roll anyone made.
  resolvedAt              DateTime?
  resolvedByDiscordUserId String?
  gmNotes                 String?

  createdAt DateTime @default(now())

  stagedMessages StagedMessage[]
  stagedEffects  StagedEffect[]

  // No @@unique. There was one -- [characterId, turnId, trigger, locationId] --
  // and it was the whole anti-pacing rule: a repeat write's P2002 was swallowed
  // as "already rolled". Backtracking out of the Depths in silence read as a
  // bug, so every arrival rolls now. @@index([characterId]) replaces the index
  // that unique gave the cascade delete off Character.
  @@index([characterId])
  @@index([turnId, resolvedAt])
}

// One letter carried by a bird (docs/systemdocs/BIRD.md). Live state, not a
// log: the reply window is read off this row every time someone presses the
// Reply button in their DMs, and the failure pass sweeps it at turn close.
//
// Every party is stored as a SNAPSHOT — id, name and Discord id copied at send
// time, with no foreign key — for the reason ARCHITECTURE.md gives for the log
// tables. Two extra ones apply here. The reply handler needs the sender's
// Discord id and nothing else, so a snapshot lets it answer without a join at
// all; and a bird outlives its people, so a letter sent to someone who is
// deleted or wiped afterwards must still read back correctly on the GM desk.
model BirdMessage {
  id String @id @default(cuid())

  // Null when a GM sent the letter rather than a character — see
  // gmSenderDiscordUserId below. senderName is never null: a GM types the name
  // the letter arrives under, which is the whole point of the feature.
  senderId               String?
  senderName             String
  senderDiscordUserId    String?
  recipientId            String
  recipientName          String
  recipientDiscordUserId String?

  // Set instead of senderId when a GM wrote the letter from the Dev Panel. The
  // reply comes back to this Discord user as a DirectMessage rather than to a
  // character's hands — the God-King has no sheet to put a letter on.
  gmSenderDiscordUserId String?

  // Where the sender GUESSED the recipient was standing. The whole mechanic is
  // that this can be wrong, so it is recorded whether or not it matched. Null
  // on a GM letter: a GM already knows where everyone is, so there is no guess
  // to record and the letter simply arrives.
  guessedZoneId   String?
  guessedZoneName String?

  // The letter the bird actually carried, and the whole of what a Bird send is
  // now: you pick a paper you are HOLDING (docs/systemdocs/PAPERWORK.md). Null
  // only on rows written before the paperwork rework.
  //
  // Not a relation, and deliberately: the paper can be sealed, torn up, eaten
  // or wiped, and this row is the GM's record that a letter went. It holds the
  // id so the desk can still find the tag while it exists.
  tagId   String?
  tagName String?

  // A snapshot of the text at send time, so the desk can read what went even
  // after the paper is gone or resealed. Null when the letter went out sealed
  // — the bird did not open it either.
  body String?

  // False means the guess missed, or the recipient was dead. The sender is not
  // told until the next turn closes: an instant "no" would turn this into a
  // once-a-day scout for where somebody is standing, which is exactly what the
  // guess is supposed to cost.
  delivered Boolean @default(false)

  // Null on a miss. On a hit, the turn the letter landed in.
  arrivalTurnId String?

  // Turn.number of the LAST turn a reply is accepted in — the arrival turn
  // plus one. A letter sent five minutes before a turn closes would otherwise
  // be unanswerable in practice, which reads as a bug rather than as a rule.
  replyDeadlineTurn Int?

  // Stamped by db/lib/birdPass.js when the "wasn't delivered" DM is handed to
  // the side-effect thunk, so a resumed close cannot send it twice.
  failureNotifiedAt DateTime?

  // One reply, never a chain. Once repliedAt is set the button is spent.
  repliedAt DateTime?
  replyBody String?

  createdAt DateTime @default(now())

  // The failure pass's own query: undelivered and not yet notified.
  @@index([delivered, failureNotifiedAt])
  @@index([recipientId])
  @@index([senderId])
}

// A character's self-set goal, worth 1-5 Tag Points on fulfillment. At most
// one ACTIVE row per character (enforced in the server action, not the
// schema, since the constraint is "one ACTIVE" rather than "one row").
// endedTurnNumber drives the one-turn cooldown after a cancel or a fulfill.
// Master-sourced from docs/desires.yaml (db/lib/syncDesires.js,
// npm run db:sync-desires). `slug` is the stable match key. Reconciled with
// SOFT RETIRE rather than deletion — see the sync section.
model DesireTemplate {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  name                 String
  description          String?
  // 1|2|3|4|5|7. Doubles as the default Tag Point award AND the per-desire
  // cooldown in turns (cooldownTurns overrides it). Whitelisted in the sync,
  // not the schema — 6 is deliberately absent.
  tier                 Int
  families             String[] @default([])
  // Defaults true for tier 7 in the sync; an explicit YAML value wins.
  onceEver             Boolean  @default(false)
  // Per-entry override of the tier-derived cooldown (used by every consumable
  // = 3, make-a-merchant-purchase = 5). Null means "use tier".
  cooldownTurns        Int?
  // Real relations, not slug arrays, so db:prune-tags can see the reference
  // and refuse to delete a Tag a live desire depends on.
  requiresAnyTags      Tag[]    @relation("DesireRequiresAnyTag")
  requiresNotTags      Tag[]    @relation("DesireForbidsTag")
  // ALL of these, not any (docs/desires.yaml `requires.allTags`). A real
  // relation for the same reason as the two above. Always AND — never joined
  // by requiresAnyOf, since an "all" list combined with OR is meaningless.
  requiresAllTags      Tag[]    @relation("DesireRequiresAllTag")
  // Slug arrays, not FKs: db:sync-roles prunes Role rows and an FK would
  // block that (Document.roleSlugs precedent).
  requiresAnyRoleSlugs String[] @default([])
  requiresNotRoleSlugs String[] @default([])
  // When true, requiresAnyTags and requiresAnyRoleSlugs are satisfied by
  // EITHER one, not both (docs/desires.yaml `requires.combine: or`). Lets a
  // tag open a Desire that a role also opens, without the tag purchase being
  // dead weight to everyone outside that role. notTags/notRoles stay AND
  // regardless — a forbidden pairing is never something an OR should open.
  requiresAnyOf        Boolean  @default(false)
  // Absent from docs/desires.yaml: hidden from every picker, existing
  // instances keep running.
  retired              Boolean  @default(false)
  sortOrder            Int      @default(0)
  // Optional search string (docs/desires.yaml `verify:`), synced by
  // syncDesires.js. Prefills the GM review panel's audit-log filter so a GM
  // checking a claim doesn't have to guess what a claim of this kind would
  // look like in the log. Most desires have none — only worth writing where
  // the claim leaves a mechanical trace (a named tag/item eaten, drunk,
  // bought), never for a social or narrative goal a GM has to judge by eye
  // anyway.
  verifyQuery          String?

  desires Desire[]
}

model Desire {
  id              String       @id @default(cuid())
  characterId     String
  character       Character    @relation(fields: [characterId], references: [id])
  // STAYS non-null: a snapshot of template.name at claim time, so every
  // existing reader (tagEffects.js, the bot's 🔍/⚜️ embeds, the archive,
  // auditNarrative.js…) stays untouched by the catalog rework.
  text            String
  // The awarded number — a GM re-score writes it, so it can diverge from
  // template.tier. The COOLDOWN reads template.tier, never points.
  points          Int
  status          DesireStatus @default(FULFILLED)
  // A claim stamps BOTH with the open turn — the row is born ended. They stay
  // two columns because pre-rework rows carry a real gap between them.
  setTurnNumber   Int?
  // null means "does not lock its slot": a revoked or undone claim.
  endedTurnNumber Int?

  // Nullable ON PURPOSE AND FOREVER: grandfathers freeform rows and GM
  // off-catalog desires.
  templateId String?
  template   DesireTemplate? @relation(fields: [templateId], references: [id])
  // Which of GameConfig.desireSlots this occupies; grandfathered rows
  // backfilled to 0.
  slotIndex  Int             @default(0)

  // Free text the player types when claiming: how they pulled it off. Never
  // backfilled — every pre-rework row and every GM award (see below) has
  // none, and that's fine, the review queue just shows less for those.
  reason     String?
  // Stamped by BOTH the keep and the reject path of the GM review queue.
  // Null means this claim is still waiting to be looked at.
  reviewedAt DateTime?
  // The reviewing GM's Discord user id. A snapshot string, not an FK — same
  // reason AuditLog and its neighbours store actor ids that way rather than
  // pointing at a row that might not exist by the time anyone reads it.
  reviewedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([characterId, status])
  @@index([characterId, templateId, status]) // the per-desire cooldown query
}

// The game's transcript, and the backing store for /archive.
//
// Written at SEND time (db/lib/archive.js, called from the two proxy paths),
// not reconstructed at the wipe. The old messageWipe.js archived by reading messages
// back out of Discord and re-posting them into one #archive channel — ~850
// sequential posts down a single ~1 msg/sec lane on a busy turn, which was the
// most expensive thing the bot did and grew with player count. It also had to
// guess: the character was matched by *current* name (so a rename
// mis-attributed everything they'd ever said) and the turn was inferred by
// comparing timestamps against Turn.gameDate. Recording at write time makes
// both exact and reduces the wipe to deletes.
//
// The id columns are deliberately NOT foreign keys, same posture as
// AuditLog's snapshot fields. Two things in this codebase
// destructively delete the rows they'd point at: syncZonesFromYaml removes
// any Zone dropped from the YAML, and wipeGameData clears Characters. A
// real relation would either take the transcript with it or fail on FK
// ordering (which Restart Game has already been bitten by once). Plain indexed
// ids plus name snapshots survive both, and the snapshot is the more correct
// record anyway — who someone was known as *then*.
model ArchiveEntry {
  id   String      @id @default(cuid())
  kind ArchiveKind @default(MESSAGE)

  // Stamped from the open turn as the row is written.
  turnNumber Int?
  turnPhase  TurnPhase?
  sentAt     DateTime   @default(now())

  zoneId        String?
  zoneName      String?
  characterId   String?
  characterName String?

  // Non-null only for a message sent through /conceal. Both halves are kept:
  // the panel renders "Young Man (Sir Alder)", so the alias is what was seen
  // and characterName is who it actually was.
  concealedAlias String?

  // The FACE the room saw, frozen beside the name it heard. Only ever one of
  // the static files under web/public/: a concealing item's own
  // /assets/helms/<sprite>.webp, or a forced name's /assets/letters/<L>.webp.
  //
  // NULL means the character's own face, resolved live from /api/avatar/<id>.
  // Never store that own-face URL here: it carries a ?v=<updatedAt>
  // cache-buster, and freezing one would pin a portrait to whatever it was the
  // day they spoke. Written only when presentedIdentity gave an alias
  // (db/lib/say.js#recordSpeech).
  //
  // Frozen for the same reason concealedAlias is: a live lookup would unmask
  // every line said behind a mask the moment it came off.
  presentedAvatarPath String?

  // What the room could SEE of the speaker, frozen at send time — the third
  // frozen column, and the same argument as the two above it: a live lookup
  // re-dresses every old line the moment somebody changes clothes.
  //
  // db/lib/examineSnapshot.js owns the payload and the rule behind it; this
  // comment does not restate either, because a shape the schema cannot enforce
  // is a shape that drifts once it is written down twice.
  //
  // Two things that only belong here. NULL means "not frozen" — a row written
  // before this column, a scene line, an intercom broadcast — and the reader
  // falls back to the live character. It is NEVER backfilled: there is no
  // record of what anybody wore then, and stamping today's state onto
  // yesterday's line is precisely the bug this closes.
  //
  // And NEVER put it in a wire select. It holds the character's WHOLE tag
  // list, hidden rows included; FEED_ROW_SELECT and ARCHIVE_ROW_SELECT
  // (db/lib/archive.js) must not learn about it.
  presentedState Json?

  content String

  // How ✏️ and ❌ find this row again to update or remove it. Null for system
  // events, which have no Discord message behind them.
  discordMessageId String? @unique

  // The player's ORIGINAL Discord message, the one the proxy deletes — not the
  // webhook repost `discordMessageId` holds. It is the idempotency key for the
  // Discord -> row direction: bot/src/lib/proxy.js writes this row BEFORE
  // posting, so a second delivery of the same messageCreate loses the race on
  // this unique index and bails without posting again.
  //
  // That distinction is the whole point. `discordMessageId` is minted fresh by
  // each webhook post, so two runs of one player message never collide on it —
  // which is exactly how one typed line got posted twice. Null on every web and
  // system row, and Postgres lets a unique index hold as many NULLs as it likes.
  sourceDiscordMessageId String? @unique

  // summary | public | private | watch | intercom — lets the panel keep a
  // zone's summary channel apart from its forum scenes. ("plain" in rows
  // written before the zone rework.)
  channelKind String?

  // Forum post / thread title, so a scene reads as one unit rather than
  // scattered lines under its location.
  threadName String?

  // The Discord channel the message was posted in — the THREAD's own id when
  // it was said inside a thread, because that is what a jump link's channel
  // slot needs. A plain snapshot, not an FK (same posture as every id column
  // here): Locations are destructively resynced and a rework is coming.
  discordChannelId String?

  // Which game this row belongs to (Game.id). A snapshot column, not an FK,
  // like every other id here: the transcript outlives the wipe on purpose
  // (docs/systemdocs/ARCHIVE.md), stamped by db/lib/archive.js from the
  // current GameState.
  gameId String

  // The live-feed cursor. Monotonic and assigned by Postgres, so the bot and
  // the web app never have to agree on a clock — `id` is a cuid and `sentAt`
  // is whatever the writing process thought the time was. A client asks for
  // rows above the last seq it holds and can miss nothing.
  //
  // BigInt in Prisma, which means it comes back as a JS BigInt: serialise it
  // as a STRING wherever it crosses into JSON, and compare a cursor with
  // BigInt(), never Number().
  seq BigInt @unique @default(autoincrement())

  // Where the row was said, as a snapshot string rather than an FK, matching
  // every other id column here: `loc:<id>`, `room:<id>`, `conv:<id>`,
  // `zone:<id>`. db/lib/placeKey.js is the only thing that mints one.
  placeKey String?

  source ArchiveSource @default(DISCORD)

  editedAt DateTime?

  // Soft delete. A row a client already holds has to be reconcilable, so
  // /play and /archive filter on this rather than the row going away.
  deletedAt DateTime?

  // The outbox watermark: when this row was last pushed to Discord. Null on a
  // WEB row means the bot has not posted it yet.
  discordSyncedAt DateTime?

  createdAt DateTime @default(now())

  // NOTE: ArchiveEntry also carries a trigram GIN index on `content`
  // (ArchiveEntry_content_trgm_idx), created by raw SQL in the
  // 20260825020000_launch_hardening_indexes migration. Prisma's schema
  // language cannot express an operator-class index, so it is invisible here
  // and `prisma migrate diff` will not know about it — do not "clean it up"
  // if a future diff reports it as drift.
  //
  // [sentAt, id] not [sentAt]: /archive orders by both, the id being the
  // tiebreaker that keeps pagination stable across equal millisecond
  // timestamps. On sentAt alone Postgres still has to sort for the tiebreak.
  @@index([sentAt, id])
  @@index([gameId, sentAt, id])
  @@index([turnNumber])
  @@index([kind])
  @@index([zoneId, sentAt])
  @@index([characterId, sentAt])
  @@index([discordChannelId, sentAt])
  @@index([placeKey, seq])
}

/// One page of the Oracle's chronicle: what happened in one zone during one
/// turn, or — when zoneId is NULL — the editor's front page over all of them.
/// See docs/systemdocs/ORACLE.md.
///
/// Deliberately NOT an ArchiveKind. ArchiveEntry is the players' transcript and
/// ships inside an archive packet; this is a GM work product, drafted by a
/// model and rewritten by hand, and it has no business in a game's permanent
/// record of what players said.
model OracleSynopsis {
  id String @id @default(cuid())

  turnId String
  turn   Turn   @relation(fields: [turnId], references: [id], onDelete: Cascade)

  // NULL is the front page OR the Threats page — `kind` is what tells those
  // two apart now. Every other row (kind ZONE) is one real zone's page.
  zoneId String?
  zone   Zone?   @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  // ZONE (default) has a real zoneId. FRONT and THREATS both have zoneId NULL
  // and used to be the same thing for exactly that reason, until the Threats
  // correspondent needed a second null-zoneId slot — see ORACLE.md. THREATS is
  // a zone-shaped page with no Zone row behind it: same PRESENT/MOVES/EVENTS
  // shape, scoped to antagonist seat-holders instead of a place, and it shows
  // up as one more "## Threats" section in the front page's zone list.
  kind OracleSynopsisKind @default(ZONE)

  // Markdown, carrying {char:Full Name} tokens that
  // web/app/components/DocumentMarkdown.js resolves against the turn's roster.
  body String

  // Front-page rows only: [{ name, state }], two to five of them. The
  // STRUCTURED half of the rolling memory — an ongoing situation carried
  // forward by name rather than left for the model to re-notice in three turns
  // of prose.
  threads Json?

  // A GM rewrote it. The edited body is what feeds the next turns' context,
  // which is the whole correction mechanism: there is no regenerate.
  editedByDiscordUserId String?
  editedAt              DateTime?

  // What produced this text, snapshot rather than a pointer to live config —
  // the same reasoning as the log tables (ARCHITECTURE.md). A prompt or model
  // swap must not rewrite the provenance of pages already written.
  provider     String
  model        String
  inputTokens  Int?
  outputTokens Int?

  createdAt DateTime @default(now())

  // NOT a substitute for uniqueness. Postgres treats NULLs as distinct in a
  // unique index, so @@unique([turnId, zoneId]) would happily allow any number
  // of FRONT or THREATS rows for one turn (both have zoneId NULL). The real
  // guards are two PARTIAL unique indexes added in raw migration SQL —
  // `WHERE "zoneId" IS NULL AND "kind" = 'FRONT'` and `WHERE "kind" =
  // 'THREATS'` — the same shape as FactionApplication_pending_unique and
  // ThreatSpawn_pending_unique, and they come with the same warning: `prisma
  // migrate diff` cannot express either, will propose dropping both, and the
  // drop must be declined (CLAUDE.md). This @@unique still does real work: it
  // is what keeps two ZONE rows from ever landing for the same zone.
  @@unique([turnId, zoneId])
  @@index([turnId])
}

enum OracleSynopsisKind {
  ZONE
  FRONT
  THREATS
}

// A GM's own notes about a player, on the player desk's dossier.
//
// NOT to be confused with Note above, which is a PLAYER's personal list of
// messages they starred with a reaction in a location channel. That one is
// keyed to the reacting user and is theirs; this one is GM-only and is about
// somebody else.
//
// Append-only short notes with attribution rather than one shared editable
// field, because five GMs editing a single textarea race each other and the
// loser's paragraph vanishes with no trace of who ate it. A GM may delete
// their own.
//
// A real relation with a cascade, unlike the log tables (DirectMessage,
// AuditLog) that store snapshot columns on purpose: a note is live data ABOUT
// a character rather than a record of something that happened, and it has no
// meaning once the character is gone.
// A threat seat offered to somebody who has no character yet: the GM presses
// SPAWN on /gm/dev?s=assignments, this row is written, and the target gets a
// DM carrying Accept / Decline. Accepting creates the character
// (db/lib/threatSpawn.js). See docs/systemdocs/THREATS.md.
//
// The offer is a row rather than state on a DM because the DM is Discord's and
// can be deleted: the row is what says an offer is live, what seat and role it
// was for, and -- once answered -- what became of it.
model ThreatSpawn {
  id String @id @default(cuid())

  // The target. Not a Character relation on purpose: the whole point is that
  // they have no character yet, and after accepting they own the one below.
  discordUserId String

  // A slug in db/lib/threats.js, not a table -- the catalog is code, same
  // posture as antagonistOptIns above.
  threatSlug String

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  // Null only for a role with no starting location; every offer the UI writes
  // names one.
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  status ThreatSpawnStatus @default(PENDING)

  // The GM who offered. A Discord user id rather than a relation, same as
  // AuditLog.actorDiscordUserId -- there is no user table.
  offeredBy String

  // Set on accept. Unique, so one offer can never mint two characters.
  characterId String? @unique

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  // One live offer per player is enforced by a PARTIAL unique index
  // (WHERE status = 'PENDING') that lives only in the migration SQL, because
  // Prisma's schema language cannot express one. `prisma migrate diff` will
  // propose dropping it -- decline, same as FactionApplication_pending_unique.
  @@index([discordUserId, status])
  @@index([status])
}

enum ThreatSpawnStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

// An antagonist party's win condition (docs/systemdocs/THREATS.md §6a). Set
// by a superadmin on /gm/dev?s=antagonists, scored by db/lib/objectives.js,
// printed in the end-of-game reveal. Restart Game deletes the table; the
// reveal is snapshotted onto Game.epilogue first.
model Objective {
  id String @id @default(cuid())

  // A party key from db/lib/threats.js — "thanati", "tribunal", or a solo
  // seat's own slug. Code, not a table, same posture as ThreatSpawn.threatSlug.
  partyKey String

  // A key in db/lib/objectiveKinds.js.
  kind String

  weight ObjectiveWeight?

  // Snapshot ids and names, not relations — the ArchiveEntry.characterId
  // posture. The name is what the reveal reads; a relation would have meant
  // editing Character and Location for nothing, since this table is wiped
  // outright.
  targetCharacterId  String?
  targetName         String?
  targetLocationId   String?
  targetLocationName String?

  // The number for "cause N deaths in a single day"; the text for a defaced
  // icon, a stolen item or a custom objective.
  value Int?
  text  String?

  // The GM's answer. A scripted kind: null lets the game decide. A manual
  // kind: never null, the pin is its only answer.
  pinned Boolean?

  // The superadmin who added it. A Discord user id, as AuditLog.actorDiscordUserId.
  createdBy String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ObjectiveWeight {
  MINOR
  MAJOR
}

/// A rite in progress: one per (rite, room) while cultists are chanting
/// (docs/systemdocs/THANATI.md). Opened by the first counted chant
/// (db/lib/riteChant.js), advanced to READY the moment the last requirement
/// lands, fired by the bot's minute sweep (db/lib/riteSweep.js) once the
/// grace window has run, expired when twelve hours pass without it. Rooms
/// and characters are snapshot ids, not FKs — the table is wiped outright by
/// Restart Game, and a room recreated by the zone sync must not cascade it.
model RiteAttempt {
  id String @id @default(cuid())

  // A key in db/lib/rites.js.
  riteKey String

  roomId   String
  roomName String

  status RiteAttemptStatus @default(OPEN)

  openedAt DateTime  @default(now())
  readyAt  DateTime?
  firesAt  DateTime?
  firedAt  DateTime?

  // Who was counted when it fired: [{ characterId, name }].
  participants Json?
  // What the effect did, for the GM panel and the audit trail.
  result       Json?

  chants RiteChant[]

  @@index([status])
  @@index([riteKey, roomId, status])
}

enum RiteAttemptStatus {
  OPEN
  READY
  // Fired, but waiting on a word from a participant — the Rite of Panic asks
  // the room to name a zone (db/lib/riteEffects.js).
  AWAITING
  FIRED
  EXPIRED
  CANCELLED
}

/// One counted chant: a robed, Inspired speaker said the Word of the Circle
/// in the attempt's room (or a Conversation linked to it). Several rows per
/// chanter are normal; the sweep counts distinct characterIds.
model RiteChant {
  id String @id @default(cuid())

  attemptId String
  attempt   RiteAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  characterId   String
  characterName String
  // The ArchiveEntry.seq of the message, so a GM can find the line.
  archiveSeq    BigInt?
  saidAt        DateTime @default(now())

  @@index([attemptId])
}

// One browser that has agreed to be notified. Web Push is per-BROWSER, not
// per-character: the endpoint is minted by the push service for that install,
// and one player may hold several (a laptop and a phone). Keyed on the Discord
// user id for the same reason every other row here is -- there is no user
// table.
//
// A dead endpoint is deleted the first time the push service answers 404 or
// 410 (db/lib/webPush.js), so this table cleans itself.
model PushSubscription {
  id            String    @id @default(cuid())
  discordUserId String
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime?

  @@index([discordUserId])
}

// A Quest: a piece of content a GM stages at runtime, without a YAML edit and
// without a deploy. It mints one Room -- a Discord thread and a place on the
// web -- at any Location, usually a cave, carrying exactly one button.
// Pressing Interact files the presser's Move for the turn as a Gambit with
// whatever they declare, so a quest adds no new economy: it spends the one
// thing a character already has to spend. See docs/systemdocs/QUESTS.md.
//
// The gates are copied here rather than only living on the Room, because
// closing a quest DELETES its Room and the record has to outlive the door.
model Quest {
  id String @id @default(cuid())

  title       String
  // GM-editable prose. Edited in place on the room's starter message, never
  // reposted -- a repost pings every thread follower, the same reason
  // db:sync-info-channel edits by default.
  description String @default("")

  status QuestStatus @default(OPEN)

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  // The Room this quest minted, while it has one. Null once it is closed:
  // the thread and the Room row go, the Quest row stays for the record.
  room Room? @relation("QuestRoom")

  // Absolute turn number, resolved through db/lib/turnFormat.js#expiryFrom the
  // way NoticePost.expiresTurn is. Null means it stands until a GM closes it.
  expiresTurn Int?
  createdTurn Int?

  // A snapshot, not an FK, the way every other log column here is.
  createdById String?

  // Either gate non-empty makes the room PRIVATE. Empty both ways is a quest
  // anybody standing there can see.
  accessTagSlugs      String[] @default([])
  allowedCharacterIds String[] @default([])

  interactions QuestInteraction[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  @@index([status])
  @@index([locationId])
}

enum QuestStatus {
  OPEN
  CLOSED
  EXPIRED
}

/// One press of a quest's Interact button. The Move it filed is the Action row
/// -- this is the join, so the GM desk can show what somebody said they were
/// trying to do next to the quest they said it about.
model QuestInteraction {
  id String @id @default(cuid())

  questId String
  quest   Quest  @relation(fields: [questId], references: [id], onDelete: Cascade)

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  // The Gambit this filed. Unique because one press is one Move.
  actionId String @unique

  turnId    String
  intention String

  createdAt DateTime @default(now())

  // One press per character per quest per turn. The one-Move-a-turn rule in
  // db/lib/moves.js already makes a second press impossible; this is the
  // database saying so too.
  @@unique([questId, characterId, turnId])
  @@index([questId])
}

/// One pending piece of Discord reconciliation. The zone editor, a quest, a
/// GM's edit — anything that changes a row Discord mirrors — writes a job here
/// and returns; the mirror catches up in the background
/// (db/lib/discordMirror/queue.js). The web `after()` drain is the primary
/// trigger, the bot's ready pass and the turn wrapup the backstop.
///
/// No foreign key on purpose: `targetType` names a kind ("location", "room",
/// "zone", "special", "deadchat") and `targetId` a row that may be deleted
/// before the job is drained. A job for a row that has gone simply matches
/// nothing and is dropped.
model MirrorJob {
  id String @id @default(cuid())

  targetType String
  targetId   String

  /// Why it was enqueued, for the Dev Panel. Not read by the mirror.
  reason String

  enqueuedAt DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  /// Bumped on every drain that did not finish the job. At 5 the mirror gives
  /// up and leaves the row with its `error`, so a job stuck behind an open
  /// circuit breaker is visible instead of retried forever.
  attempts Int     @default(0)
  error    String?

  /// Repeat saves of the same place coalesce into one job.
  @@unique([targetType, targetId])
  @@index([finishedAt])
}

/// The Discord handle behind an account, cached so a GM can search "peace.lock"
/// instead of a snowflake. Discord offers no name-to-id lookup, and nothing else
/// stores one: Character keys on discordUserId and renders the name live, which
/// works on a page holding the member already and nowhere else.
///
/// A CACHE, not an identity table — auth still resolves through
/// Character.discordUserId and no gate reads this. One row is one ACCOUNT, not
/// one character, so a player with three characters has a single handle that
/// cannot disagree with itself.
///
/// Every writer upserts (db/lib/discordAccounts.js): the bot's member sweep at
/// ready, a web sign-in, and the mirror. Handles are mutable, so a row is
/// reconciled rather than created once. A member leaving the guild is NOT a
/// delete — the handle behind their archive lines outlives their membership.
model DiscordAccount {
  /// The snowflake. Deliberately the primary key rather than a cuid: there is
  /// exactly one row per account and every caller already holds this id.
  discordUserId String @id

  /// Discord's unique handle, e.g. "peace.lock". Stored in Discord's own casing;
  /// lookups go through normalizeHandle() and match case-insensitively.
  username String

  /// The display name, which most accounts set and some do not.
  globalName String?

  updatedAt DateTime @updatedAt

  /// What a GM actually searches by.
  @@index([username])
}
