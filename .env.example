DATABASE_URL="postgresql://user:password@localhost:5432/bascinet"

# Local development only — never set this in production. Every Discord REST
# call (db/lib/discordRest.js#discordRequest) is answered locally instead of
# reaching Discord: a role/member lookup comes back holding every role
# db/lib/localMode.js grants (so isGm and friends pass with no real guild),
# and anything that would have posted, edited or deleted content is logged to
# local-discord-outbox.jsonl instead. DISCORD_TOKEN and DISCORD_GUILD_ID still
# need to be set to SOME non-empty value below — several checks return early
# on an empty one before ever reaching discordRequest — but with this on,
# their actual values are never read.
LOCAL_MODE="false"

# Shared: the bot token, also used by the web app's server-side REST calls
# to read guild member roles (see web/lib/discordGuild.js).
DISCORD_TOKEN=""

# The single Discord server this game instance runs in.
DISCORD_GUILD_ID=""

# The Discord role ID that grants access to the /gm dashboard.
DISCORD_GM_ROLE_ID=""

# Leave unset on a fresh deploy. The Discord mirror's automatic runs (bot
# start, turn end) then only REPORT missing categories, channels and threads;
# they still repair roles and overwrites as the doctor always did. Look at
# Preview mirror on /gm/dev once, press Reconcile now, then set this to 1 so
# the automatic runs rebuild structure too. See docs/systemdocs/MIRROR.md.
MIRROR_AUTO_STRUCTURE=""

# The Discord role ID pinged by turn-advance announcements. Player membership
# is synced automatically from the "Turn Ping?" checkbox on /character.
DISCORD_TURN_PING_ROLE_ID=""

# Discord OAuth app credentials for web login (Discord Developer Portal ->
# OAuth2). Redirect URI: <your-web-url>/api/auth/callback/discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Auth.js session secret. Generate with: npx auth secret
AUTH_SECRET=""

# Leave unset. web/lib/auth.js derives the origin from x-forwarded-host
# against an allowlist, so sign-in works on every host the app is served
# from. Setting AUTH_URL overrides that and pins every redirect to one
# host — it exists only as an emergency rollback.

# Public URL of the deployed web service. The bot uses this to build avatar
# URLs (<WEB_BASE_URL>/api/avatar/<characterId>) when proxying messages.
WEB_BASE_URL=""

# Web Push (docs/systemdocs/HALL.md §5a). Without all three, the Notify me
# toggle never draws and every push is a no-op — the chime and the DM still
# work. Generate a pair with: npx web-push generate-vapid-keys
# VAPID_SUBJECT is a contact URL the push services can reach you at, e.g.
# "mailto:you@example.com". Set on BOTH the web and the bot services.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

# Backups (docs/systemdocs/BACKUPS.md). The nightly dump service writes to a
# Railway bucket; these are that bucket's S3-compatible credentials, readable
# with `railway bucket credentials --bucket bascinet-backups`.
S3_ENDPOINT="https://t3.storageapi.dev"
S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DEFAULT_REGION="auto"

# An *account* token (railway.com/account/tokens), not the project token above.
# Only needed to read the backup API; the project token cannot.
RAILWAY_API_TOKEN=""
